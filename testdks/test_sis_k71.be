 NPR	:   , BSS , 1
 NR	:   , BSS , 1
 PR	:   , BSS , 1
 ВАД	:   , BSS , 1
 НАД	:   , BSS , 1
 ВРЕ	:   , BSS , 1
 ТР1	:   , BSS , 1
 ТP4	:   , BSS , 1
 Е15	:   , LOG , 77 777
 Е22Р	:   , LOG , 10 000 000
 Е23Р	:   , LOG , 20 000 000
 Е14	:   , LOG , 37 777
 Е24Р	:   , LOG , 40 000 000

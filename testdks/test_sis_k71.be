 ТВЫБ   :   , ISO ,24HТЕСТ ВЫВЕДЕН ИЗ РЕШЕНИЯ;
	    , CONT,24H КОЛИЧ. ПРОХОДОВ ТЕСТА:
	    , CONT,6HЧИСЛО
	    , CONT,18H ;ОШИБОК ДАННЫХ:
	    , CONT,6HЧИСЛО
 TERR   :   , ISO ,24HОШИБКА ДАННЫХ; ЭТАЛОН
	    , CONT,6H; КОД:
	    , CONT,6HЧИСЛО
	    , CONT,12H ; АДРЕС:
	    , CONT,12H ; ТЕСТ N
	    , CONT,6HЧИСЛО
	    , CONT,6HПОВТ:
	    , CONT,6HЧИСЛО
	    , END ,



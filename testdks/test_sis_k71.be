 ТЕСТООП :  , NAME,
 PROGRAM :  ,ENTRY,
 .
 . ПРОГРАММА ВКЛЮЧАЕТ В СЕБЯ 
 . НАЛАДОЧНЫЙ И КОМПЛЕКСНЫЙ ТЕСТЫ
 .
 . НАЛАДОЧНЫЙ ТЕСТ СЛУЖИТ ДЛЯ 
 . ПРОСТОЙ ПРОВЕРКИ РАБОТЫ КАНАЛА
 . КАДОПАМ-КРК-ДКС(ЭЛЕКТРОНИКА-60 N1)
 . 
 . КОМПЛЕКСТЫЙ ТЕСТ ВКЛЮЧАЕТ 7 ПОДТЕСТОВ
 . 1 - ЗАП.-ЧТ. ПО ОДНОМУ АДРЕСУ
 . 2 - ПЕРЕБОР АДРЕСОВ
 . 3 - ЗАП.-ЧТ. ЧЕРЕДОВАНИЯ ЕДИНИЦЫ-НУЛИ
 . 4 - ЗАП.-ЧТ. ЧЕРЕДОВАНИЯ НУЛИ-ЕДИНИЦЫ
 . 5 - ЗАП.-ЧТ. "БЕГУЩЕЙ" ЕДИНИЦЫ
 . 6 - ЗАП.-ЧТ. "БЕГУЩЕГО" НУЛЯ
 . 7 - ЗАП.-ЧТ. РАЗЛИЧНЫХ КОНФИГУРАЦИЙ
 . ПОДТЕСТЫ ВЫПОЛНЯЮТСЯ ОДИН ЗА ДРУГИМ.
 . ПОДТЕСТ 7 ПЕРЕДАЕТ УПРАВЛЕНИЕ НА ПОДТЕСТ 1.
 . ГРАНИЦА ПРОВЕРЯЕМЫХ АДРЕСОВ ПО УМОЛЧАНИЮ 10-67777(8).
 . ИМЕЕТСЯ ВОЗМОЖНОСТЬ РУЧНОЙ УСТАНОВКИ ГРАНИЦ С ТУМБ. РЕГ.
 .
 . УПРАВЛЕНИЕ ТЕСТОМ:
 . ДЛЯ ОБОИХ ТЕСТОВ:
 . 
 . 1Т.Р. 25-27РР N НАПР КРК
 .          24Р=1 ВЫБРОС ТЕСТА ИЗ РЕШ.
 . 4Т.Р. 25Р=1 ПЕРЕХОД НА НАЛАД. ТЕСТ.
 .       25Р=0 КОМПЛЕКСНЫЙ ТЕСТ.
 .
 . ДЛЯ НАЛАД. ТЕСТА
 .
 . 1Т.Р. 1-15РР - ЗАДАННЫЙ АДРЕС
 . 4Т.Р. 1-16 - ЗАДАННЫЙ КОД
 .         22Р - ЧТЕНИЕ ПО ЗАДАННОМУ АДРЕСУ
 .         23Р - ЗАП. ПО ЗАД. АДРЕСУ ЗАД. КОДА
 .         22Р=23Р=0 - ЗАПИСЬ ПО ЗАД. АДР. ЗАД. КОДА
 .         ЗАТЕМ ЧТЕНИЕ ТАМ ЖЕ.
 .
 . ДЛЯ КОМПЛ. ТЕСТА:
 .
 . 1Т.Р. 1-15РР - НАЧ. АДРЕС ПРИ РУЧНОМ ВЫБ. ГРАНИЦ
 . 4Т.Р. 1-15РР - КОН. АДРЕС ПРИ РУЧНОМ ВЫБ. ГРАНИЦ
 .         21Р=1 - РУЧНОЙ ВЫБОР ГРАНИЦ
 .         21Р=0 - АВТОМ. ВЫБОР ГРАНИЦ
 .         22Р=1 - ОСТАНОВ ПРИ ОШИБКЕ
 .         23Р=1 - ПЕРЧАТЬ СООБЩЕНИЯ ОБ ОШИБКАХ
 УС	 :  , EQU  ,133В
 	   7, BASE,*
	    , ITA ,  ,СМ := ИР
	    , XTA ,  ,загрузка: СМ := 
	    , ATI ,6  ,ИР := СМ
	    , ATI ,5  ,ИР := СМ
	    , ATX ,NPR  ,запись: NPR := СМ
	    , NTR ,3  ,РЖ := 3
 СТАРТ2	:   , *65 ,1  ,Э65=тумбл.рег.1
	    , ATX ,ТР1  ,запись: ТР1 := СМ
	    , ASN ,64+24  ,сдвиг СМ вправо на 24
	    , AAX ,=7  ,СМ &= =7
	    , AOX ,=7701 0000 4000 0000  ,СМ |= =7701 0000 4000 0000
	    , *50 ,УС  ,Э50 направление КРК
 СТАРТ0	:  1, VTM ,  ,ИР := 
* СТАРТ - точка входа теста:
*   1. Чтение тумбл. регистров 1ТР и 4ТР (*65)
*   2. Направление КРК из б.25-27 ТР1 -> Э50 133
*   3. Проверка режима (нал./компл.)
*   4. Комплексный: ФАД -> цикл Т1..Т7 -> СЧЕТ
*   5. Наладочный: ФАДР -> ТН (одиночная ЗП/ЧТ)
*
 СТАРТ  :   , BSS ,
 	    , *65 ,1  ,Э65=тумбл.рег.1
	    , AEX ,ТР1  ,СМ ^= ТР1
	    , U1A ,СТАРТ2  ,если СМ!=0 -> 
	    , *65 ,4  ,Э65=тумбл.рег.4
	    , ATX ,ТР4  ,запись: ТР4 := СМ
	    , XTA ,ТР1  ,загрузка: СМ := ТР1
	    , AAX ,Е24Р  ,СМ &= Е24Р
	    , U1A ,ВЫБРОС  ,если СМ!=0 -> 
	    , XTA ,ТР4  ,загрузка: СМ := ТР4
	    , AAX ,Е24Р  ,СМ &= Е24Р .ТЕСТ ВКЛЮЧЕН
	    , UZA ,ПАУЗА  ,если СМ=0 -> ПАУЗА
	    , XTA ,ТР4  ,загрузка: СМ := ТР4
	    , AAX ,Е25Р  ,СМ &= Е25Р .НАЛАД. ТЕСТ:
	    , U1A ,ТН  ,если СМ!=0 -> 
	  13, VJM ,ФАД  ,подпрограмма ФАД .ФОРМ.ДИАП.АДР.
	   1, UTM ,1  ,ИР += 1   .УВЕЛИЧ. СЧЕТЧ. N ТЕСТ
	   1, UJ  ,ПЕРЕКЛ-1  ,переход на ПЕРЕКЛ-1
* ПЕРЕКЛ - таблица переходов на 7 подтестов:
*   М1=номер теста(1-7); переход по М1/TBL
*   После Т7 -> СЧЕТ -> новый цикл
*
 ПЕРЕКЛ :   , BSS ,
	:   , UJ  ,Т1  ,переход на Т1 .ЗП-ЧТ ПО АДР. НИЖ. ГР.
	:   , UJ  ,Т2  ,переход на Т2 .ЗП-ЧТ АДР. В АДР.
	:   , UJ  ,Т3  ,переход на Т3 .ЗП-ЧТ ВСЕ 1
	:   , UJ  ,Т4  ,переход на Т4 .ЗП-ЧТ ВСЕ 0
	:   , UJ  ,Т5  ,переход на Т5 .БЕГУЩАЯ 1
	:   , UJ  ,Т6  ,переход на Т6 .БЕГУЩАЯ 0
	:   , UJ  ,Т7  ,переход на Т7 .ЦИКЛ СЛ. КОН.=113
	:   , UJ  ,СЧЕТ  ,переход на СЧЕТ .УВЕЛИЧ. СЧЕТ ПРОХОД.
* TH - наладочный тест (ручной режим):
*   Формирует адрес из ТР1, код из ТР4
*   б.22=1 -> чтение; б.23=1 -> запись; 0/0 -> запись-чтение
*
 TH :	    , BSS ,
 	  13, VJM ,ФАДР  ,подпрограмма ФАДР
	    , XTA ,ТР4  ,загрузка: СМ := ТР4
	    , AAX ,Е22Р  ,СМ &= Е22Р
	    , U1A ,ЦЧТ  ,если СМ!=0 -> 
	    , XTA ,ТР4  ,загрузка: СМ := ТР4
	    , AAX ,Е23Р.  ,СМ &= Е23Р.
	    , U1A ,ЦЗП  ,если СМ!=0 -> 
* ЦЗЧ - запись-чтение в цикле (200 итер.)
*   Z13=запись Z03=ч��ение КАДОПАМ
*
 ЦЗЧ	:   , BSS ,
 	   3, VTM ,1-200  ,ИР := 1-200
 ЦЗЧ1  :    , XTA ,ТР4  ,загрузка: СМ := ТР4
 	   2, Z13 ,20000B  ,Z13: ЗП КАДОПАМ
	   2, Z03 ,20000B  ,Z03: ЧТ КАДОПАМ
	    , ASN ,64+24  ,сдвиг СМ вправо на 24
	    , ATI ,6  ,ИР := СМ
	   3, VLM ,ЦЗЧ1  ,ИР++; если !=0 -> ЦЗЧ1
	    , UJ  ,СТАРТ  ,переход на СТАРТ
* ЦЗП - только запись (без чтения), 200 итер.
*
 ЦЗП  :	    , BSS ,
	   3, VTM ,1-200  ,ИР := 1-200
 ЦЗП1 :	    , XTA ,ТР4  ,загрузка: СМ := ТР4
 	   2, Z13 ,20000B  ,Z13: ЗП КАДОПАМ
	   3, VLM ,ЦЗП1  ,ИР++; если !=0 -> ЦЗП1
	    , UJ  ,СТАРТ  ,переход на СТАРТ
* ЦЧТ - только чтение (без записи), 200 итер.
*
 ЦЧТ  :     , BSS ,
 	   3, VTM ,1-200  ,ИР := 1-200
 ЦЧТ1 :    2, Z03 ,20000B  ,Z03: ЧТ КАДОПАМ
 	    , ASN ,64+24  ,сдвиг СМ вправо на 24
	    , ATI ,6  ,ИР := СМ
	   3, VLM ,ЦЧТ1  ,ИР++; если !=0 -> ЦЧТ1
	    , UJ  ,СТАРТ  ,переход на СТАРТ
* ФАДР - формирование адреса из ТР1 для наладочного теста
*   Берёт б.1-15 ТР1 -> М2 (адрес ОЗУ ДКС)
*
 ФАДР :     , BSS ,
            , XTA ,ТР1  ,загрузка: СМ := ТР1
	    , ATI ,2  ,ИР := СМ
	  13, UJ  ,  ,переход на 
* ВЫБРОС - вывод теста:
*   Выводит N прохода(TВЫБ+8) и N решения(TВЫБ+12)
*   Вызывает ВЫВОД (печать) и сбрасывает тест из очереди
*
 ВЫБРОС :   , BSS ,
 	    , XTA ,NPR  ,загрузка: СМ := NPR .ВЫВОД ТЕСТА ИЗ РЕШЕНИЯ
	    , ATX ,NR  ,запись: NR := СМ
	  12, VJM ,NUM  ,подпрограмма NUM
	    , XTA ,РR  ,загрузка: СМ := РR
	    , ATX ,ТВЫБ+8  ,запись: ТВЫБ+8 := СМ
	    , ITA ,5  ,СМ := ИР
	    , ATX ,NR  ,запись: NR := СМ
	  12, VJM ,NUM  ,подпрограмма NUM
	    , XTA ,PR  ,загрузка: СМ := PR
	    , ATX ,ТВЫБ+12  ,запись: ТВЫБ+12 := СМ
	  14, VTМ ,ТВЫБ
	    , ITS ,14  ,push ИР->стек
	  14, VTM ,ТВЫБ+12  ,ИР := ТВЫБ+12
	    , ITS ,14  ,push ИР->стек
	  14, VTM ,10  ,ИР := 10
	    , ITS ,14  ,push ИР->стек
	    , CALL,PRINT8  ,вызов подпр.
 ВЫБ	:   , SJ  ,  ,возврат из подпр.
* ПАУЗА - пауза между проходами (14 мс)
*
 ПАУЗА  :   , XTA ,=14  ,загрузка: СМ := =14
 	    , *50 ,7 700В  ,Э50 7
	    , UJ  ,СТАРТ  ,переход на СТАРТ
 Т1    :    , BSS ,
           3, VTM ,1  ,ИР := 1  .ТЕСТ1 ЗП-ЧТ. РД.
	    , XTA ,НАД  ,загрузка: СМ := НАД
	    , ATI ,2  ,ИР := СМ
	    , XTA ,ЕКОН  ,загрузка: СМ := ЕКОН
	    , ATX ,Р  ,запись: Р := СМ
 Т1А   :   2, Z13 ,20000В  ,Z13: ЗП КАДОПАМ
           2, Z03 ,20000В  ,Z03: ЧТ КАДОПАМ
	    , ASN ,64+24  ,сдвиг СМ вправо на 24
	    , AAX ,E16  ,СМ &= E16
	    , ATX ,Р1  ,запись: Р1 := СМ
	  13, VJM ,СР1СЛ  ,подпрограмма СР1СЛ .СЧ КОД ВЕРНЫЙ:
	    , XTA ,Р  ,загрузка: СМ := Р
	    , ARX ,ЕКОН  ,СМ += ЕКОН
	    , ATX ,Р  ,запись: Р := СМ
	   3, VLM ,Т1А  ,ИР++; если !=0 -> Т1А
	    , UJ  ,СТАРТ  ,переход на СТАРТ
 Т2   :     , BSS ,
            , XTA ,НАД  ,загрузка: СМ := НАД .ТЕСТ ЗП-ЧТ А-(А)
	    , ATI ,2  ,ИР := СМ
 Т2А  :     , ITA ,2  ,СМ := ИР
 	   2, Z13 ,20000В  ,Z13: ЗП КАДОПАМ
	    , AEX ,ВАД  ,СМ ^= ВАД .РОСП. ПАМЯТИ
	    , UZA ,Т2В  ,если СМ=0 -> Т2В
	   2, UTM ,1  ,ИР += 1
	    , UJ  ,Т2А  ,переход на Т2А
 Т2В  :     , BSS ,
 Т2ВА :     , ITA ,2  ,СМ := ИР
            , ATX ,Р  ,запись: Р := СМ
	   2, Z03 ,20000В  ,Z03: ЧТ КАДОПАМ
	    , ASN ,64+24  ,сдвиг СМ вправо на 24
	    , AAX ,E16  ,СМ &= E16
	    , ATX ,Р1  ,запись: Р1 := СМ
	  13, VJM ,СР1СЛ  ,подпрограмма СР1СЛ
	    , XTA ,Р  ,загрузка: СМ := Р
	    , AEX ,НАД  ,СМ ^= НАД
	    , UZA ,СТАРТ  ,если СМ=0 -> СТАРТ
	   2, UTM ,-1  ,ИР += -1
	    , UJ  ,Т2ВА  ,переход на Т2ВА
 Т3  :      , BSS ,
            , XTA ,Е16  ,загрузка: СМ := Е16 .ТЕСТ ЗП-ЧТ ВСЕ 1
	    , ATX ,Р  ,запись: Р := СМ
	    , UJ  ,Т34  ,переход на Т34
 Т4  :      , BSS ,
            , XTA ,  ,загрузка: СМ := .ТЕСТ ЗП-ЧТ ВСЕ 0
	    , ATX ,Р  ,запись: Р := СМ
	    , UJ  ,Т34  ,переход на Т34
 Т34 :      , BSS ,
            , XTA ,НАД  ,загрузка: СМ := НАД
	    , ATI ,2  ,ИР := СМ
 Т34ЗП :    , XTA ,Р  ,загрузка: СМ := Р .ЦИКЛ ЗП.
	   2, Z13 ,20000В  ,Z13: ЗП КАДОПАМ
	    , ITA ,2  ,СМ := ИР
	    , AEX ,ВАД  ,СМ ^= ВАД
	    , UZA ,Т34ЧТ  ,если СМ=0 -> Т34ЧТ
	   2, UTM ,1  ,ИР += 1
	    , UJ  ,Т34ЗП  ,переход на Т34ЗП
 Т34ЧТ  :   , BSS ,
            , XTA , НАД  ,загрузка: СМ := НАД
	    , ATI ,2  ,ИР := СМ
 Т34ВА  : 13, VJM ,ОБРАБ  ,подпрограмма ОБРАБ
 	    , UJ  ,Т34ВА  ,переход на Т34ВА
 Т5     :   , BSS ,
            , XTA ,  ,загрузка: СМ := .БЕГУЩИЙ 0
	    , ATX ,P3  ,запись: P3 := СМ
	    , UJ  ,Т56  ,переход на Т56
 Т6     :   , BSS ,
            , XTA ,E16  ,загрузка: СМ := E16
	    , ATX ,P3  ,запись: P3 := СМ
	    , UJ  ,T56  ,переход на T56
 Т56    :   , BSS ,
            , XTA ,Е1  ,загрузка: СМ := Е1
	    , ATX ,Р2  ,запись: Р2 := СМ
	    , XTA ,НАД  ,загрузка: СМ := НАД
	    , ATI ,2  ,ИР := СМ
 Т56А   : 13, VJM ,ФОР  ,подпрограмма ФОР
            , XTA ,Р  ,загрузка: СМ := Р
	   2, Z13 ,20000В  ,Z13: ЗП КАДОПАМ
	    , ITA ,2  ,СМ := ИР
	    , AEX ,ВАД  ,СМ ^= ВАД
	    , UZA ,Т56В  ,если СМ=0 -> Т56В
	   2, UTM ,1  ,ИР += 1
	    , UJ  ,Т56А  ,переход на Т56А
 Т56В    :   , BSS ,
            , XTA ,Е1  ,загрузка: СМ := Е1
	    , ATX ,Р2  ,запись: Р2 := СМ
	    , XTA ,НАД  ,загрузка: СМ := НАД
	    , ATI ,2  ,ИР := СМ
 Т56ВА  : 13, VJM ,ФОР  ,подпрограмма ФОР
          13, VJM ,ОБРАБ  ,подпрограмма ОБРАБ
	    , UJ  ,Т56ВА  ,переход на Т56ВА
 ФОР	:   , BSS ,
            , XTA ,P3  ,загрузка: СМ := P3
	    , AEX ,P2  ,СМ ^= P2
	    , ATX ,P  ,запись: P := СМ
	    , XTA ,P2  ,загрузка: СМ := P2
	    , ASN ,64-1  ,сдвиг СМ влево на 63
	    , AAX ,E16  ,СМ &= E16
	    , ATX ,P2  ,запись: P2 := СМ
	  13, U1A ,  ,если СМ!=0 -> 
	    , XTA ,Е1  ,загрузка: СМ := Е1
	    , ATX ,P2  ,запись: P2 := СМ
	  13, UJ  ,  ,переход на 
* ОБРАБ - обработка ошибок:
*   Выводит TВЫБ, счётчик ошибок, Э50 7700 (будильник)
*
 ОБРАБ  :   , BSS ,
           2,Z03  ,20000В  ,Z03: ЧТ КАДОПАМ
	    , ASN ,64+24  ,сдвиг СМ вправо на 24
	    , AAX ,E16  ,СМ &= E16
	    , ATX ,P1  ,запись: P1 := СМ
	    , ITA ,13  ,СМ := ИР
	    , ATX ,P8  ,запись: P8 := СМ
	  13, VJM ,СР1СЛ  ,подпрограмма СР1СЛ
	    , XTA ,P8  ,загрузка: СМ := P8
	    , ATI ,13  ,ИР := СМ
	    , ITA ,2  ,СМ := ИР
	    , AEX ,ВАД  ,СМ ^= ВАД
	    , UZA ,СТАРТ  ,если СМ=0 -> СТАРТ
	   2, UTM ,1  ,ИР += 1
	  13, UJ  ,  ,переход на 
* ФАД - формирование диапазона адресов:
*   Вход: ТР1 и ТР4; б.21=0 -> defaults [10..67777](8)
*   Выход: НАД=нач.адрес ВАД=конечный
*
 ФАД   :    , BSS ,
 	    , XTA ,ТР4  ,загрузка: СМ := ТР4
	    , AAX ,E21Р  ,СМ &= E21Р
	    , U1A ,ФАД1  ,если СМ!=0 -> 
	    , XTA ,ЕНАД  ,загрузка: СМ := ЕНАД
	    , ATX ,НАД  ,запись: НАД := СМ
	    , XTA ,ЕВАД  ,загрузка: СМ := ЕВАД
	    , ATX ,ВАД  ,запись: ВАД := СМ
	  13, UJ  ,  ,переход на 
 ФАД1  :    , XTA ,ТР1  ,загрузка: СМ := ТР1
 	    , AAX ,E15  ,СМ &= E15
	    , ATX ,НАД  ,запись: НАД := СМ
	    , XTA ,ТР4  ,загрузка: СМ := ТР4
	    , AAX ,Е15  ,СМ &= Е15
	    , ATX ,ВАД  ,запись: ВАД := СМ
	  13, UJ  ,  ,переход на 
 Т7   :     , BSS ,
           3, VTM ,1-20  ,ИР := 1-20 .ЦИКЛ СЛОЖЕНИЯ
	    , XTA ,ЕКОН  ,загрузка: СМ := ЕКОН
	    , ATX ,P  ,запись: P := СМ
 T7A1 :     , XTA ,НАД  ,загрузка: СМ := НАД
 	    , ATI ,2  ,ИР := СМ
	    , XTA ,P  ,загрузка: СМ := P
	    , ATX ,P2  ,запись: P2 := СМ
 Т7А  :    2, Z13 , 20000В  ,Z13: ЗП КАДОПАМ
	    , ITA ,2  ,СМ := ИР
	    , AEX ,ВАД  ,СМ ^= ВАД
	    , UZA ,Т7В  ,если СМ=0 -> Т7В
	   2, UTM ,1  ,ИР += 1
	    , XTA ,Р  ,загрузка: СМ := Р
	    , ARX ,ЕКОН  ,СМ += ЕКОН
	    , ATX ,Р  ,запись: Р := СМ
	    , UJ  ,Т7А  ,переход на Т7А
 Т7В  :     , BSS ,
 	    , XTA ,НАД  ,загрузка: СМ := НАД
	    , ATI ,2  ,ИР := СМ
	    , XTA ,P2  ,загрузка: СМ := P2
	    , ATX ,P  ,запись: P := СМ
 Т7ВА :    2, Z03 ,20000В  ,Z03: ЧТ КАДОПАМ
            , AAX ,Е16  ,СМ &= Е16
	    , ATX ,P1  ,запись: P1 := СМ
	  13, VJM ,СР1СЛ  ,подпрограмма СР1СЛ
	    , ITA ,2  ,СМ := ИР
	    , AEX ,ВАД  ,СМ ^= ВАД
	    , UZA ,R  ,если СМ=0 -> R
	   2, UTM ,1  ,ИР += 1
	    , XTA ,Р  ,загрузка: СМ := Р
	    , ARX ,ЕКОН  ,СМ += ЕКОН
	    , ATX ,P  ,запись: P := СМ
	    , UJ  ,Т7ВА  ,переход на Т7ВА
 R    :    3, VLM ,Т7А1  ,ИР++; если !=0 -> Т7А1
            , XTA ,NPR  ,загрузка: СМ := NPR
	    , A+X ,=1
	    , ATX ,NPR  ,запись: NPR := СМ
	    , UJ  ,СТАРТ  ,переход на СТАРТ
* СЧЕТ - инкремент счётчика проходов:
*   NPR++; переход на СТАРТ0 для следующего цикла
*
 СЧЕТ :	    , BSS ,
            , XTA ,NPR  ,загрузка: СМ := NPR .УВЕЛИЧ. СЧЕТЧ.
	    , A+X ,=1  .ЧИСЛА ПОВТОР. ТЕСТА
	    , UJ  ,СТАРТ0  ,переход на СТАРТ0
* СР1СЛ - сравнение 16 бит: P1 vs [адрес]
*   Если != -> ERR
*
 СР1СЛ :    , BSS ,
 	    , XTA ,P  ,загрузка: СМ := P
	    , AAX ,E16  ,СМ &= E16
	    , AEX ,P1  ,СМ ^= P1
	    , U1A ,ERR  ,если СМ!=0 -> 
	  13, UJ  ,  ,переход на 
* ERR - НЕСОВПАДЕНИЕ:
*   1. Повторить чтение (Z03)
*   2. б.23=1 -> печать через ERRA
*   3. б.22=1 -> СТОП
*
 ERR   :    , BSS ,
           5, UTM ,1  ,ИР += 1
	   2, Z03 ,20000В  ,Z03: ЧТ КАДОПАМ
	    , ASN ,64+24  ,сдвиг СМ вправо на 24
	    , AAX ,E16  ,СМ &= E16
	    , ATX ,P7  ,запись: P7 := СМ
	    , *65 ,4  ,Э65=тумбл.рег.4
	    , AAX ,E23P  ,СМ &= E23P .НАДО ПЕЧАТЬ
	    , U1A ,ERRA  ,если СМ!=0 -> 
 МЕ5   :    , *65 ,4  ,Э65=тумбл.рег.4
 	    , AAX ,E26Р  ,СМ &= E26Р .ОСТ. ПРИ ОШ.
	    , U1A ,СТОП  ,если СМ!=0 -> 
	  13, UJ  ,  ,переход на 
 ME2   :    , *65 ,4  ,Э65=тумбл.рег.4
            , AAX ,E22P  ,СМ &= E22P
	    , U1A ,СТОП1  ,если СМ!=0 -> 
	  13, UJ  ,  ,переход на 
 СТОП :    2, Z33 ,  ,Z33: ЧТ+ЗП КАДОПАМ
          13, UJ  ,  ,переход на 
 СТОП1 :    , XTA ,=14  ,загрузка: СМ := =14 .СТОП С ОЖИДАНИЕМ
	    , *50 ,7 700B  ,Э50 7
	    , UJ  ,ME2  ,переход на ME2
* ERRA - формирование ISO-сообщения об ошибке:
*   Заполняет TERR (эталон, код, маршрут, абонент, N прохода)
*
 ERRA  :    , XTA ,P  ,загрузка: СМ := P
            , AAX ,E16  ,СМ &= E16
	    , ATX ,NR  ,запись: NR := СМ
	  12, VJM ,NUM  ,подпрограмма NUM
	    , XTA ,PR  ,загрузка: СМ := PR
	    , ATX ,TERR+4  ,запись: TERR+4 := СМ
	    , XTA ,P1  ,загрузка: СМ := P1
	    , ATX ,NR  ,запись: NR := СМ
	  12, VJM ,NUM  ,подпрограмма NUM
	    , XTA ,PR  ,загрузка: СМ := PR
	    , ATX ,TERR+6  ,запись: TERR+6 := СМ
	    , ITA ,2  ,СМ := ИР
	    , ATX ,NR  ,запись: NR := СМ
	  12, VJM ,NUM  ,подпрограмма NUM
	    , XTA ,PR  ,загрузка: СМ := PR
	    , ATX ,TERR+9  ,запись: TERR+9 := СМ
	    , ITA ,1  ,СМ := ИР
	    , ATX ,NR  ,запись: NR := СМ
	  12, VJM ,NUM  ,подпрограмма NUM
	    , XTA ,PR  ,загрузка: СМ := PR
	    , ATX ,TERR+12  ,запись: TERR+12 := СМ
	    , XTA ,P7  ,загрузка: СМ := P7
	    , ATX ,NR  ,запись: NR := СМ
	  12, VJM ,NUM  ,подпрограмма NUM
	    , XTA ,PR  ,загрузка: СМ := PR
	    , ATX ,TERR+14  ,запись: TERR+14 := СМ
	    , ITA ,13  ,СМ := ИР
	    , ATX ,P5  ,запись: P5 := СМ
	  14, VTM ,TERR  ,ИР := TERR
	    , ITS ,14  ,push ИР->стек
	  14, VTM ,TERR+14  ,ИР := TERR+14
	    , ITS ,14  ,push ИР->стек
	  14, VTM ,10  ,ИР := 10
	    , ITS ,14  ,push ИР->стек
	    , CALL,PRINT8  ,вызов подпр.
	    , XTA ,P5  ,загрузка: СМ := P5
	    , ATI ,13  ,ИР := СМ
	    , UJ  ,ME5  ,переход на ME5
* NUM - формирование числа в ISO-кодах:
*   Вход: NR=число -> PR=ISO-строка
*
 NUM  :     , BSS ,
            , XTA ,  ,загрузка: СМ := 
	    , ATX ,PR  ,запись: PR := СМ
	   4, VTM ,1-6  ,ИР := 1-6
	  11, VTM ,8  ,ИР := 8
	    , XTA ,NR  ,загрузка: СМ := NR
 NUM1 :     , AAX ,=7  ,СМ &= =7
            , AOX ,=60  ,СМ |= =60
	  11, ASN ,64-8  ,сдвиг СМ влево на 56
	    , AOX ,PR  ,СМ |= PR
	    , ATX ,PR  ,запись: PR := СМ
	  11, UTM ,-8  ,ИР += -8
	    , XTA ,NR  ,загрузка: СМ := NR
	    , ASN ,64+3  ,сдвиг СМ вправо на 3
	    , ATX ,NR  ,запись: NR := СМ
	   4, VLM ,NUM1  ,ИР++; если !=0 -> NUM1
	  12, UJ  ,  ,переход на 

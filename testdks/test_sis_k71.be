	    , CONT,6HЧИСЛО
	    , CONT,12H ; АДРЕС:
	    , CONT,12H ; ТЕСТ N
	    , CONT,6HЧИСЛО
	    , CONT,6HПОВТ:
	    , CONT,6HЧИСЛО
	    , END ,



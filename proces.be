***************************************************
Э239    УИА     '2000'      , режим без приписки
        СЧ      (М6)        , прочитать первое слово буфера
        УИА     3           , восстановить режим
        ПО      Э2313       , если 0 – к Э2313
        НТЖ     ШИФ         , сравнить с сохранённым шифром
        УИА     18(М15)     , код ошибки 18 (не от той задачи)
        ПЕ      АОШ1        , если не совпал – ошибка
Э2313   УИА     '2000'
        СЧ      1(М6)       , прочитать второе слово (порт/канал)
        УИА     3
        ЗП      Р2          , сохранить в Р2
        И       П377        , оставить младшие 8 бит
        УИА     19(М15)     , код ошибки 19 (не тот порт)
        ПО      Э2314       , если 0 – к Э2314
        НТЖ     ПОРТО       , сравнить с ожидаемым портом
        ПЕ      АОШ1        , если не совпал – ошибка
Э2314   СЧ      Р2          , загрузить Р2
        СДА     64+16       , выделить номер канала отправителя
        И       П77         , оставить 6 бит
        ПО      Э23140      , если 0 – к Э23140
        ЗП      СМ          , сохранить номер канала
        СЧИ     М1          , загрузить номер текущей задачи
        НТЖ     СМ          , сравнить с каналом отправителя
        ПЕ      АОШ1        , если не совпал – ошибка
Э23140  СЧ      Е48-1(М10)  , маска получателя
        ЗП      АН+1        , сохранить
        СЧ      Р3          , загрузить Р3 (поле флагов)
        И       Е24         , проверить бит Е24
        ПЕ      НЕ          , если установлен – к НЕ
        СЧ      АН+1        , иначе загрузить маску
        УИИ     М14(М4)     , М14 := адрес порта
        УИА     '2000'
        ИЛИ     1(М4)       , прочитать флаги порта
        ЗП      1(М4)       , закрыть приём
НЕ      УИА     3           , разрешить прерывания
        СЧ      ШИФ         , загрузить сохранённый шифр
        УИА     '2000'
        ЗП      (М6)        , записать в буфер
        УИА     3
        СЧ      LS          , загрузить размер сообщения
        СДА     64-36       , сдвинуть для упаковки
        ЗП      Р2          , сохранить
        СЧ      R2          , загрузить номер канала отправителя
        СДА     64-16       , сдвинуть
        ИЛИ     ПОРТО       , добавить номер порта
        ИЛИ     Р2          , добавить размер
        УИА     '2000'
        ЗП      1(М6)       , записать в буфер
        УИА     3
        СЧ      LS          , загрузить размер
        ПО      Э23В        , если 0 – к Э23В (ничего не копировать)
        НТЖ     П77777      , инвертировать
        УИ      М5          , М5 := счётчик цикла
        СЛИА    1(М5)       , +1
        СЧ      Н+1         , загрузить первый элемент Н
        И       Е28         , проверить бит Е28
        ПО      У           , если 0 – к У
        СЧ      Н+3        , иначе загрузить Н+3
        И       П77777      , оставить адрес
        ПБ      Й           , перейти
У       СЧ      ММ6         , загрузить ММ6
        СЛЦ     Е2          , добавить 2
Й       СЛЦ     АН+2        , добавить адрес отправителя
        УИ      М11         , М11 := источник
        СЧ      Н           , загрузить Н
        И       Е28         , проверить бит
        ПО      Z           , если 0 – к Z
        МОД     Н+2         , адрес назначения
        УИА     (М10)       , М10 := адрес
        ПБ      ZZ          , перейти
Z       УИИ     М10(М6)     , М10 := адрес буфера получателя
        СЛИА    2(М10)      , +2
ZZ      МОД     РАБ         , адрес смещения отправителя
        УИА     (М4)        , М4 := база отправителя
        СЛИ     М10(М4)     , сложить с адресом назначения
        СЧИ     М11         , загрузить источник
        СДА     64+10       , выделить номер листа
        УИ      М4          , сохранить
        СЧИ     М10         , загрузить назначение
        СДА     64+10       , выделить номер листа
        УИ      М3          , сохранить
        СЧ                  , очистить сумматор
        ЗП      Р2          , сбросить счётчик

        ЗП      LМ          , LМ := максимальная длина сообщений
        УИА     '2000'      , режим без приписки
        СЧ      (М4)        , прочитать по адресу М4
        УИА     3           , восстановить
        И       Е48-1(М10)  , маска для проверки порта
        УИА     2(М15)      , код ошибки 2 (нет ПО или ПП)
        ПО      ОШ          , если нет – ошибка
        МОД     АТПОРТ(М2)  , адрес таблицы портов для задачи
        УИА     (М15)       , М15 := 0
        УИА     '2000'
        СЧ      1(М15)      , прочитать первый элемент
        УИА     3
        И       Е16         , проверить бит Е16
        УИА     8(М15)      , код ошибки 8 (все порты закрыты)

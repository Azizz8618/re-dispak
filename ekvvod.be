 НТЖ R1                                 ,СМ ^= R1
 ПЕ НЗМЛ                                ,если СМ≠0 → НЗМЛ
 СЛИА 15(М17)                           ,М17 += 15
 СЛИ М17(М17)                           ,М17 += М17
 СЛИА 24(М17)                           ,М17 += 24
 СЛИ М17(М16)                           ,М17 += М16
 ПБ ЦСС                                 ,переход на ЦСС
НЗМЛ МОДА ТМЛН                          ,мод.адрес +1: ТМЛН


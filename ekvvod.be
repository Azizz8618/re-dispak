ЭКВВОД	СТАРТ	'10000'                 ,эквивалент ввода
 Б
 Е
 М
*
* ЭКВВОД — эквивалент ввода (диспетчер команд терминала)
*
* Назначение: модуль обрабатывает команды ввода от терминалов,
* управляет чтением/записью зон на МЛ/МД, обработкой каталогов,
* архивацией и взаимодействием с другими модулями ДИСП70.
*
* Основной поток: приём команды через ПОЧТА → КВ → определение
* типа операции → вызов подпрограмм (ВЫЗ1..ВЫЗ7) → КОНЕЦ1.
*
* Связи с другими модулями:
*   ВНЕШ: ДИСП70 (ТУСП, ШКЗЗК, ПОЧТА, НОММБ, ГОД, ШКОК, ...)
*   ВНЕШ: ЭКСТ  (Э105Г..Э221 — номера экстракодов)
*   ВНЕШ: СОСТАВ (НАРМД, МДР, АРХМЛ, ШЗНМБ, ОБЩТОМ, ...)
*   ВНЕШ: КАЧКА (ШКРЗ), КИТ (Е48П42), МОТТ (ПРОБ6, СВИСТ4)
*   ВНЕШ: ХЛАМ (ОСВУ)
*
* Регистры: Б (база данных), Е (база кода), М (модификация)
* УПОТР ЭКВВОД(М7) — базовый регистр модуля
* Входные точки: КВ (команда ввода), КОНЕЦ1 (завершение),
*   АВОС (аварийный выход), ВЫХ (выход с записью зоны),
*   и множество точек для экстракодов (Э105Г, Э110, Э115, ...)
*
 УПОТР ЭКВВОД(М7)                       ,базовый регистр
 КОНД В’0’                              ,В’0’
 КОНД М41В’3’ РЖА 3                     ,М41В’3’
 КОНД (21)В’0’                          ,(21)В’0’
 КОНД В’0’    НЕ ЗАНИМАТЬ               ,В’0’
КВ ЗП 34(М3)                            ,34 := СМ
 ПБ КОНЕЦ1                              ,переход на КОНЕЦ1
 КОНД В’0’ 25-Ю ЯЧ.НЕ ЗАНИМАТЬ          ,В’0’
Р1 ПАМ 1                                ,резерв 1 слов
Р2 ПАМ 1                                ,резерв 1 слов
Р3 ПАМ 1                                ,резерв 1 слов
Р4 ПАМ 1                                ,резерв 1 слов
РА ПАМ 1                                ,резерв 1 слов
 ПАМ 1  ПРИП                            ,резерв 1 слов
 КОНД М15В’1’  ДЛЯ Э64                  ,М15В’1’
 КОНД М47В’1’  ВРЕМЯ РАБОТЫ ЭКВВОД      ,М47В’1’
ИР16 ПАМ 1                              ,резерв 1 слов
РР ПАМ 1                                ,резерв 1 слов
Ш ПАМ 1                                 ,резерв 1 слов
КИС ПАМ 1                               ,резерв 1 слов
R1 КОНД В’0’                            ,В’0’
R2 КОНД В’0’                            ,В’0’
	уиа	'3'                     ,ИР := '3' (начало обработки команды)
 И П77                                  ,СМ &= П77 (номер команды 0-177)
	по	КОН1                    ,если СМ=0 → КОН1 (пустая команда)
 ЗП ПОЧТА(М7)                           ,ПОЧТА := СМ (сохранить номер команды)
 УИ М2                                  ,М2 := СМ (М2 = номер команды)
	сч	обвнп1+24+4             ,СМ := обвнп1+24+4 (адрес таблицы команд)
 СЧ 0                                   ,СМ := 0
 ЗП РАБАД                               ,РАБАД := СМ
 УИА (М12)                              ,М12 := 0
 УИА (М4)                               ,М4 := 0
 УИА (М5)                               ,М5 := 0
 СЧ Е1                                  ,СМ := Е1
 ЗП НМ+1                                ,НМ+1 := СМ
 ЗП R                                   ,R := СМ
 СЧ НОММБ                               ,СМ := НОММБ
 ЗП НМ                                  ,НМ := СМ
 СЧ ТУСП-1(М2)                          ,СМ := ТУСП-1
 УИ М3 АДРЕС ИПЗ                        ,М3 := СМ
 СЧ 36(М3)                              ,СМ := 36
        и       Е15П11                  ,СМ &= Е15П11
	пе	АВОС                    ,если СМ≠0 → АВОС
	сч	36(М3)                  ,СМ := 36
	и	Е15П1                   ,СМ &= Е15П1
 ВЧ Е7                                  ,СМ -= Е7
 ПЕ ВВОДМ                               ,если СМ≠0 → ВВОДМ
 УИ М13                                 ,М13 := СМ
	вчоб	ЧЭК                     ,СМ := (адрес) - СМ
	по	ДЕШЭК                   ,если СМ=0 → ДЕШЭК
ВВОДМ	уиа	0(М13)                  ,М13 := 0

* ВВОДМ
*   Регистры: М13
*   Вход: ВВОДМ
*   Выход: ВЫЗ4
*
	пб	ВЫЗ4                    ,переход на ВЫЗ4
КПР1 СЧИ М2                             ,СМ := М2
*
* КПР1 — чтение каталога (каталог + запись)
*   Алгоритм: формирование адреса каталога из номера задачи (М2),
*   вызов буфера каталога (ТБУФ), чтение зоны каталога (ФИЗОБМ).
*   КПР — точка повторного чтения (без формирования адреса).
*   ПР3, ПР30 — промежуточные точки для циклического чтения.
*
 И П17                                  ,СМ &= П17
 УИ М5                                  ,М5 := СМ
 СЧИ М2                                 ,СМ := М2
 СДА 64+4                               ,сдвиг СМ вправо на 4
 ВЧОБ Е2                                ,СМ := (адрес) - СМ
 ИЛИ КАТ1                               ,СМ |= КАТ1
 ЗП КАТ                                 ,КАТ := СМ
КПР СЧ R                                ,СМ := R
 ПВ ТБУФ(М15)                           ,вызов через М15
 СДА 64-8                               ,сдвиг СМ влево на 8
 УИ М1 А НАЧ.ЛИСТА                      ,М1 := СМ
ПР3 СДА 64-2                            ,сдвиг СМ влево на 2
 ИЛИ НМ                                 ,СМ |= НМ
 МОДА (М4) М4 СНАЧАЛА=0                 ,мод.адрес +1: (М4) М4 СНАЧ
 СЛЦ КАТ                                ,СМ += КАТ [цикли.]
ПР30 ЗП КАТ                             ,КАТ := СМ
 ПВ ФИЗОБМ(М16) ЧТЕН.КАТАЛ.             ,вызов через М16
 УИА 3                                  ,ИР := 3
 ПБ (М6)                                ,переход через М6
КНЦ СЧ КАТ                              ,СМ := КАТ

* КНЦ
*   Регистры: М3, М6, М15, М16, М17
*   Вход: АВОС1
*   Выход: ТБУФ(М15) ОТДАТЬ ЛИСТ, АВОСТА
*
 ПВ ТБУФ(М15) ОТДАТЬ ЛИСТ               ,вызов через М15
АВОС1 УИИ М17(М6)                       ,М17 := М6
 УИИ М15(М3)                            ,М15 := М3
 МОДА КОНЕЦ1                            ,мод.адрес +1: КОНЕЦ1
 УИА (М16)                              ,М16 := 0
	уиа	'2003'                  ,ИР := '2003'
 ПБ АВОСТА                              ,переход на АВОСТА
АВОС УИА 36(М6)                         ,М6 := 36


* ВЫЗ1
*   Регистры: М7, М13, М16
*   Вход: ВЫЗА
*   Выход: (М1), ФИЗОБМ
*
ВЫЗА СЛИ М16(М7)                        ,М16 += М7
 СЧИ М7                                 ,СМ := М7
 СДА 64-2                               ,сдвиг СМ влево на 2
* ВЫЗА — общая точка вызова подпрограмм ДИСП70
*   Алгоритм: формирование адреса вызова через таблицу КЭКСТ,
*   проверка кэша зон (НСЕ), если зона уже в памяти — прямой
*   переход, иначе — вызов ФИЗОБМ для чтения с диска.
 ИЛИ (М16)                              ,СМ |= (М16)
 СЛЦ НОММБ1                             ,СМ += НОММБ1 [цикли.]
 УИИ М1(М7)                             ,М1 := М7
 СЛИА 768(М1)                           ,М1 += 768
 ЗП РА                                  ,РА := СМ
 И П177                                 ,СМ &= П177
 НТЖ НСЕ                                ,СМ ^= НСЕ
	уиа	'2003'                  ,ИР := '2003'
 МОДА (М13)                             ,мод.адрес +1: (М13)
 ПО (М1)                                ,если СМ=0 → (М1)
 НТЖ НСЕ                                ,СМ ^= НСЕ
 ЗП НСЕ                                 ,НСЕ := СМ
 СЧ РА                                  ,СМ := РА
 УИИ М16(М1)                            ,М16 := М1
 СЛИ М16(М13)                           ,М16 += М13
 ПБ ФИЗОБМ                              ,переход на ФИЗОБМ
ВЫЗ2 УИА КЭК2-Э(М16)                    ,М16 := КЭК2-Э


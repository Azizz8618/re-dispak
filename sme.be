        СЧ      ИЗАХВ(М11)     , СНОВА СЛОВО ЗАХВАТА
        СДА     64+20          , ВЫДЕЛИТЬ НОМЕР УСТРОЙСТВА
        МОДА    1(М4)          , МОДИФИКАЦИЯ ПО М4
        НТЖ     Р2-А(М7)       , СРАВНИТЬ С ИНДЕКСОМ ПРИЁМНИКА
        И       П77            , ПО 6 БИТАМ
        ПЕ      ИЩУ            , ЕСЛИ НЕ СОВПАДАЕТ – ИЩУ
        УИА     1027           , СОВПАЛО: БЛОКИРОВКА ПРЕРЫВАНИЙ
        СЧ      Р3-А(М7)       , ЗАГРУЗИТЬ ИНДЕКС ИСТОЧНИКА
        сда     64-20          , СДВИГ ДЛЯ ПОЛЯ
        нтж      ИЗАХВ(М11)    , СБРОСИТЬ СТАРОЕ УСТРОЙСТВО
        и       Е26П21         , МАСКА 26-21
        нтж      ИЗАХВ(М11)    , ВОССТАНОВИТЬ ОСТАЛЬНОЕ
        ЗП      ИЗАХВ(М11)     , ОБНОВИТЬ ЗАХВАТ

ПОИС1   УИА     -2(М4)         , ВОССТАНОВИТЬ СЧЁТЧИК ВНУТРЕННЕГО ЦИКЛА
        СЧИ     М10            , ЗАГРУЗИТЬ НОМЕР ИСТОЧНИКА
        ЗП      И10            , СОХРАНИТЬ В И10
        УИА     3              , РАЗРЕШИТЬ ПРЕРЫВАНИЯ

ПОИС10  УИА     -1(М17)        , СЧЁТЧИК ЦИКЛА ПО НАПРАВЛЕНИЯМ (М17)
        УИИ     М15(М7)        , М15 := БАЗА
ПОИС    МОДА    (М11)          , АДРЕСАЦИЯ ПО ИПЗ ЗАДАЧИ
        СЧ      ОБЩТОМ+3(М2)   , ЗАГРУЗИТЬ СЛОВО ОБЩТОМ+3
        СД      КТОМ+2(М4)     , СДВИГ ПО ТАБЛИЦЕ КТОМ (М4)
        МОДА    1(М17)         , МОДИФИКАЦИЯ ПО НАПРАВЛЕНИЮ
        НТЖ     Р2-А(М7)       , СРАВНИТЬ С ПРИЁМНИКОМ
        И       П77            , ПО 6 БИТАМ
        ПО      ЭТОТ-А(М7)     , ЕСЛИ СОВПАДАЕТ – К ЭТОТ (АВМД)

ПД      СЛИА    -1(М15)        , ИНАЧЕ СЛЕДУЮЩИЙ АДРЕС
        МОДА    ПОИС

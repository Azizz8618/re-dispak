        СЧИ     М2             , ЗАГРУЗИТЬ СОХРАНЁННЫЙ М12
        ЗП      Б1             , ОБНОВИТЬ Б1
        СЧ      НМД+1-А(М16)   , ЗАГРУЗИТЬ ШКАЛУ НОВЫХ ДИСКОВ
        НТЖ     Е48(М10)       , СБРОСИТЬ БИТ ИСТОЧНИКА
        ЗП      НМД+1-А(М16)   , ОБНОВИТЬ
        СЧИ     М16            , ЗАГРУЗИТЬ М16
        ЗП      Б2             , СОХРАНИТЬ В Б2
        СЧИ     М4             , ЗАГРУЗИТЬ УСТР. ПРИЁМНИКА
        УИИ     М4(М10)        , СОХРАНИТЬ М10 В М4
        УИ      М10            , ВОССТАНОВИТЬ М10
        СЛИА    У(М10)         , ДОБАВИТЬ У (31)
        СЧИ     М10            , ЗАГРУЗИТЬ
        И       П37            , ВЫДЕЛИТЬ НОМЕР
        УИ      М10            , М10 := НОМЕР
        СЧ      НМД+1-А(М1)    , ЗАГРУЗИТЬ ШКАЛУ НОВЫХ ДИСКОВ ДЛЯ ИСТОЧНИКА
        НТЖ     Е48(М10)       , СБРОСИТЬ БИТ ПРИЁМНИКА
        ЗП      НМД+1-А(М1)    , ОБНОВИТЬ
        СЛИА    -У(М4)         , ВОССТАНОВИТЬ М4
        ПБ      ЕСТЬДИ         , ПЕРЕЙТИ К ЕСТЬДИ (ПОВТОРИТЬ ОБРАБОТКУ)

***************************************************
* ДАННЫЕ МОДУЛЯ СМЕ
***************************************************
Б1      КОНД    В'0'            , ЯЧЕЙКА ДЛЯ СОХРАНЕНИЯ М2
Б2      КОНД    В'0'            , ЯЧЕЙКА ДЛЯ СОХРАНЕНИЯ М16
КВТЗ    КОНД    М40В'377'В'377777777' , МАСКА ОЧИСТКИ ПОЛЯ ЗОНЫ
И10     КОНД    В'0'            , РАБОЧАЯ ЯЧЕЙКА (НОМЕР ИСТОЧНИКА)
R       ПАМ     1               , РАБОЧАЯ ЯЧЕЙКА (ШКАЛА ОЧЕРЕДИ)
        Е                       , ПЕРЕХОД В СЕКЦИЮ ДАННЫХ
        М                       , ПЕРЕХОД В СЕКЦИЮ КОМАНД (УЖЕ НЕ НУЖНО)

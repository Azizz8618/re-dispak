        МОДА    ПОИС1
        ЦИКЛ    (М2)
НОЛЬИП  НОП     ,
        УИА     3
        МОДА    ПОИСК
        ЦИКЛ    (М1)
        МОДА    НОВ1-А(М7)     , АДРЕС НОВ1 (АВМД)
        ПИО     (М14)          , ЕСЛИ М14=0 – ПЕРЕЙТИ К НОВ1
        СЧ      Б1             , ЗАГРУЗИТЬ Б1 (СОХРАНЁННЫЙ М2)
        УИ      М12            , ВОССТАНОВИТЬ М12
        СЧ      Б2             , ЗАГРУЗИТЬ Б2
        УИ      М16            , ВОССТАНОВИТЬ М16
        ПБ      НВ2-А(М7)      , ПЕРЕЙТИ К НВ2 (АВМД)

ИЩУ     СЛИА    -1(М15)        , УМЕНЬШИТЬ АДРЕС
        МОДА    ПОИ
        ЦИКЛ    (М4)

зн2     сч      E32(М4)        , ЗАГРУЗИТЬ МАСКУ ПРИЁМНИКА
        или     КОПЗ-3(М11)    , УСТАНОВИТЬ ЗАПРЕТ ДЛЯ ПРИЁМНИКА
        зп      КОПЗ-3(М11)
зн11    сч      ОСУ-1(М11)     , ПРОВЕРИТЬ ОСУ-1 ПРИЁМНИКА
        и       E32(М4)
        по      СИД
        сч      ВСЕЕД
        мод     Р2-А(М7)
        нтж     ШОЧМД
        зп      R
        и       ШОЧНМД+1(М11)
        зп      ШОЧНМД+1(М11)
        пб      СИД

***************************************************

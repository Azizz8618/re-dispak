        уиа     (М2)           , СБРОС М2
        мод     Р2-А(М7)       , АДРЕС ЗАПИСИ ПРИЁМНИКА
        сч      нтзнмд-А(М7)   , ЗАГРУЗИТЬ ТАБЛИЦУ НОВЫХ ДИСКОВ
        и       E37            , ПРОВЕРИТЬ БИТ 37 (ПРИЗНАК)
        уиа     '2003'         , БЛОКИРОВКА ПРЕРЫВАНИЙ
        по      сво            , ЕСЛИ 0 – К СВО
        мод     Р3-А(М7)
        сч      нтзнмд-А(М7)   , ПОВТОРНАЯ ПРОВЕРКА
        и       E37
        по      св1            , ЕСЛИ 0 – К СВ1
        уиа     1(М1)          , УСТАНОВИТЬ ФЛАГ М1=1
смд     мод     Р3-А(М7)
        сч      нтзнмд-А(М7)   , ПРОВЕРИТЬ БИТ 39
        и       E39
        по      зан            , ЕСЛИ 0 – К ЗАН
        мод     Р2-А(М7)
        сч      нтзнмд-А(М7)
        и       E39
        по      зн             , ЕСЛИ 0 – К ЗН
смди    сч      E32(М4)        , ЗАГРУЗИТЬ МАСКУ УСТРОЙСТВА
        уиа     '2003'
        или     КОПЗ-3(М11)    , УСТАНОВИТЬ ЗАПРЕТ ДЛЯ ПРИЁМНИКА
        зп      КОПЗ-3(М11)
МОЖ     сч      E32(М10)       , ЗАГРУЗИТЬ МАСКУ ИСТОЧНИКА
        или     КОПЗ-3(М3)     , УСТАНОВИТЬ ЗАПРЕТ ДЛЯ ИСТОЧНИКА
        зп      КОПЗ-3(М3)
        пб      СИД            , ПЕРЕЙТИ К СИД

сво     мод     Р3-А(М7)
        сч      нтзнмд-А(М7)   , ПРОВЕРИТЬ БИТ 37 ЕЩЁ РАЗ
        и       E37
        по      смди           , ЕСЛИ 0 – К СМДИ
св1     уиа     (М1)           , СБРОСИТЬ М1
        пб      смд            , ПЕРЕЙТИ К СМД

зн      мода    зн1            , АДРЕС ЗН1
        пино    0(М1)          , ЕСЛИ М1≠0 – ПЕРЕЙТИ К ЗН1
        сч      E32(М4)        , ЗАГРУЗИТЬ МАСКУ ПРИЁМНИКА
        или     КОПЗ-3(М11)    , УСТАНОВИТЬ ЗАПРЕТ ДЛЯ ПРИЁМНИКА
        зп      КОПЗ-3(М11)
зн1     сч      E32(М10)       , ЗАГРУЗИТЬ МАСКУ ИСТОЧНИКА
        или     ОСУ+1(М3)      , ОТМЕТИТЬ В ОСУ ИСТОЧНИКА
        зп      ОСУ+1(М3)
        сч      ШЗМД+1(М11)    , ЗАГРУЗИТЬ ШКАЛУ ЗАХВАТОВ ПРИЁМНИКА
        или     ЕNQМДС+1(М11)  , И ENQ
        и       E32(М4)        , ПРОВЕРИТЬ БИТ ПРИЁМНИКА
        по      зн10           , ЕСЛИ 0 – К ЗН10
        и       ОСУ+1(М11)     , ПРОВЕРИТЬ ОСУ ПРИЁМНИКА
        пе      зн10
        сч      E32(М4)        , ОТМЕТИТЬ ПРИЁМНИК В ОСУ
        или     ОСУ-1(М11)
        зп      ОСУ-1(М11)
зн10    сч      ОСУ-1(М11)     , ПРОВЕРИТЬ ОСУ-1
        и       E32(М4)
        по      МОЖ            , ЕСЛИ СВОБОДНО – К МОЖ
        сч      ВСЕЕД          , СБРОСИТЬ ОЧЕРЕДЬ УСТРОЙСТВА
        мод     Р2-А(М7)
        нтж     ШОЧМД
        зп      R
        и       ШОЧНМД+1(М11)
        зп      ШОЧНМД+1(М11)
        пб      МОЖ

зан     мод     Р2-А(М7)
        сч      нтзнмд-А(М7)   , ЗАГРУЗИТЬ БИТ 39 ДЛЯ ПРИЁМНИКА
        и       E39
        по      зн11           , ЕСЛИ 0 – К ЗН11
        мода    зан1
        пино    0(М1)          , ЕСЛИ М1≠0 – К ЗАН1
        сч      E32(М10)       , ЗАГРУЗИТЬ МАСКУ ИСТОЧНИКА
        или     КОПЗ-3(М3)     , УСТАНОВИТЬ ЗАПРЕТ ДЛЯ ИСТОЧНИКА
        зп      КОПЗ-3(М3)
зан1    сч      E32(М4)        , ЗАГРУЗИТЬ МАСКУ ПРИЁМНИКА
        или     ОСУ+1(М11)     , ОТМЕТИТЬ В ОСУ ПРИЁМНИКА
        зп      ОСУ+1(М11)
        сч      ШЗМД+1(М3)     , ЗАГРУЗИТЬ ШКАЛУ ЗАХВАТОВ ИСТОЧНИКА
        или     ЕNQМДС+1(М3)
        и       E32(М10)
        по      зн2
        и       ОСУ+1(М3)

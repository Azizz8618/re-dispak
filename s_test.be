*   Выход: ПРКА(М13), ОШПАР, ПИЩИ(М13), ЗНОВ ТАКОГО ЕЩЕ НЕ БЫЛО, СБРОС(М13) ОБНУЛЯЮТ УЖЕ ИМЕЮЩИЙСЯ, РОСП(М13) УНИЧТОЖИМ ДЛЯ ЕДИНООБРАЗИЯ *
***************************************************
 ПВ ПРКА(М13)                           ,вызов через М13
 НТЖ Е40П1                              ,СМ ^= Е40П1
 ПЕ ОШПАР                               ,если СМ≠0 → ОШПАР
 СЧ ТЕКОПЕ                              ,СМ := ТЕКОПЕ
 ПВ ПИЩИ(М13)                           ,вызов через М13
 ПО ЗНОВ    ТАКОГО ЕЩЕ НЕ БЫЛО          ,если СМ=0 → ЗНОВ    ТАКОГО 
 ПВ СБРОС(М13)    ОБНУЛЯЮТ УЖЕ ИМЕЮЩИЙСЯ  ,вызов через М13
 ПВ РОСП(М13)    УНИЧТОЖИМ ДЛЯ ЕДИНООБРАЗИЯ  ,вызов через М13
ЗНОВ НОП                                ,НОП

***************************************************
* ЗНОВ                                            *
*   Регистры: М14, М16                            *
*   Вход: ЗНОВ                                    *
*   Выход: ПЕРСВО(М14) НАЧАЛО В ПЕРВОЙ СВОБОДНОЙ, НМЕСТ ВСЕ ЗОНЫ ЗАНЯТЫ, ГЫН *
***************************************************
 ПВ ПЕРСВО(М14)  НАЧАЛО В ПЕРВОЙ СВОБОДНОЙ  ,вызов через М14
 ВЧ КПОЛЕ1                              ,СМ -= КПОЛЕ1
 ПО НМЕСТ    ВСЕ ЗОНЫ ЗАНЯТЫ            ,если СМ=0 → НМЕСТ    ВСЕ ЗО
 СЧ ТЕКОПЕ                              ,СМ := ТЕКОПЕ
 СДА 64-32                              ,сдвиг СМ влево на 32
 ИЛИ Е2                                 ,СМ |= Е2
 ЗП (М16)    ЗДЕСЬ АДРЕС,УСТАНОВЛЕННЫЙ 'ПЕРСВО'  ,запись (Мx) [косвенно]
 СЧ Е48П41                              ,СМ := Е48П41
 ЗП 1(М16)                              ,1 := СМ
 СЧ                                     ,СМ := стекло (стек -> SM)
 ЗП 2(М16)     ДАЛЬШЕ СВОБОДНО          ,2 := СМ
 ПБ ГЫН                                 ,переход на ГЫН
*
*
*
* Д И Р Е К Т И В А   = Н А Й =
*-------------------------------
*
* НА[Й] <ОБРАЗ> (ОБРАЗ НЕ БОЛЕЕ 6-ТИ СИМВОЛОВ).*
SZUКАJ NОР                              ,NОР

***************************************************
* SZUКАJ                                          *
*   Регистры: М2, М10                             *
*   Вход: SZLООР, СЧМР                            *
*   Выход: НЕТМРБ NО ОВJЕСТ, ГОТОВО, ГОТОВ1 ВЫБРАНЫ ПЕРВЫЕ 6 СИМВОЛОВ ОПЕРАНДА *
***************************************************
 СЧ ЯЧРЕЖ                               ,СМ := ЯЧРЕЖ
 И Е2                                   ,СМ &= Е2
 ПО НЕТМРБ    NО ОВJЕСТ                 ,если СМ=0 → НЕТМРБ    NО ОВ
 УИА (М10)   СЧЕТЧИК СИМВОЛОВ ОБРАЗА    ,М10 := 0
 УИА -5(М2)   ЦИКЛ НА 6 СИМВОЛОВ        ,М2 := -5
 СЧ ТЕКОПЕ    ОПЕРАНД ДИРЕКТИВЫ         ,СМ := ТЕКОПЕ    ОПЕРАНД ДИ
SZLООР СДА 64-8                         ,сдвиг СМ влево на 8
 ЗП ТЕКОПЕ                              ,ТЕКОПЕ := СМ
 СЧМР 0       СИМВОЛ                    ,СМ := РМР (результат мантиссы)
 НТЖ П377                               ,СМ ^= П377
 ПО ГОТОВО                              ,если СМ=0 → ГОТОВО
 НТЖ П377                               ,СМ ^= П377
 ИЛИ ТЕКОПЕ                             ,СМ |= ТЕКОПЕ
 СЛИА 1(М10)                            ,М10 += 1
 ЦИКЛ SZLООР(М2)                        ,М2-- и если ≠0 → повтор
 ПБ ГОТОВ1  ВЫБРАНЫ ПЕРВЫЕ 6 СИМВОЛОВ ОПЕРАНДА  ,переход на ГОТОВ1  ВЫБРАНЫ ПЕРВ
ГОТОВО СЧ ТЕКОПЕ                        ,СМ := ТЕКОПЕ

***************************************************
* ГОТОВО                                          *
*   Регистры: М2, М3, М4, М5, М10, М17            *
*   Вход: ГОТОВ1, SLООР1                          *
*   Выход: ОШПАР(М10) НЕТ ОБРАЗА - НЕЧЕГО ИСКАТЬ  *
***************************************************
 СДА 64+8     <ЕТХ> НЕ ПИШЕМ            ,сдвиг СМ вправо на 8   
ГОТОВ1 ЗП ТЕКОПЕ  ОБРАЗ ГОТОВ           ,ТЕКОПЕ  ОБРАЗ ГОТОВ := СМ
 ПИО ОШПАР(М10) НЕТ ОБРАЗА - НЕЧЕГО ИСКАТЬ  ,если ИР=0 → ОШПАР(М10) НЕТ 
 СЧИ М10                                ,СМ := М10
 НТЖ ВСЕЕД                              ,СМ ^= ВСЕЕД
 УИ М10                                 ,М10 := СМ
 СЛИА 2(М10)                            ,М10 += 2
* <М10> := - <М10> + 1 (ДЛЯ ВЫБОРА ОБРЕЗАЮЩЕЙ МАСКИ)
 СЧ ТЕКОПЕ                              ,СМ := ТЕКОПЕ
 И Е8П1(М10)    ОБРЕЗАЛИ В ЗАВИСИМОСТИ ОТ ЧИСЛА СИМВ.  ,СМ &= Е8П1(М10)    ОБРЕЗАЛ
 ЗП ТЕКОПЕ                              ,ТЕКОПЕ := СМ
* УСТАНОВКИ ДЛЯ ПОИСКА
 УИА (М5)      СЧЕТЧИК СТРОК            ,М5 := 0
 УИА РБПОЛЕ(М1)  ДЛЯ 'ВС'. ЗДЕСЬ - ИССЛЕДУЕМЫЙ ПАСПОРТ  ,М1 := РБПОЛЕ
 УИА -5(М2)      ДЛЯ НЕГО ЖЕ            ,М2 := -5
 СЧ ТПРОБ                               ,СМ := ТПРОБ
 ЗП ВЫБСК                               ,ВЫБСК := СМ
 ЗП ВЫБСК+1       DЕLЕТЕ ВLАNСS         ,ВЫБСК+1       DЕLЕТЕ := СМ
 СЧ П376                                ,СМ := П376
 ЗП РЯВСК         ЕND-МАRКING СНАRАСТЕR  ,РЯВСК         ЕND-МА := СМ
 СЧ П777                                ,СМ := П777
 ЗП РЯГВСК        ОRD(СНАRАСТЕR) < '777'  ,РЯГВСК        ОRD := СМ
 УИА КНСКАН(М17) ТНЕ ЕND ОF SСАNNING,WНЕN СНАR('376') ОССURS  ,М17 := КНСКАН
 УИА '71000'(М3) WRIТЕ НЕRЕ NUМВЕRS ОF LINЕS ТО DISРLАУ  ,М3 := '71000'
 УИА -5(М4)      ДЛЯ 'ЗС'               ,М4 := -5
 СЧ 0                                   ,СМ := 0
 ЗП РАЯ12         ПЛЫВУЩИЙ ОБРАЗ        ,РАЯ12         ПЛЫВУЩ := СМ
 ЗП РЯЧЗС         NUМВЕR ОF ТНЕ РRЕVIОUS LINЕ  ,РЯЧЗС         NUМВЕR := СМ
SLООР1 НОП       SЕАRСН - СУСLЕ         ,НОП SЕАRСН - СУСLЕ

***************************************************
* SLООР1                                          *
*   Регистры: М10, М13                            *
*   Вход: SLООР1                                  *
*   Выход: ВСК(М13) ЗА ОЧЕРЕДНЫМ СИМВОЛОМ, СТРОКА КОНЧИЛАСЬ, ОБРЕСТ НАШЛИ, SLООР1 GО ОN *
***************************************************
 СЧ РАЯ12                               ,СМ := РАЯ12
 СДА 64-8                               ,сдвиг СМ влево на 8
 ЗП РАЯ12                               ,РАЯ12 := СМ
 ПВ ВСК(М13)      ЗА ОЧЕРЕДНЫМ СИМВОЛОМ  ,вызов через М13
 НТЖ П377                               ,СМ ^= П377
 ПО СТРОКА        КОНЧИЛАСЬ             ,если СМ=0 → СТРОКА        К
 НТЖ П377                               ,СМ ^= П377
 ИЛИ РАЯ12                              ,СМ |= РАЯ12
 И Е8П1(М10)       РЕЖЬ ПЛЫВУЩЕГО ПО МАСКЕ  ,СМ &= Е8П1(М10)       РЕЖЬ
 ЗП РАЯ12                               ,РАЯ12 := СМ
 НТЖ ТЕКОПЕ                             ,СМ ^= ТЕКОПЕ
 ПО ОБРЕСТ        НАШЛИ                 ,если СМ=0 → ОБРЕСТ        Н
 ПБ SLООР1        GО ОN                 ,переход на SLООР1        GО ОN
* ТНЕ ЕND ОF ТНЕ LINЕ
СТРОКА НОП                              ,НОП

***************************************************
* СТРОКА                                          *
*   Регистры: М5                                  *
*   Вход: СТРОКА                                  *
*   Выход: SLООР1 GО ОN                           *
***************************************************
 СЛИА 1(М5)                             ,М5 += 1
 СЧ                                     ,СМ := стекло (стек -> SM)
 ЗП РАЯ12                               ,РАЯ12 := СМ
 ПБ SLООР1        GО ОN                 ,переход на SLООР1        GО ОN
* ОБРАЗЕЦ ОБНАРУЖЕН
ОБРЕСТ НОП                              ,НОП

***************************************************
* ОБРЕСТ                                          *
*   Регистры: М5, М13                             *
*   Вход: ОБРЕСТ                                  *
*   Выход: SLООР1 NОТ ТНЕ FIRSТ IN ТНIS LINЕ, ЗСС(М13) SТОRЕ ТНЕ NUМВЕR ОF ТНЕ LINЕ, SLООР1 GО ОN *
***************************************************
 СЧИ М5                                 ,СМ := М5
 НТЖ РЯЧЗС                              ,СМ ^= РЯЧЗС
 ПО SLООР1        NОТ ТНЕ FIRSТ IN ТНIS LINЕ  ,если СМ=0 → SLООР1        N
 НТЖ РЯЧЗС                              ,СМ ^= РЯЧЗС
 ПВ ЗСС(М13)      SТОRЕ ТНЕ NUМВЕR ОF ТНЕ LINЕ  ,вызов через М13
 ПБ SLООР1        GО ОN                 ,переход на SLООР1        GО ОN
* SТОР SСАNNING, ТНАТ'S IТ
КНСКАН НОП                              ,НОП

***************************************************
* КНСКАН                                          *
*   Регистры: М2, М13                             *
*   Вход: ВЫДНАЙ                                  *
*   Выход: ЗСС(М13) ЕND-МАRК                      *
***************************************************
 СЧ П377                                ,СМ := П377
 ПВ ЗСС(М13)      ЕND-МАRК              ,вызов через М13
 УИА '71000'(М1)                        ,М1 := '71000'
 УИА -5(М2)                             ,М2 := -5
 СЧИ М1                                 ,СМ := М1
 ЗП ВЫБСК                               ,ВЫБСК := СМ
 СЧИ М2                                 ,СМ := М2
 ЗП РАЯ33                               ,РАЯ33 := СМ
ВЫДНАЙ НОП                              ,НОП

***************************************************
* ВЫДНАЙ                                          *
*   Регистры: М2, М13, М16                        *
*   Вход: ВЫДНАЙ                                  *
*   Выход: ВС(М13), ОСЦИКЛ МУ WОRК IS DОNЕ, ЕСПАВЫ DISРLАУ АND RЕТURN *
***************************************************
 МОД ВЫБСК                              ,мод.адрес по коду: ВЫБСК
 УИА (М1)                               ,М1 := 0
 МОД РАЯ33                              ,мод.адрес по коду: РАЯ33
 УИА (М2)                               ,М2 := 0
 ПВ ВС(М13)                             ,вызов через М13
 НТЖ П377                               ,СМ ^= П377
 ПО ОСЦИКЛ        МУ WОRК IS DОNЕ       ,если СМ=0 → ОСЦИКЛ        М
 НТЖ П377                               ,СМ ^= П377
 ЗП РЯЧВЫ1                              ,РЯЧВЫ1 := СМ
 ЗП РЯЧВЫ2                              ,РЯЧВЫ2 := СМ
 УИА ВЫДНАЙ(М16)                        ,М16 := ВЫДНАЙ
 СЧИ М16                                ,СМ := М16
 ЗП ВЫХВЫД       ТО RЕТURN              ,ВЫХВЫД       ТО RЕТU := СМ
 СЧИ М1                                 ,СМ := М1
 ЗП ВЫБСК                               ,ВЫБСК := СМ
 СЧИ М2                                 ,СМ := М2
 ЗП РАЯ33                               ,РАЯ33 := СМ
 ПБ ЕСПАВЫ       DISРLАУ АND RЕТURN     ,переход на ЕСПАВЫ       DISРLАУ
*
*
*
* Д И Р Е К Т И В А   = Ф О Р =
*------------------------------
*
* Ф[ОР]  (БЕЗ ПАРАМЕТРОВ)
*    ПОРТЯТСЯ ВТОРОЙ И ТРЕТИЙ УРОВЕНЬ
*
ФОР NОР                                 ,NОР

***************************************************
* ФОР                                             *
*   Регистры: -                                   *
*   Вход: ФОР                                     *
*   Выход: ФУ3, ДАЙ                               *
***************************************************
 СЧ ТЕКОПЕ                              ,СМ := ТЕКОПЕ
 НТЖ Е48П41                             ,СМ ^= Е48П41
 ПО ФУ3                                 ,если СМ=0 → ФУ3
 СЧ ЯЧРЕЖ                               ,СМ := ЯЧРЕЖ
 ИЛИ Е8                                 ,СМ |= Е8
 ЗП ЯЧРЕЖ                               ,ЯЧРЕЖ := СМ
 ПБ ДАЙ                                 ,переход на ДАЙ
ФУ3 СЧ ТЕКПАС                           ,СМ := ТЕКПАС

***************************************************
* ФУ3                                             *
*   Регистры: М2, М3, М4, М12, М15, М17           *
*   Вход: ХТА, АОХ, АТХ, ААХ, UZА, VТМ, МТJ, VJМ  *
*   Выход: ЗАПЛАТ(М15), ЧТПАСП                    *
***************************************************
 СДА 64-32                              ,сдвиг СМ влево на 32
 ИЛИ Е48П41+2                           ,СМ |= Е48П41+2
 ЗП '70000'+65                          ,'70000'+65 := СМ
 ХТА ЯЧРЕЖ                              ,ЯЧРЕЖ
 АОХ Е7                                 ,Е7
 АТХ ЯЧРЕЖ                              ,ЯЧРЕЖ
 ААХ Е2                                 ,Е2
 UZА НЕТМРБ                             ,НЕТМРБ
 VТМ РБПОЛЕ(М1)                         ,РБПОЛЕ(М1)
 СЧ РБПОЛЕ                              ,СМ := РБПОЛЕ
 ЗП ХРСТР                               ,ХРСТР := СМ
 ХТА ПРНАД                              ,ПРНАД
 АТХ (М1)                               ,(М1)
 VТМ ПОЛЕФ+1(М3)                        ,ПОЛЕФ+1(М3)
 VТМ -5(М2)                             ,-5(М2)
 МТJ М4(М2)                             ,М4(М2)
 ХТА П376                               ,П376
 АТХ РЯВСК                              ,РЯВСК
 ХТА П377                               ,П377
 АТХ ВЫБСК                              ,ВЫБСК
 АТХ ВЫБСК+1                            ,ВЫБСК+1
 ХТА Е16П1                              ,Е16П1
 АТХ РЯГВСК                             ,РЯГВСК
 VJМ ПАКП(М15)                          ,ПАКП(М15)
 МТJ М17(М3)                            ,М17(М3)
 ПВ ЗАПЛАТ(М15)                         ,вызов через М15
 VZМ НСЛ(М4)                            ,НСЛ(М4)
 UТМ 1(М17)                             ,1(М17)
НСЛ VТМ 1(М12)                          ,VТМ 1(М12)
 VJМ ФОРМ(М15)                          ,ФОРМ(М15)
 ХТА ХРСТР                              ,ХРСТР
 АТХ РБПОЛЕ                             ,РБПОЛЕ
 UJ ЧТПАСП                              ,переход на ЧТПАСП

***************************************************
* БОБ                                             *
*   Регистры: М2, М3, М13, М14, М15, М16          *
*   Вход: БЕЗДЕЛ, ДЕЛТАП                          *
*   Выход: СЧИТ(М13), ПРОГОН(М14), БЕЗДЕЛ, ВВЧИС(М14), ЗАХВАТ(М13), ЧТПАСП *
***************************************************
 УИА 40(М2)                             ,М2 := 40
 УИА БФВВ(М3)                           ,М3 := БФВВ
 УИА ПОВБОБ(М15)                        ,М15 := ПОВБОБ
 ПВ СЧИТ(М13)                           ,вызов через М13
 ЗП РАЯ1                                ,РАЯ1 := СМ
 УИА 1(М16)                             ,М16 := 1
 ПВ ПРОГОН(М14)                         ,вызов через М14
 ПО БЕЗДЕЛ                              ,если СМ=0 → БЕЗДЕЛ
 ПВ ВВЧИС(М14)                          ,вызов через М14
БЕЗДЕЛ ИЛИ ИСЧТ55                       ,СМ |= ИСЧТ55
 ВЧ П3                                  ,СМ -= П3
 ЗП ПРИЗОС                              ,ПРИЗОС := СМ
 СЧ РАЯ1                                ,СМ := РАЯ1
 ПВ ЗАХВАТ(М13)                         ,вызов через М13
 СЧ ПРИЗОС                              ,СМ := ПРИЗОС
 Э50 '112'                              ,'112'
ДЕЛТАП ПБ ЧТПАСП                        ,переход на ЧТПАСП
 Э55 '543'                              ,'543'

***************************************************
 МОДА (М15)                             ,мод.адрес +1: (М15)
 СЧ (М1)                                ,СМ := (М1) [косвенно]
 МОДА РБПОЛЕ(М2)                        ,мод.адрес +1: РБПОЛЕ(М2)
 ЗП (М1)    <ПОЛЕ1> =-> РБПОЛЕ          ,запись (Мx) [косвенно]
 ЦИКЛ ПЕРПИС(М1)                        ,М1-- и если ≠0 → повтор
 СЧ РБПОЛЕ                              ,СМ := РБПОЛЕ
 И Е48П33                               ,СМ &= Е48П33
 ЗП РБПОЛЕ                              ,РБПОЛЕ := СМ
 СЧ ВСЕПРО                              ,СМ := ВСЕПРО
 СДА 64+16                              ,сдвиг СМ вправо на 16
 ИЛИ РБПОЛЕ                             ,СМ |= РБПОЛЕ
 ЗП РБПОЛЕ                              ,РБПОЛЕ := СМ
 УИА ВЫДСВО(М14)        ВОЗВРАТ ПРИ <DЕL>  ,М14 := ВЫДСВО
 УИА РБПОЛЕ(М1)                         ,М1 := РБПОЛЕ
 УИА ЦИКВСЕ(М13)        НОРМАЛЬНЫЙ ВОЗВРАТ  ,М13 := ЦИКВСЕ

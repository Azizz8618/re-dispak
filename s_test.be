ДАЙНОМ НОП           ВЫБОР N СТР.       ,НОП ВЫБОР N СТР.

***************************************************
* ДАЙНОМ                                          *
*   Регистры: М2, М13                             *
*   Вход: ЦИКНОМ                                  *
*   Выход: ВС(М13), КОННОМ НОМЕР КОНЧИЛСЯ, ЦИКНОМ ПРОДОЛЖИМ ВЫБОР *
***************************************************
 МОД РАЯ12                              ,мод.адрес по коду: РАЯ12
 УИА (М1)                               ,М1 := 0
 МОД РАЯ13                              ,мод.адрес по коду: РАЯ13
 УИА (М2)            RЕSЕТ RЕGISТЕRS    ,М2 := 0
 СЧ                                     ,СМ := стекло (стек -> SM)
ЦИКНОМ ЗП РАЯ41                         ,РАЯ41 := СМ
 ПВ ВС(М13)                             ,вызов через М13
 ЗП РЯЗС                                ,РЯЗС := СМ
 ВЧ П12                                 ,СМ -= П12
 ПО КОННОМ           НОМЕР КОНЧИЛСЯ     ,если СМ=0 → КОННОМ         
*
 СЧ РАЯ41                               ,СМ := РАЯ41
 СДА 64-4                               ,сдвиг СМ влево на 4
 ИЛИ РЯЗС                               ,СМ |= РЯЗС
 ПБ ЦИКНОМ           ПРОДОЛЖИМ ВЫБОР    ,переход на ЦИКНОМ           ПРО
КОННОМ НОП                              ,НОП

***************************************************
* КОННОМ                                          *
*   Регистры: М2, М15                             *
*   Вход: КОННОМ                                  *
*   Выход: ВЫХРЕД, ВЫХОШ ПОСЛЕ N НЕ ПРОБЕЛ-ОШИБКА, ВЫХОШ N=0 - ОШИБКА, ПХ108(М15), ВЫХОШ N > ДЛИНЫ ПАСПОРТА - ОШИБКА, ОТМ2 *
***************************************************
 СЧ РЯЗС                                ,СМ := РЯЗС
 НТЖ П377                               ,СМ ^= П377
 ПО ВЫХРЕД                              ,если СМ=0 → ВЫХРЕД
 НТЖ П377                               ,СМ ^= П377
 НТЖ ТПРОБ                              ,СМ ^= ТПРОБ
 ПЕ ВЫХОШ            ПОСЛЕ N НЕ ПРОБЕЛ-ОШИБКА  ,если СМ≠0 → ВЫХОШ          
 СЧИ М1                                 ,СМ := М1
 ЗП РАЯ12                               ,РАЯ12 := СМ
 СЧИ М2                                 ,СМ := М2
 ЗП РАЯ13                               ,РАЯ13 := СМ
 СЧ РАЯ41                               ,СМ := РАЯ41
 ПО ВЫХОШ            N=0 - ОШИБКА       ,если СМ=0 → ВЫХОШ          
 ПВ ПХ108(М15)                          ,вызов через М15
 ЗП РАЯ41                               ,РАЯ41 := СМ
 ЗП РАЯ42            ПАРАМЕТРЫ ДЛЯ 'ОТМ'  ,РАЯ42            ПАР := СМ
 ВЧОБ ДСТРОК                            ,СМ := (адрес) - СМ
 ПЕ ВЫХОШ            N > ДЛИНЫ ПАСПОРТА - ОШИБКА  ,если СМ≠0 → ВЫХОШ          
 СЧ ЯЧРЕЖ                               ,СМ := ЯЧРЕЖ
 ИЛИ Е4                                 ,СМ |= Е4
 ЗП ЯЧРЕЖ            РАБОТАЕТ 'ЗАМ'     ,ЯЧРЕЖ            РАБ := СМ
 ПБ ОТМ2                                ,переход на ОТМ2
ПРИРЕД НОП                              ,НОП


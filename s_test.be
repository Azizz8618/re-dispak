 РЗБ ВСЕПРО                             ,разборка бит: ВСЕПРО
 ЗП БФВВ+5                              ,БФВВ+5 := СМ
 СЧ 1(М17)                              ,СМ := 1
 СДА 64-24                              ,сдвиг СМ влево на 24
 РЗБ ВСЕПРО           РАЗОБРАЛИ И       ,разборка бит: ВСЕПРО         
 ЗП БФВВ+6            ПРИФОРМИРОВАЛИ    ,БФВВ+6            ПР := СМ
 СЧ Е48П41                              ,СМ := Е48П41
 ЗП БФВВ+7                              ,БФВВ+7 := СМ
 ПБ (М14)             ВСЕ СДЕЛАНО. В БФВВ-СТРОКА  ,переход через М14
* МАСКА СТРОКИ БЛОКА  ' Ф О Р О Г Л  '
МАССТР НОП                              ,НОП


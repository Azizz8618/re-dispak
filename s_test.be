 ЗП РАЯ23                               ,РАЯ23 := СМ
 УИА ДОПИС2(М15)                        ,М15 := ДОПИС2
 СЧ ТПРВВД                              ,СМ := ТПРВВД
 ЗП БФВВ                                ,БФВВ := СМ
 ПВ ПРИЕМ(М14)                          ,вызов через М14
 МОД РАЯ22     ИХ ЗАГАДИЛ, А МЫ         ,мод.адрес по коду: РАЯ22     ИХ
 УИА (М3)      ИХ ОБРАТНО               ,М3 := 0
 МОД РАЯ23     ВОССТАНОВИМ              ,мод.адрес по коду: РАЯ23     ВО
 УИА (М4)                               ,М4 := 0
*КОНЕЦ ПРИМЕМ
 УИА БФВВ(М1)                           ,М1 := БФВВ
 УИА -5(М2)                             ,М2 := -5
ДОПИС1 ПВ ВС(М13)                       ,вызов через М13
 ЗП РЯЗС                                ,РЯЗС := СМ
 НТЖ СОПКОД                             ,СМ ^= СОПКОД
 ПЕ ДОПИС3                              ,если СМ≠0 → ДОПИС3
 ПВ КОДУПП(М14)                         ,вызов через М14

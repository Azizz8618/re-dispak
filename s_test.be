*                МАССИВ В 'РБПОЛЕ'
* ВЫХОДНЫЕ ДАННЫЕ:
*                ДСЛОВ - ДЛИНА В СЛОВАХ
*                ДСТРОК - ДЛИНА В СТРОКАХ
* РАБОЧИЕ:
*         РАЯ41,М1,М2,М17
* ВОЗВРАТ ПО М16
 СЧИ                                    ,СМ := ИР
 ЗП ДСТРОК                              ,ДСТРОК := СМ
 УИА -5(М2)     ДЛЯ ВС                  ,М2 := -5
 УИА РБПОЛЕ(М1)                         ,М1 := РБПОЛЕ
ВЫЧДЛ1 ПВ ВС(М13)                       ,вызов через М13
 НТЖ П376                               ,СМ ^= П376
 ПО ВЫЧДЛ2     НАШЛИ КОНЕЦ ТЕКСТА       ,если СМ=0 → ВЫЧДЛ2     НАШЛ
 НТЖ П376                               ,СМ ^= П376
 НТЖ П377                               ,СМ ^= П377
 ПЕ ВЫЧДЛ1                              ,если СМ≠0 → ВЫЧДЛ1
*!  ЭТО СОПЛЯ ДЛЯ ПУСТЫХ СТРОК!!!
 СЧ (М1)                                ,СМ := (М1) [косвенно]
 СБР П377(М2)   МОДЕЛИРУЕМ 'ВС'         ,сборка бит: П377(М2)   МОДЕ
 НТЖ Е48П41                             ,СМ ^= Е48П41
 УИА ВЫЧДЛ1(М13)   ДЛЯ ВОЗВРАТУ         ,М13 := ВЫЧДЛ1
 ПО ВС                                  ,если СМ=0 → ВС
*! А ЭТО КОНЕЦ СОПЛИ ДЛЯ ПУСТЫХ СТРОК!!!
 СЧ ДСТРОК                              ,СМ := ДСТРОК
 СЛЦ Е1                                 ,СМ += Е1 [цикли.]
 ЗП ДСТРОК                              ,ДСТРОК := СМ
 ПБ ВЫЧДЛ1                              ,переход на ВЫЧДЛ1
ВЫЧДЛ2 СЛИА -РБПОЛЕ+1(М1)               ,М1 = -РБПОЛЕ+1

***************************************************
* ВЫЧДЛ2                                          *
*   Регистры: М16                                 *
*   Вход: ВЫЧДЛ2                                  *
*   Выход: (М16)                                  *
***************************************************
 СЧИ М1                                 ,СМ := М1
 ЗП ДСЛОВ                               ,ДСЛОВ := СМ
 ПБ (М16)                               ,переход через М16
*
*
РАЗДИР НОП                              ,НОП
* БЛОК РАЗБОРА ДИРЕКТИВЫ
* М1-АДРЕС НАЧАЛА БУФЕРА ПРИЕМА
* ТЕКДИР-ПЕРВЫЕ ТРИ СИМВОЛА ДИРЕКТИВЫ
* ТЕКОПЕ-ОПЕРАНД
* М2,М3,М4,М5-РАБОЧИЕ (ДЛЯ ВС И ЗС)
* М6-СДВИГ
* ВОЗВРАТ ПО М15
 СЧ                                     ,СМ := стекло (стек -> SM)
 ЗП ТЕКДИР                              ,ТЕКДИР := СМ
 ЗП РЯЧЗС                               ,РЯЧЗС := СМ
 СЧ Е48П41                              ,СМ := Е48П41
 ЗП ТЕКОПЕ                              ,ТЕКОПЕ := СМ
 УИА -5(М2)                             ,М2 := -5
НЕЗПРО НОП                              ,НОП

***************************************************
* НЕЗПРО                                          *
*   Регистры: М5, М6, М13, М15                    *
*   Вход: ЗАПДИР                                  *
*   Выход: ВС(М13), НЕЗПРО, (М15)                 *
***************************************************
 ПВ ВС(М13)                             ,вызов через М13
 ЗП РЯЗС                                ,РЯЗС := СМ
 НТЖ ТПРОБ                              ,СМ ^= ТПРОБ
 ПО НЕЗПРО                              ,если СМ=0 → НЕЗПРО
 СЧ РЯЗС                                ,СМ := РЯЗС
 НТЖ П377                               ,СМ ^= П377
 ПО (М15)                               ,если СМ=0 → (М15)
 УИА 2(М5)                              ,М5 := 2
 УИА 24(М6)                             ,М6 := 24
ЗАПДИР НОП                              ,НОП

***************************************************
* ЗАПДИР                                          *
*   Регистры: М6                                  *
*   Вход: ИЩИРАЗ                                  *
***************************************************
 СЧ ТЕКДИР                              ,СМ := ТЕКДИР
 СДА 64-8                               ,сдвиг СМ влево на 8
 ИЛИ РЯЗС                               ,СМ |= РЯЗС
 ЗП ТЕКДИР                              ,ТЕКДИР := СМ
 СЛИА -8(М6)                            ,М6 = -8
ИЩИРАЗ НОП                              ,НОП

***************************************************
* ИЩИРАЗ                                          *
*   Регистры: М5, М13, М15                        *
*   Вход: ИЩИРАЗ                                  *
*   Выход: ВС(М13), УЖЕОПЕ, (М15), ИЩИРАЗ(М5), ЗАПДИР *
***************************************************
 ПВ ВС(М13)                             ,вызов через М13
 ЗП РЯЗС                                ,РЯЗС := СМ
 НТЖ ТПРОБ                              ,СМ ^= ТПРОБ
 ПО УЖЕОПЕ                              ,если СМ=0 → УЖЕОПЕ
 СЧ РЯЗС                                ,СМ := РЯЗС
 НТЖ П377                               ,СМ ^= П377
 ПО (М15)                               ,если СМ=0 → (М15)
 ПИО ИЩИРАЗ(М5)                         ,если ИР=0 → ИЩИРАЗ(М5)
 СЛИА -1(М5)                            ,М5 = -1
 ПБ ЗАПДИР                              ,переход на ЗАПДИР
УЖЕОПЕ НОП                              ,НОП
*------*
 УИА -5(М4)                             ,М4 := -5
 УИА ТЕКОПЕ(М3)                         ,М3 := ТЕКОПЕ
 УИА -8(М5)                             ,М5 := -8
 УИА ПДОЕТХ(М14)                        ,М14 := ПДОЕТХ
ПДОЕТХ НОП                              ,НОП

***************************************************
* ПДОЕТХ                                          *
*   Регистры: М5, М13, М15                        *
*   Вход: ПДОЕТХ                                  *
*   Выход: (М15), ЗСС                             *
***************************************************
 СЧ РЯЧЗС                               ,СМ := РЯЧЗС
 НТЖ П377                               ,СМ ^= П377
 ПО (М15)                               ,если СМ=0 → (М15)
 ЦИКЛ ПС(М5)                            ,М5-- и если ≠0 → повтор
 СЧ П377                                ,СМ := П377
 УИИ М13(М15)                           ,М13 := М15
 ПБ ЗСС                                 ,переход на ЗСС
*
*
*
*
* ЗАПИСЬ СИМВОЛА
* ВХОДНЫЕ ЗНАЧЕНИЯ:
*   ДЛЯ ЗСС-СИМВОЛ НА СУММАТОРЕ
*   ДЛЯ ЗС-В 1-8 РР РЯЗС
*   М3-АДРЕС БУФЕРА (КУДА ПИСАТЬ)
*   М4-НОМЕР БАЙТА-6
* ВОЗВРАТ ПО М13
ЗС НОП                                  ,НОП

***************************************************
* ЗС                                              *
*   Регистры: -                                   *
*   Вход: ЗСС                                     *
***************************************************
 СЧ РЯЗС                                ,СМ := РЯЗС
 ЗП РЯЧЗС                               ,РЯЧЗС := СМ
ЗСС НОП                                 ,НОП

***************************************************
* ЗСС                                             *
*   Регистры: М3, М4, М13                         *
*   Вход: РЗБ                                     *
*   Выход: АМЦХ, (М13)                            *
***************************************************
 ЗП РЯЧЗС                               ,РЯЧЗС := СМ
 СЧ (М3)                                ,СМ := (М3) [косвенно]
 ИЛИ П377(М4)                           ,СМ |= П377(М4)
 НТЖ П377(М4)                           ,СМ ^= П377(М4)
 ЗП (М3)                                ,запись (Мx) [косвенно]
 СЧ РЯЧЗС                               ,СМ := РЯЧЗС
 СДА 64-40                              ,сдвиг СМ влево на 40
 РЗБ П377(М4)                           ,разборка бит: П377(М4)
 ИЛИ (М3)                               ,СМ |= (М3)
 ЗП (М3)                                ,запись (Мx) [косвенно]
 МОДА (М13)                             ,мод.адрес +1: (М13)
 ЦИКЛ (М4)                              ,М4-- и если ≠0 → повтор
 СЛИА 1(М3)                             ,М3 += 1
 УИА -5(М4)                             ,М4 := -5
 СЧИ М3                                 ,СМ := М3
 НТЖ КПОЛЕ1                             ,СМ ^= КПОЛЕ1
 ПО АМЦХ                                ,если СМ=0 → АМЦХ
 ПБ (М13)                               ,переход через М13
*
*
*
* ВЫБОР СИМВОЛА
* ВХОДНЫЕ ЗНАЧЕНИЯ:
*   М1-АДРЕС НАЧАЛА БУФЕРА
*   М2-НОМЕР БАЙТА-6
* ВЫХОДНЫЕ ЗНАЧЕНИЯ:
* СМ-ВЫБРАННЫЙ СИМВОЛ
* ВОЗВРАТ ПО М13
ВС НОП                                  ,НОП

***************************************************
* ВС                                              *
*   Регистры: М2, М13                             *
*   Вход: СБР                                     *
*   Выход: (М13)                                  *
***************************************************
 СЧ (М1)                                ,СМ := (М1) [косвенно]
 СБР П377(М2)                           ,сборка бит: П377(М2)
 СДА 64+40                              ,сдвиг СМ вправо на 40
 МОДА (М13)                             ,мод.адрес +1: (М13)
 ЦИКЛ (М2)                              ,М2-- и если ≠0 → повтор
 СЛИА 1(М1)                             ,М1 += 1
 УИА -5(М2)                             ,М2 := -5
 ПБ (М13)                               ,переход через М13
*
*
*
ВСК НОП                                 ,НОП
* УСЛОЖНЕННЫЙ ВАРИАНТ 'ВС'
* С КОНТРОЛЕМ ВЫБИРАЕМОГО СИМВОЛА
*  ВХОДНЫЕ ЗНАЧЕНИЯ:
*   М1,М2 - КАК ДЛЯ 'ВС'
*   М17   - ВЫХОД ПРИ ВЫБОРКЕ ГРАНИЧНОГО СИМВОЛА
*   М6 - ВЫХОД ПРИ ВЫБОРКЕ КОНЕЧНОГО СИМВОЛА
*   РЯГВСК - КОНЕЧНЫЙ СИМВОЛ
*   ВЫБСК,ВЫБСК+1... - ПРОПУСКАЕМЫЕ СИМВОЛЫ
*   РЯВСК - ГРАНИЧНЫЙ СИМВОЛ
*  ВЫХОДНЫЕ ЗНАЧЕНИЯ:
*   АНАЛОГИЧНО 'ВС'
*  ИСПОЛЬЗУЮТСЯ РАЯ41,РАЯ42,РАЯ33
*  ВЫХОД ПО М13
*
 СЧИ М13                                ,СМ := М13
 ЗП РАЯ41    АДРЕС ВОЗВРАТА             ,РАЯ41    АДРЕС ВОЗВР := СМ
 СЧИ М16                                ,СМ := М16
 ЗП РАЯ42    НУЖНО ВОССТАНОВИТЬ         ,РАЯ42    НУЖНО ВОССТ := СМ
ВЫБРОС УИА -ДЛИВСК(М16)                 ,М16 := -ДЛИВСК
 ПВ ВС(М13)                             ,вызов через М13
 ЗП РАЯ33                               ,РАЯ33 := СМ
 НТЖ РЯВСК    ГРАНИЧНЫЙ СИМВОЛ          ,СМ ^= РЯВСК    ГРАНИЧНЫЙ
 ПО (М17)    ВЫХОД                      ,если СМ=0 → (М17)    ВЫХОД
 НТЖ РЯВСК                              ,СМ ^= РЯВСК
 ВЧ РЯГВСК                              ,СМ -= РЯГВСК
 ПО ВСГР                                ,если СМ=0 → ВСГР
СИПРО СЧ ВЫБСК+ДЛИВСК(М16)              ,СМ := ВЫБСК+ДЛИВСК
 НТЖ РАЯ33                              ,СМ ^= РАЯ33
 ПО ВЫБРОС                              ,если СМ=0 → ВЫБРОС
 ЦИКЛ СИПРО(М16)                        ,М16-- и если ≠0 → повтор
 МОД РАЯ42                              ,мод.адрес по коду: РАЯ42
 УИА (М16)                              ,М16 := 0
 СЧ РАЯ33                               ,СМ := РАЯ33
 МОД РАЯ41                              ,мод.адрес по коду: РАЯ41
 ПБ                                     ,переход
ВСГР НОП                                ,НОП

***************************************************
* ВСГР                                            *
*   Регистры: М6, М16                             *
*   Вход: ВСГР                                    *
*   Выход: (М6)                                   *
***************************************************
 МОД РАЯ42                              ,мод.адрес по коду: РАЯ42
 УИА (М16)                              ,М16 := 0
 СЧ РАЯ33                               ,СМ := РАЯ33
 ПБ (М6)                                ,переход через М6
*
*
*
ПАКП НОП                                ,НОП
* ПАКУЕТ ПАСПОРТ
*  ВХОДНЫЕ ЗНАЧЕНИЯ:
*   РЯВСК - СИМВОЛ КОНЦА ПАСПОРТА
*   ВЫБСК+1 - ВТОРОЙ ВЫБРАСЫВАЕМЫЙ СИМВОЛ
*   М1,М2,М3,М4 - НАСТРОЕНЫ ДЛЯ 'ВС' И 'ЗС'
*  ИСПОЛЬЗУЮТСЯ М16,М17
*  ВЫХОД ПО М15
*
 УИА ФПАКП(М17)    ПЕРЕХОД ПРИ КОНЦЕ ПАСПОРТА  ,М17 := ФПАКП
 ПВ ПСК(М14)    ПЕРЕПИСЬ С КОНТРОЛЕМ    ,вызов через М14
 НТЖ ТНАДЧ                              ,СМ ^= ТНАДЧ
 ПЕ ПАКП    ПРОГОН ДО НАДЧЕРКА          ,если СМ≠0 → ПАКП    ПРОГОН 
 ПВ ПСК(М14)   ПЕРЕПИСАЛИ ПЕРВЫЙ ПОСЛЕ НАДЧЕРКА  ,вызов через М14
 НТЖ ТЕ                                 ,СМ ^= ТЕ
 ПЕ ПАКП     ИЩЕМ 'Е' ПОСЛЕ НАДЧЕРКА    ,если СМ≠0 → ПАКП     ИЩЕМ '
 СЧ ТПРОБ                               ,СМ := ТПРОБ
 ЗП ВЫБСК    ТЕПЕРЬ НУЖНО ВЫБРАСЫВАТЬ ПРОБЕЛЫ  ,ВЫБСК    ТЕПЕРЬ НУЖН := СМ
ПАКП1 ПВ ПСК(М14)                       ,вызов через М14
 НТЖ ТА                                 ,СМ ^= ТА
 ПО ПАКПА    ВВОД ПО ПРИЗНАКУ 'А'       ,если СМ=0 → ПАКПА    ВВОД П
 НТЖ ТА                                 ,СМ ^= ТА
 НТЖ ТБ                                 ,СМ ^= ТБ
 ПЕ ПАКП1    НЕ 'А' И НЕ 'Б'            ,если СМ≠0 → ПАКП1    НЕ 'А'
 УИА -5(М16)   ШЕСТЬ СИМВОЛОВ С КОНТРОЛЕМ '377'  ,М16 := -5
ПАКБ ПВ ПС(М14)                         ,вызов через М14
 НТЖ РЯВСК                              ,СМ ^= РЯВСК
 ПО ФПАКП                               ,если СМ=0 → ФПАКП
 ЦИКЛ ПАКБ(М16)                         ,М16-- и если ≠0 → повтор
 ПБ ПАКП1                               ,переход на ПАКП1
ПАКПА НОП                               ,НОП

***************************************************
* ПАКПА                                           *
*   Регистры: М13, М14, М17                       *
*   Вход: ПАКПА                                   *
*   Выход: ПСК(М14), ПАКП1 ЭТО НЕ ЦИФРА < 6, ВВОДА(М14) ВВОД ПО 'А', ФПАКП ДОБРАЛИСЬ ДО КОНЦА МАССИВА, ЗС *
***************************************************
 ПВ ПСК(М14)                            ,вызов через М14
 ВЧ П6                                  ,СМ -= П6
 ПО ПАКП1    ЭТО НЕ ЦИФРА < 6           ,если СМ=0 → ПАКП1    ЭТО НЕ
 СЧ РЯЧЗС                               ,СМ := РЯЧЗС
 ПВ ВВОДА(М14)    ВВОД ПО 'А'           ,вызов через М14
 ПЕ ФПАКП    ДОБРАЛИСЬ ДО КОНЦА МАССИВА  ,если СМ≠0 → ФПАКП    ДОБРАЛ
 УИА ФПАКП(М17)    'ВВОДА' ИСПОРТИЛ НАМ М17  ,М17 := ФПАКП
 УИА ПАКП1(М13)                         ,М13 := ПАКП1
 ПБ ЗС                                  ,переход на ЗС
ФПАКП НОП                               ,НОП

***************************************************
* ФПАКП                                           *
*   Регистры: М3, М13, М15, М16                   *
*   Вход: СЛ                                      *
*   Выход: (М15), ЗСС(М13) СИМВОЛ КОНЦА ПАСПОРТА В ПОЛЕ1, РОСП *
***************************************************
 СЧ ЯЧРЕЖ                               ,СМ := ЯЧРЕЖ
 И Е7                                   ,СМ &= Е7
 ПЕ (М15)                               ,если СМ≠0 → (М15)
 СЧИ М3    КОНЕЦ ПАСПОРТА               ,СМ := М3
 ВЧ НАЧПТЕ                              ,СМ -= НАЧПТЕ
 СЛ Е1    НОВАЯ ДЛИНА                   ,СМ += Е1    НОВАЯ ДЛИНА
 ЗП ДЛИПТЕ                              ,ДЛИПТЕ := СМ
 МОД НАЧПТЕ                             ,мод.адрес по коду: НАЧПТЕ
 СЧ                                     ,СМ := стекло (стек -> SM)
 И Е48П33    ОЧИСТИЛИ МЕСТО ДЛЯ НОВОЙ ДЛИНЫ  ,СМ &= Е48П33    ОЧИСТИЛИ М
 ИЛИ ДЛИПТЕ                             ,СМ |= ДЛИПТЕ
 МОД НАЧПТЕ                             ,мод.адрес по коду: НАЧПТЕ
 ЗП                                     ,(адрес) := СМ
 СЧ П377                                ,СМ := П377
 УИИ М16(М3)    В М3 АДРЕС,КУДА СЕЙЧАС ЗАПИШУТ  ,М16 := М3
 ПВ ЗСС(М13)   СИМВОЛ КОНЦА ПАСПОРТА В ПОЛЕ1  ,вызов через М13
 СЛИА 1(М16)                            ,М16 += 1
 СЧИ М16                                ,СМ := М16
 УИИ М13(М15)    АДРЕС ВОЗВРАТА         ,М13 := М15
 ПБ РОСП                                ,переход на РОСП
АМЦХ НОП                                ,НОП

***************************************************
* АМЦХ                                            *
*   Регистры: М15                                 *
*   Вход: АМЦХ                                    *
*   Выход: (М15)                                  *
***************************************************
 СЧ Е1                                  ,СМ := Е1
 ПБ (М15)                               ,переход через М15
*
*
*
УПАК НОП                                ,НОП
* УПАКОВКА В ПОЛЕ1
*  ВХОДНЫЕ ЗНАЧЕНИЯ:
*   НАЧПТЕ - НАЧАЛО ПАСПОРТА В ПОЛЕ1
*  ИСПОЛЬЗУЕТСЯ РАЯ21
*  ВОЗВРАТ ПО М13
*
 СЧИ М13                                ,СМ := М13
 ЗП РАЯ21   АДРЕС ВОЗВРАТА              ,РАЯ21   АДРЕС ВОЗВРА := СМ
 СЧ П377                                ,СМ := П377
 ЗП РЯВСК     СИМВОЛ КОНЦА ПАСПОРТА     ,РЯВСК     СИМВОЛ КОН := СМ
 СЧ ВСЕЕД                               ,СМ := ВСЕЕД
 ЗП ВЫБСК                               ,ВЫБСК := СМ
 ЗП ВЫБСК+1   ПРОБЕЛЫ ВЫБРОСИТ 'ПАКП'   ,ВЫБСК+1   ПРОБЕЛЫ ВЫ := СМ
 СЧ Е16П1                               ,СМ := Е16П1
 ЗП РЯГВСК                              ,РЯГВСК := СМ
 МОД НАЧПТЕ                             ,мод.адрес по коду: НАЧПТЕ
 УИА 1(М1)    ДЛЯ 'ВС'                  ,М1 := 1
 УИА -5(М2)                             ,М2 := -5
 УИИ М3(М1)   ДЛЯ 'ЗС'                  ,М3 := М1
 УИИ М4(М2)                             ,М4 := М2
 ПВ ПАКП(М15)    УПАКОВАЛИ              ,вызов через М15
 МОД РАЯ21                              ,мод.адрес по коду: РАЯ21
 ПБ                                     ,переход
*
*
*
ЗАПАК НОП                               ,НОП
*
* УПАКОВКА ИЗ РБПОЛЯ В ПОЛЕ1
*  ВХОДНЫЕ ЗНАЧЕНИЯ:
*   СМ - ИМЯ ПАСПОРТА
*  ИСПОЛЬЗУЮТСЯ РАЯ1,РАЯ2
*  ВЫХОД ПО М13
*
 ЗП РАЯ2                                ,РАЯ2 := СМ
 СЧИ М13                                ,СМ := М13
 ЗП РАЯ1    АДРЕС ВОЗВРАТА              ,РАЯ1    АДРЕС ВОЗВРА := СМ
 СЧ РАЯ2                                ,СМ := РАЯ2
 ПВ ПИЩИ(М13)                           ,вызов через М13
 ПВ СБРОС(М13)                          ,вызов через М13
 ЗП НАЧПТЕ                              ,НАЧПТЕ := СМ
 УИ М16                                 ,М16 := СМ
 УИА РБПОЛЕ+1(М1)   ДЛЯ 'ВС'            ,М1 := РБПОЛЕ+1
 УИА -5(М2)                             ,М2 := -5
 МОДА (М16)                             ,мод.адрес +1: (М16)
 УИА 1(М3)    ДЛЯ 'ЗС'                  ,М3 := 1

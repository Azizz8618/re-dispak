ФОРОГЛ НОП                              ,НОП

***************************************************
* ФОРОГЛ                                          *
*   Регистры: М16, М17                            *
*   Вход: РЗБ, НАЙКЛЮ                             *
*   Выход: БЕЗКЛ                                  *
***************************************************
 УИ М16                                 ,М16 := СМ
 СЧ (М16)                               ,СМ := (М16) [косвенно]
 СДА 64+24                              ,сдвиг СМ вправо на 24
 ИЛИ МАССТР                             ,СМ |= МАССТР
 ЗП БФВВ                                ,БФВВ := СМ
 СЧ (М16)           ДЛИНА ПАСПОРТА      ,СМ := (М16) [косвенно]
*------*
 СДА 64-30                              ,сдвиг СМ влево на 30
 РЗБ ВСЕ7           РАЗОБРАЛИ 4 МЛАДШИЕ ЦИФРЫ  ,разборка бит: ВСЕ7           
 ИЛИ МАССТР+1                           ,СМ |= МАССТР+1
 ЗП БФВВ+1          ПРИФОРМИРОВАЛИ ДЛИНУ  ,БФВВ+1          ПРИФ := СМ
 СЧ ПРИЗОС                              ,СМ := ПРИЗОС
 ПЕ БЕЗКЛ                               ,если СМ≠0 → БЕЗКЛ
 СЧ (М16)                               ,СМ := (М16) [косвенно]
 СДА 64+32                              ,сдвиг СМ вправо на 32
 УИА РБПОЛЕ+'1402'(М17)                 ,М17 := РБПОЛЕ+'1402'
 ЗП ЧИС10                               ,ЧИС10 := СМ
НАЙКЛЮ НОП          ИЩЕМ КЛЮЧ ПО ПАСПОРТУ  ,НОП ИЩЕМ КЛЮЧ ПО ПАСПОРТУ

***************************************************
* НАЙКЛЮ                                          *
*   Регистры: М14, М17                            *
*   Вход: БЕЗКЛ                                   *
*   Выход: БЕЗКЛ, ЕСТКЛЮ НАШЛИ, (М14)             *
***************************************************
 СЧ -'1376'(М17)                        ,СМ := -'1376'
 НТЖ ВСЕЕД                              ,СМ ^= ВСЕЕД
 ПО БЕЗКЛ                               ,если СМ=0 → БЕЗКЛ
 СЧ -'1377'(М17)                        ,СМ := -'1377'
 НТЖ ЧИС10                              ,СМ ^= ЧИС10
 И Е16П1                                ,СМ &= Е16П1
 ПО ЕСТКЛЮ          НАШЛИ               ,если СМ=0 → ЕСТКЛЮ         
 СЛИА 1(М17)         НА КАЖДУЮ СИСТЕМУ - ДВА СЛОВА  ,М17 += 1
 ЦИКЛ НАЙКЛЮ(М17)                       ,М17-- и если ≠0 → повтор
БЕЗКЛ СЧ МАССТР+2                       ,СМ := МАССТР+2
 ИЛИ Е48П41+2                           ,СМ |= Е48П41+2
 ЗП БФВВ+2                              ,БФВВ+2 := СМ
 ПБ (М14)                               ,переход через М14
ЕСТКЛЮ НОП                              ,НОП

***************************************************
* ЕСТКЛЮ                                          *
*   Регистры: М15, М17                            *
*   Вход: ЭТОСДС                                  *
*   Выход: П8П10(М15) ЧИСЛО ТЕРМИНАЛОВ - ДЕСЯТИЧНОЕ, ЭТОСДС ДВУЗНАЧНОЕ ЧИСЛО *
***************************************************
 СЧ -'1400'(М17)                        ,СМ := -'1400'
 СДА 64+32                              ,сдвиг СМ вправо на 32
 ИЛИ МАССТР+2                           ,СМ |= МАССТР+2
 ЗП БФВВ+2            ПЕРВЫЕ 3 СИМВОЛА КЛЮЧА  ,БФВВ+2            ПЕ := СМ
 СЧ -'1400'(М17)                        ,СМ := -'1400'
 СДА 64-16                              ,сдвиг СМ влево на 16
 ИЛИ МАССТР+3                           ,СМ |= МАССТР+3
 ЗП БФВВ+3            ОСТАЛЬНЫЕ СИМВОЛЫ  ,БФВВ+3            ОС := СМ
 СЧ -'1377'(М17)                        ,СМ := -'1377'
 СДА 64+24    ДВА МЛАДШИХ БАЙТА ПРОПАЛИ  ,сдвиг СМ вправо на 24  
 ПВ П8П10(М15)    ЧИСЛО ТЕРМИНАЛОВ - ДЕСЯТИЧНОЕ  ,вызов через М15
 СДА 64+8                               ,сдвиг СМ вправо на 8
 ПЕ ЭТОСДС    ДВУЗНАЧНОЕ ЧИСЛО          ,если СМ≠0 → ЭТОСДС    ДВУЗН
 СЧ ЧИС10    'П8П10' СЮДА ПИШЕТ         ,СМ := ЧИС10    'П8П10' СЮД
 СДА 64-8                               ,сдвиг СМ влево на 8
 ИЛИ ТПРОБ    НОЛЬ СЛЕВА НАМ НЕ НУЖЕН   ,СМ |= ТПРОБ    НОЛЬ СЛЕВ
 ЗП ЧИС10                               ,ЧИС10 := СМ
ЭТОСДС НОП                              ,НОП

***************************************************
* ЭТОСДС                                          *
*   Регистры: М14, М17                            *
*   Вход: ЭТОСДС                                  *
*   Выход: ЕСТШИФ, (М14)                          *
***************************************************
 СЧ ЧИС10                               ,СМ := ЧИС10
 СДА 64-8                               ,сдвиг СМ влево на 8
 ИЛИ МАССТР+4                           ,СМ |= МАССТР+4
 ЗП БФВВ+4            ПРИФОРМИРОВАЛИ ЧИСЛО ТЕРМИНАЛОВ  ,БФВВ+4            ПР := СМ
 СЛИА -1(М17)                           ,М17 = -1
 СЧ 1(М17)                              ,СМ := 1
 ПЕ ЕСТШИФ                              ,если СМ≠0 → ЕСТШИФ
 СЧ Е48П41                              ,СМ := Е48П41
 ЗП БФВВ+5    О СИСТЕМЕ БЕЗ ШИФРА НЕ ВЫДАВАТЬ  ,БФВВ+5    О СИСТЕМЕ  := СМ
 ПБ (М14)                               ,переход через М14
ЕСТШИФ НОП                              ,НОП


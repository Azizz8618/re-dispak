***************************************************
 УИА ОСЦИКЛ(М16)                        ,М16 := ОСЦИКЛ
 СЧИ М16                                ,СМ := М16
 ЗП ВЫХВЫД                              ,ВЫХВЫД := СМ
 ПВ ДИВВО(М13)   ЗА ПАРАМЕТРАМИ         ,вызов через М13
 УИ М16 КОД ОТВЕТА - 0,1,2              ,М16 := СМ
 ПБ ВЫД0(М16)                           ,переход через М16
ВЫД0 СЧ 0                               ,СМ := 0


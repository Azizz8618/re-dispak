***************************************************
 УИА Е48П41(М1)                         ,М1 := Е48П41
 ПВ ВЫДШАГ(М13)                         ,вызов через М13
 СЧ (М15)                               ,СМ := (М15) [косвенно]
 ПО ВЫДСВО  ВСЕ,УХОДИМ                  ,если СМ=0 → ВЫДСВО  ВСЕ,УХО
 НТЖ ВСЕЕД                              ,СМ ^= ВСЕЕД
 СЛЦ Е1     СМ:=(-ДЛИНА ПАСПОРТА)       ,СМ += Е1     СМ:= [цикли.]
 УИ М1      ДЛЯ ЦИКЛА                   ,М1 := СМ
 МОД (М15)                              ,мод.адрес по коду: (М15)
 УИА (М2)   ДЛИНА ПАСПОРТА              ,М2 := 0
 СЛИ М15(М2)                            ,М15 += М2
ПЕРПИС НОП                              ,НОП


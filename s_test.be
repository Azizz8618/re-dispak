Э50112 НОП                              ,НОП

***************************************************
* Э50112                                          *
*   Регистры: М13, М16                            *
*   Вход: Д7, СТСДВ                               *
*   Выход: Д7(М16), (М13)                         *
***************************************************
 СЧ ИСЧТ55                              ,СМ := ИСЧТ55
 Э50 '156'                              ,'156'
 УИ М16                                 ,М16 := СМ
 СЧ СТСДВ                               ,СМ := СТСДВ
 ПИО Д7(М16)                            ,если ИР=0 → Д7(М16)
 СДА 64+5                               ,сдвиг СМ вправо на 5
Д7 ИЛИ ИСЧТ55                           ,СМ |= ИСЧТ55
 Э50 '112'                              ,'112'
СТСДВ ПБ (М13)                          ,переход через М13
 ЗП '540'                               ,'540' := СМ
*
ВВОДА НОП                               ,НОП
* ВВОД ПО ПРИЗНАКУ А N ДО КОНЦА ВВОДА
* ВХОДНЫЕ ЗНАЧЕНИЯ:*  РЯВСК - СИМВОЛ КОНЦА МАССИВА
*  СМ : 0-5 ( N )
* ВЫХОДНЫЕ ЗНАЧЕНИЯ
*  СМ = 0  ВСЕ В ПОРЯДКЕ
*  СМ   0  ОТС.ПРИЗНАК КОНЦА ВВОДА
* ИСПОЛЬЗУЮТСЯ М16,М17
* ВЫХОД ПО М14
 УИ М16                                 ,М16 := СМ
 СЧИ М17                                ,СМ := М17
 ЗП РАЯ41                               ,РАЯ41 := СМ
ВВОЖУА НОП                              ,НОП

***************************************************
* ВВОЖУА                                          *
*   Регистры: М17                                 *
*   Вход: ВВОЖУ                                   *
***************************************************
 УИА 48(М17)                            ,М17 := 48
ВВОЖУ НОП                               ,НОП

***************************************************
* ВВОЖУ                                           *
*   Регистры: М13, М16, М17                       *
*   Вход: ВВЕЛА                                   *
*   Выход: ВС(М13), ОШВВОА, ВВОЖУ, ВВЕЛА НУЛЕВОЙ БАЙТ-КОНЕЦ, ЗС ПРОДОЛЖИМ ВВОД, ЗС(М13) *
***************************************************
 ПВ ВС(М13)                             ,вызов через М13
 ЗП РЯЗС                                ,РЯЗС := СМ
 НТЖ РЯВСК   ПРИЗНАК КОНЦА МАССИВА      ,СМ ^= РЯВСК   ПРИЗНАК КО
 ПО ОШВВОА                              ,если СМ=0 → ОШВВОА
 НТЖ РЯВСК                              ,СМ ^= РЯВСК
 НТЖ ВЫБСК+1                            ,СМ ^= ВЫБСК+1
 ПО ВВОЖУ                               ,если СМ=0 → ВВОЖУ
 СЛИА -8(М17)                           ,М17 = -8
 СЧ ПРИКОН(М16)   ПРИЗНАК КОНЦА         ,СМ := ПРИКОН
 СДА 64(М17)                            ,сдвиг СМ на 64(М17)
 И П377                                 ,СМ &= П377
 ПО ВВЕЛА   НУЛЕВОЙ БАЙТ-КОНЕЦ          ,если СМ=0 → ВВЕЛА   НУЛЕВОЙ
 УИА ВВОЖУА(М13)                        ,М13 := ВВОЖУА
 НТЖ РЯЗС                               ,СМ ^= РЯЗС
 ПЕ ЗС   ПРОДОЛЖИМ ВВОД                 ,если СМ≠0 → ЗС   ПРОДОЛЖИМ 
 ПВ ЗС(М13)                             ,вызов через М13
 ПИНО ВВОЖУ(М17)   ПРОВЕРЯЕМ НА ПРИЗНАК КОНЦА  ,если ИР≠0 → ВВОЖУ(М17)   ПР
 МОД РАЯ41                              ,мод.адрес по коду: РАЯ41
 УИА (М17)                              ,М17 := 0
 ПВ ВСК(М13)                            ,вызов через М13
 ЗП РЯЗС   ПЕРВЫЙ СЛЕДУЮЩИЙ СИМВОЛ      ,РЯЗС   ПЕРВЫЙ СЛЕДУЮ := СМ
ВВЕЛА НОП                               ,НОП

***************************************************
* ВВЕЛА                                           *
*   Регистры: М14                                 *
*   Вход: ВВЕЛА                                   *
*   Выход: (М14)                                  *
***************************************************
 СЧ 0   ВСЕ НОРМАЛЬНО                   ,СМ := 0   ВСЕ НОРМАЛЬНО
 ПБ (М14)                               ,переход через М14
ОШВВОА НОП                              ,НОП

***************************************************
* ОШВВОА                                          *
*   Регистры: М14                                 *
*   Вход: ОШВВОА                                  *
*   Выход: (М14)                                  *
***************************************************
 СЧ ВСЕЕД   ОШИБКА-КОНЕЦ МАССИВА        ,СМ := ВСЕЕД   ОШИБКА-КОНЕЦ
 ПБ (М14)                               ,переход через М14
*
*
*
ПИЩИ НОП                                ,НОП
* ПОИСК ПАСПОРТА В ПОЛЕ1
*  ВХОДНЫЕ ЗНАЧЕНИЯ:*   СМ - ИМЯ ПАСПОРТА (1-16 РР.)
*  ВЫХОДНЫЕ ЗНАЧЕНИЯ:*   СМ = 0 ТАКОГО ПАСПОРТА НЕТ
*   СМ     АДРЕС НАЧАЛА (1-15 РР.)
*  ИСПОЛЬЗУЮТСЯ РАЯ21,М16,М17
*  ВЫХОД ПО М13
*
 СДА 64-32    ИМЯ В СТАРШИХ РАЗРЯДАХ    ,сдвиг СМ влево на 32  
 ЗП РАЯ21                               ,РАЯ21 := СМ
 УИА ПОЛЕ1(М16)    НАЧАЛО ЗОН ПАСПОРТОВ  ,М16 := ПОЛЕ1
 УИА -'3777'(М17)                       ,М17 := -'3777'
ПИЩУ НОП                                ,НОП

***************************************************
* ПИЩУ                                            *
*   Регистры: М13, М16, М17                       *
*   Вход: НАШЕЛП                                  *
*   Выход: (М13), НАШЕЛП НАШЛИ                    *
***************************************************
 СЧ (М16)                               ,СМ := (М16) [косвенно]
 ПО (М13)                               ,если СМ=0 → (М13)
 НТЖ РАЯ21                              ,СМ ^= РАЯ21
 И Е48П33                               ,СМ &= Е48П33
 ПО НАШЕЛП    НАШЛИ                     ,если СМ=0 → НАШЕЛП    НАШЛИ
 МОД (М16)                              ,мод.адрес по коду: (М16)
 СЛИА (М16)    НАЧАЛО СЛЕДУЮЩЕГО        ,М16 += 0
 ЦИКЛ ПИЩУ(М17)                         ,М17-- и если ≠0 → повтор
 УИА (М16)                              ,М16 := 0
НАШЕЛП НОП                              ,НОП

***************************************************
* НАШЕЛП                                          *
*   Регистры: М13, М16                            *
*   Вход: НАШЕЛП                                  *
*   Выход: (М13) ВОЗВРАТ                          *
***************************************************
 СЧИ М16                                ,СМ := М16
 ПБ (М13)    ВОЗВРАТ                    ,переход через М13
*
*
*
СБРОС НОП                               ,НОП
* СБРАСЫВАЕТ ПАСПОРТ В КОНЕЦ
* ЗОН СТАНДАРТНЫХ ПАСПОРТОВ
*  ВХОДНЫЕ ЗНАЧЕНИЯ:
*   СМ - АДРЕС НАЧАЛА (1-15 РР.)
*  ВЫХОДНЫЕ ЗНАЧЕНИЯ:
*   СМ - НОВЫЙ АДРЕС НАЧАЛА
*  ИСПОЛЬЗУЮТСЯ РАЯ21,РАЯ22,РАЯ23,М6,М16,М17
*  ВОЗВРАТ ПО М13
*
 УИ М6                                  ,М6 := СМ
 ПВ ПЕРСВО(М14)    АДРЕС ПЕРВОЙ СВОБОДНОЙ  ,вызов через М14
 ВЧ Е1                                  ,СМ -= Е1
 ЗП РАЯ22    СБРАСЫВАЕМ ЧЕРЕЗ ПОСЛЕДНЮЮ ЗАНЯТУЮ  ,РАЯ22    СБРАСЫВАЕМ  := СМ
 СЧ (М6)                                ,СМ := (М6) [косвенно]
 И Е15П1                                ,СМ &= Е15П1
 ЗП РАЯ23    ЧТОБЫ УЗНАТЬ АДРЕС НОВОГО НАЧАЛА  ,РАЯ23    ЧТОБЫ УЗНАТ := СМ
 ВЧОБ Е1                                ,СМ := (адрес) - СМ
 УИ М17    ВНЕШНИЙ ЦИКЛ=ДЛИНЕ ПАСПОРТА  ,М17 := СМ
СБРОС1 НОП                              ,НОП

***************************************************
* СБРОС1                                          *
*   Регистры: М6, М16                             *
*   Вход: СБРОС2                                  *
***************************************************
 СЧ (М6)                                ,СМ := (М6) [косвенно]
 ЗП РАЯ21   ВРЕМЕННЫЙ БУФЕР             ,РАЯ21   ВРЕМЕННЫЙ БУ := СМ
 УИИ М16(М6)                            ,М16 := М6
СБРОС2 НОП                              ,НОП

***************************************************
* СБРОС2                                          *
*   Регистры: М13, М16, М17                       *
*   Вход: СБРОС2                                  *

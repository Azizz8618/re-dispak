*   Вход: КУДВС1, СКИНЕМ                          *
*   Выход: ВС(М13), КУДВС1                        *
***************************************************
 УИА -1(М10)                            ,М10 := -1
 УИА -5(М2)     ДЛЯ ВС                  ,М2 := -5
 УИА РБПОЛЕ(М1)                         ,М1 := РБПОЛЕ
КУДВС1 ПВ ВС(М13)                       ,вызов через М13
 НТЖ П377                               ,СМ ^= П377
 ПЕ КУДВС1                              ,если СМ≠0 → КУДВС1
 СЛИА 1(М10)                            ,М10 += 1
 СЧИ М10                                ,СМ := М10
 НТЖ РАЯ41                              ,СМ ^= РАЯ41
 ПЕ КУДВС1                              ,если СМ≠0 → КУДВС1
*НАШЛИ. <М1>=СЛОВО, <М2>=БАЙТ-6
*КОНЕЦ КУДВСТ
*
*ОТОДВИНУТЬ В КОНЕЦ ЛИСТА
СКИНЕМ НОП                              ,НОП
*М5 - ОТКУДА
*М6 - КУДА
 СЧИ М1                                 ,СМ := М1
 ЗП РАЯ41                               ,РАЯ41 := СМ
 МОД ДСЛОВ                              ,мод.адрес по коду: ДСЛОВ
 УИА РБПОЛЕ-1(М5)                       ,М5 := РБПОЛЕ-1
 УИА РБПОЛЕ+'1777'(М6)                  ,М6 := РБПОЛЕ+'1777'
*ГРУБО
СКИН1 СЧИ М5                            ,СМ := М5
 НТЖ РАЯ41                              ,СМ ^= РАЯ41
 ПО СКИН2     ГРУБО СКИНУЛИ             ,если СМ=0 → СКИН2     ГРУБО
 СЧ (М5)                                ,СМ := (М5) [косвенно]
 ЗП (М6)                                ,запись (Мx) [косвенно]
 СЧИ                                    ,СМ := ИР
 ЗП (М5)                                ,запись (Мx) [косвенно]
 СЛИА -1(М5)                            ,М5 = -1
 СЛИА -1(М6)                            ,М6 = -1
 ПО СКИН1                               ,если СМ=0 → СКИН1
*ТОЧНО
СКИН2 СЧ (М1)                           ,СМ := (М1) [косвенно]
 И Е8П1(М2)                             ,СМ &= Е8П1(М2)
 ЗП (М6)                                ,запись (Мx) [косвенно]
 СЧ Е8П1(М2)                            ,СМ := Е8П1
 НТЖ ВСЕЕД                              ,СМ ^= ВСЕЕД
 И (М1)                                 ,СМ &= (М1)
 ЗП (М1)                                ,запись (Мx) [косвенно]

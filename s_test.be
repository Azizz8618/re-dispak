*
*
*-----------------------*
*  ДИРЕКТИВА ' И С К '  *
*-----------------------*
*
*
*
ИСК НОП                                 ,НОП

***************************************************
* ИСК                                             *
*   Регистры: М13                                 *
*   Вход: ИСК                                     *
*   Выход: ПРКА(М13) ПРОВЕРИМ,ЧТО ИСКЛЮЧАЕМ, ОШПАР НУЖНО ТОЛЬКО ПОЛНОЕ И ПРАВИЛЬНОЕ, ПИЩИ(М13) УЗНАЕМ АДРЕС НАЧАЛА, НИЧАВО ТАКОГО НЕТУ, СБРОС(М13) СБРОСИЛИ В КОНЕЦ, РОСП(М13) ЗАРУБИЛИ *
***************************************************
 ПВ ПРКА(М13)    ПРОВЕРИМ,ЧТО ИСКЛЮЧАЕМ  ,вызов через М13
 НТЖ Е40П1                              ,СМ ^= Е40П1
 ПЕ ОШПАР    НУЖНО ТОЛЬКО ПОЛНОЕ И ПРАВИЛЬНОЕ  ,если СМ≠0 → ОШПАР    НУЖНО 
 СЧ ТЕКОПЕ                              ,СМ := ТЕКОПЕ
 ПВ ПИЩИ(М13)   УЗНАЕМ АДРЕС НАЧАЛА     ,вызов через М13
 ПО НИЧАВО    ТАКОГО НЕТУ               ,если СМ=0 → НИЧАВО    ТАКОГ
 ПВ СБРОС(М13)    СБРОСИЛИ В КОНЕЦ      ,вызов через М13
 ПВ РОСП(М13)    ЗАРУБИЛИ               ,вызов через М13
 СЧ ТЕКОПЕ                              ,СМ := ТЕКОПЕ
 НТЖ ТЕКПАС                             ,СМ ^= ТЕКПАС
 ПО ГЫН                                 ,если СМ=0 → ГЫН
 СЧ ТЕКПАС                              ,СМ := ТЕКПАС
 ПВ ПИЩИ(М13)                           ,вызов через М13
 ЗП НАЧПТЕ                              ,НАЧПТЕ := СМ
 ПБ ГЫН                                 ,переход на ГЫН

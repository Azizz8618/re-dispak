 СЧ Е5                                  ,СМ := Е5
 ИЛИ ЯЧРЕЖ                              ,СМ |= ЯЧРЕЖ
 ЗП ЯЧРЕЖ       РАБОТАЕТ 'РЕД'          ,ЯЧРЕЖ       РАБОТАЕТ := СМ
 И Е2                                   ,СМ &= Е2
 ПО НЕТМРБ                              ,если СМ=0 → НЕТМРБ
 СЧ ТПРВВД                              ,СМ := ТПРВВД
 ЗП БФВВ                                ,БФВВ := СМ
 ПВ ВЫЧДЛИ(М16)                         ,вызов через М16
 УИА ВЫХРЕД(М15)                        ,М15 := ВЫХРЕД

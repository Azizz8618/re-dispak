 ИЛИ Е2                                 ,СМ |= Е2
 НТЖ Е2                                 ,СМ ^= Е2
 ЗП ЯЧРЕЖ   ТРЕТИЙ УРОВЕНЬ БУДЕТ ИСПОРЧЕН  ,ЯЧРЕЖ   ТРЕТИЙ УРОВЕ := СМ
 УИА ПОЛЕ1(М15)    НАЧАЛО ПЕРВОГО ПАСПОРТА  ,М15 := ПОЛЕ1
ЦИКВСЕ НОП                              ,НОП


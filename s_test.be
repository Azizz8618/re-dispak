УПОРЯД НОП                              ,НОП
* БЛОК ПРИВОДИТ ИНФОРМАЦИЮ,
* СЧИТАННУЮ ИЗ ЗОНЫ КЛЮЧЕЙ
* К КАНОНИЧЕСКОМУ ВИДУ:
* СРЕДИ КЛЮЧЕЙ НЕ ДОЛЖНО БЫТЬ
* НУЛЕВЫХ СЛОВ, А ПОСЛЕ ПОСЛЕДНЕГО
* КЛЮЧА ЗАПИСАН 'ВСЕЕД'.
*   ИСПОЛЬЗОВАНЫ:
*     -М6,М7
*   ВОЗВРАТ ПО [М17]
*
 УИА РБПОЛЕ(М6)                         ,М6 := РБПОЛЕ
 УИА (М7)                               ,М7 := 0
 УИА -'176'(М5)                         ,М5 := -'176'
УПОР1 СЛИА 2(М6)                        ,М6 += 2
 СЧ (М6)                                ,СМ := (М6) [косвенно]
 НТЖ ВСЕЕД                              ,СМ ^= ВСЕЕД
 ПЕ УПОР2      НЕ ВСЕЕД                 ,если СМ≠0 → УПОР2      НЕ В
 МОДА (М17)                             ,мод.адрес +1: (М17)
 ПИО (М7)      ВСЕЕД И '0' В М7:УХОД ИЗ БЛОКА  ,если ИР=0 → (М7)      ВСЕЕД
 ПБ УПОР3      ВСЕЕД И НЕ '0' В М7      ,переход на УПОР3      ВСЕЕД И Н
УПОР2 НТЖ ВСЕЕД                         ,СМ ^= ВСЕЕД

***************************************************
* УПОР2                                           *
*   Регистры: М6, М7                              *
*   Вход: УПОР2                                   *
*   Выход: УПОР4 НЕ ВСЕЕД И НЕ '0': КЛЮЧ, КЦУПОР(М7) '0' ИЩЕМ КЛЮЧ ИЛИ 'ВСЕЕД', КЦУПОР ИЩЕМ КЛЮЧ ИЛИ 'ВСЕЕД' *
***************************************************
 ПЕ УПОР4      НЕ ВСЕЕД И НЕ '0': КЛЮЧ  ,если СМ≠0 → УПОР4      НЕ В
 ПИНО КЦУПОР(М7)      '0' ИЩЕМ КЛЮЧ ИЛИ 'ВСЕЕД'  ,если ИР≠0 → КЦУПОР(М7)     
 УИИ М7(М6)      ПЕРВЫЙ '0'             ,М7 := М6
 ПБ КЦУПОР      ИЩЕМ КЛЮЧ ИЛИ 'ВСЕЕД'   ,переход на КЦУПОР      ИЩЕМ КЛЮ
УПОР4 ПИНО УПОР3(М7)      НА ПЕРЕДВИЖКУ КЛЮЧА  ,если ИР≠0 → УПОР3(М7)      

***************************************************
* УПОР4                                           *
*   Регистры: М5, М7, М17                         *
*   Вход: КЦУПОР                                  *
*   Выход: УПОР3(М7) НА ПЕРЕДВИЖКУ КЛЮЧА, (М17) НУЛЕЙ И 'ВСЕЕДА' НЕТ. ЗАПИСАЛИ 'ВСЕЕД' И УШЛИ *
***************************************************
КЦУПОР ЦИКЛ УПОР1(М5)                   ,М5-- и если ≠0 → повтор
 СЧ ВСЕЕД                               ,СМ := ВСЕЕД
 ЗП (М7)                                ,запись (Мx) [косвенно]
 ПБ (М17)      НУЛЕЙ И 'ВСЕЕДА' НЕТ. ЗАПИСАЛИ 'ВСЕЕД' И УШЛИ  ,переход через М17
УПОР3 НОП                               ,НОП

***************************************************
* УПОР3                                           *
*   Регистры: М6, М7                              *
*   Вход: УПОР3                                   *
*   Выход: УПОРЯД РЕКУРСИЯ. РАБОТАЕМ ДАЛЬШЕ       *
***************************************************
 СЧ (М6)                                ,СМ := (М6) [косвенно]
 ЗП (М7)                                ,запись (Мx) [косвенно]
 СЧ 1(М6)                               ,СМ := 1
 ЗП 1(М7)                               ,1 := СМ
 СЧ ШИФРЫ(М6)                           ,СМ := ШИФРЫ
 ЗП ШИФРЫ(М7)                           ,ШИФРЫ := СМ
 СЧ ПАРОЛИ(М6)                          ,СМ := ПАРОЛИ
 ЗП ПАРОЛИ(М7)                          ,ПАРОЛИ := СМ
 СЧ 0                                   ,СМ := 0
 ЗП (М6)                                ,запись (Мx) [косвенно]
 ЗП 1(М6)                               ,1 := СМ
 ЗП ШИФРЫ(М6)                           ,ШИФРЫ := СМ
 ЗП ПАРОЛИ(М6)                          ,ПАРОЛИ := СМ
 ПБ УПОРЯД      РЕКУРСИЯ. РАБОТАЕМ ДАЛЬШЕ  ,переход на УПОРЯД      РЕКУРСИЯ
*
*
*
ДАЙИМЯ НОП                              ,НОП
* БЛОК ЗАНОСИТ ИМЯ ТЕКУЩЕГО
* КЛЮЧА В ЯЧЕЙКУ 'РАЯ41',ДОПОЛНИВ
* ЕГО ДО ШЕСТИ СИМВОЛОВ ПРОБЕЛАМИ
* СПРАВА. ЕСЛИ ИМЯ В КАЧЕСТВЕ ОПЕРАНДА
* ДИРЕКТИВЫ НЕ ЗАДАНО, ТО ОНО ДОЗАПРАШИВАЕТСЯ
*   БЛОК ИСПОЛЬЗУЕТ:
*     -М1,М2,М3,М4,М14,М15;
*     -ЯЧЕЙКИ 'РЯЗС','ТЕКОПЕ'.
*   ВОЗВРАТ ПО [М12].
*
 СЧ ТЕКОПЕ                              ,СМ := ТЕКОПЕ
 НТЖ Е48П41                             ,СМ ^= Е48П41
 ПЕ ДАЙИМ1      ИМЯ В ОПЕРАНДЕ ПРИКАЗА  ,если СМ≠0 → ДАЙИМ1      ИМЯ
 УИА ПОВТ1(М15)                         ,М15 := ПОВТ1
 СЧ ТИМЯ                                ,СМ := ТИМЯ
 ЗП БФВВ                                ,БФВВ := СМ
 ПВ ПРИЕМ(М14)      ДОЗАПРОС ИМЕНИ      ,вызов через М14
 СЧ БФВВ                                ,СМ := БФВВ
 ЗП ТЕКОПЕ                              ,ТЕКОПЕ := СМ
ДАЙИМ1 НОП                              ,НОП

***************************************************
* ДАЙИМ1                                          *
*   Регистры: М2, М3, М4, М5, М12, М13            *
*   Вход: ДАЙИМ2, ДАЙИМ3                          *
*   Выход: ВС(М13) ЦИКЛ ПЕРЕПИСИ ИЗ 'ТЕКОПЕ' ИЛИ 'ВСЕПРО' В, ДАЙИМ3 НЕ КОНЕЦ КЛЮЧА, ВС(М13), ЗС(М13), ДАЙИМ2(М5) ПЕРЕПИСЬ НЕ ОКОНЧЕНА, (М12) УХОД ИЗ БЛОКА *
***************************************************
 УИА ТЕКОПЕ(М1)                         ,М1 := ТЕКОПЕ
 УИА РАЯ41(М3)                          ,М3 := РАЯ41
 УИА -5(М2)                             ,М2 := -5
 УИА -5(М4)      ВХОДНЫЕ ЗНАЧЕНИЯ ДЛЯ БЛОКОВ 'ВС' И 'ЗС'  ,М4 := -5
ДАЙИМ2 ПВ ВС(М13)      ЦИКЛ ПЕРЕПИСИ ИЗ 'ТЕКОПЕ' ИЛИ 'ВСЕПРО' В  ,вызов через М13
 ЗП РЯЗС                                ,РЯЗС := СМ
 НТЖ П377                               ,СМ ^= П377
 ПЕ ДАЙИМ3      НЕ КОНЕЦ КЛЮЧА          ,если СМ≠0 → ДАЙИМ3      НЕ 
 УИА ВСЕПРО(М1)      ПЕРЕКЛЮЧЕНИЕ НА ДОПОЛНЕНИЕ ПРОБЕЛАМИ  ,М1 := ВСЕПРО
 УИА -5(М2)      ВМЕСТО <ЕТХ> - ПРОБЕЛ  ,М2 := -5
 ПВ ВС(М13)                             ,вызов через М13
 ЗП РЯЗС                                ,РЯЗС := СМ
ДАЙИМ3 ПВ ЗС(М13)                       ,вызов через М13
 УИИ М5(М4)                             ,М5 := М4
 СЛИА 5(М5)                             ,М5 += 5
 ПИНО ДАЙИМ2(М5)      ПЕРЕПИСЬ НЕ ОКОНЧЕНА  ,если ИР≠0 → ДАЙИМ2(М5)     
 ПБ (М12)      УХОД ИЗ БЛОКА            ,переход через М12
*
*
*
ПОК1 НОП                                ,НОП
* БЛОК ОСУЩЕСТВЛЯЕТ ПОИСК КЛЮЧА С ЗАДАННЫМ
* ИМЕНЕМ В 'РБПОЛЕ'. ЕСЛИ КЛЮЧ НАЙДЕН, ТО
* НА ЭКРАН ВЫДАЮТСЯ СВЕДЕНИЯ О НЕМ, В ПРОТИВНОМ
* СЛУЧАЕ ВЫДАЕТСЯ "НЕВВЕ"
*   ВХОДНЫЕ ЗНАЧЕНИЯ:
*     -ИМЯ КЛЮЧА В ЯЧЕЙКЕ 'РАЯ41'
*   ИСПОЛЬЗУЮТСЯ:
*     -М1,М10,М13,М15
*   ВОЗВРАТ:
*     -ПО [М12],ЕСЛИ КЛЮЧ НАЙДЕН
*     -ПО [М11] В ПРОТИВНОМ СЛУЧАЕ
*
 УИА РБПОЛЕ+2(М10)                      ,М10 := РБПОЛЕ+2
ПОК2 СЧ (М10)                           ,СМ := (М10) [косвенно]
 УИА ЧТПАСП(М13)                        ,М13 := ЧТПАСП
 НТЖ РАЯ41                              ,СМ ^= РАЯ41
 ПО ПОК3      КЛЮЧ НАЙДЕН               ,если СМ=0 → ПОК3      КЛЮЧ 
 СЧ (М10)                               ,СМ := (М10) [косвенно]
 НТЖ ВСЕЕД                              ,СМ ^= ВСЕЕД
 ПО ПОК4      ВСЕ КЛЮЧИ ПРОСМОТРЕНЫ     ,если СМ=0 → ПОК4      ВСЕ К
 СЛИА 2(М10)                            ,М10 += 2
 ПИО ПОК4(М10)      ПРОСМОТРЕН ЦЕЛЫЙ ЛИСТ  ,если ИР=0 → ПОК4(М10)      
 ПБ ПОК2      СМОТРИМ ДАЛЬШЕ            ,переход на ПОК2      СМОТРИМ ДА
ПОК4 УИА ТНЕВВЕ(М1)                     ,М1 := ТНЕВВЕ

***************************************************
* ПОК4                                            *
*   Регистры: М11, М13                            *
*   Вход: ПОК4                                    *
*   Выход: ВЫДШАГ                                 *
***************************************************
 СЧ РАЯ41                               ,СМ := РАЯ41
 НТЖ ТЕКНЦ                              ,СМ ^= ТЕКНЦ
 ПО ВЫДШАГ                              ,если СМ=0 → ВЫДШАГ
 УИИ М13(М11)                           ,М13 := М11
 ПБ ВЫДШАГ                              ,переход на ВЫДШАГ
ПОК3 СЧ (М10)                           ,СМ := (М10) [косвенно]

***************************************************
* ПОК3                                            *
*   Регистры: М10, М15                            *
*   Вход: ПОК3                                    *
*   Выход: П8П10(М15), ПОК5, ВЫДАТЬ               *
***************************************************
 ЗП БФВВ                                ,БФВВ := СМ
 СЧ 1(М10)                              ,СМ := 1
 СДА 64+24      НА СМ ЧИСЛО ТЕРМИНАЛОВ  ,сдвиг СМ вправо на 24  
 ПВ П8П10(М15)                          ,вызов через М15
 СДА 64-24                              ,сдвиг СМ влево на 24
 ИЛИ СЛНТЕР                             ,СМ |= СЛНТЕР
 ЗП БФВВ+2                              ,БФВВ+2 := СМ
 СЧ ППТЕРМ                              ,СМ := ППТЕРМ
 ЗП БФВВ+1                              ,БФВВ+1 := СМ
 СЧ 1(М10)                              ,СМ := 1
 И Е16П1      НА СМ ИМЯ СТ.ПАСПОРТА     ,СМ &= Е16П1      НА СМ ИМЯ
 ИЛИ СЛПАСП                             ,СМ |= СЛПАСП
 ЗП БФВВ+3                              ,БФВВ+3 := СМ
 СЧ ШИФРЫ(М10)                          ,СМ := ШИФРЫ
 ПЕ ПОК5                                ,если СМ≠0 → ПОК5
 СЧ ЕТХ                                 ,СМ := ЕТХ
 ЗП БФВВ+4                              ,БФВВ+4 := СМ
 ПБ ВЫДАТЬ                              ,переход на ВЫДАТЬ
ПОК5 РЗБ ВСЕПРО                         ,разборка бит: ВСЕПРО

***************************************************
* ПОК5                                            *
*   Регистры: М10, М12, М13, М14                  *
*   Вход: РЗБ, ВЫДАТЬ                             *
*   Выход: ВЫДШАГ                                 *
***************************************************
 ЗП БФВВ+5                              ,БФВВ+5 := СМ
 СЧ ПШИФРП                              ,СМ := ПШИФРП
 ЗП БФВВ+4                              ,БФВВ+4 := СМ
 СЧ ШИФРЫ(М10)                          ,СМ := ШИФРЫ
 СДА 64-24                              ,сдвиг СМ влево на 24
 РЗБ ВСЕПРО                             ,разборка бит: ВСЕПРО
 ЗП БФВВ+6                              ,БФВВ+6 := СМ
 СЧ ЕТХ                                 ,СМ := ЕТХ
 ЗП БФВВ+7                              ,БФВВ+7 := СМ
ВЫДАТЬ УИА БФВВ(М1)                     ,М1 := БФВВ
 УИА ПОВТ1(М14)      ВОЗВРАТ ПРИ <DЕL>  ,М14 := ПОВТ1
 УИИ М13(М12)                           ,М13 := М12
 ПБ ВЫДШАГ                              ,переход на ВЫДШАГ

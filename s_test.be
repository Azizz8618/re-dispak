 НТЖ П377                               ,СМ ^= П377
 ПЕ ДОПИС5                              ,если СМ≠0 → ДОПИС5
 СЧ ЯЧРЕЖ                               ,СМ := ЯЧРЕЖ
 ИЛИ Е6                                 ,СМ |= Е6
 ЗП ЯЧРЕЖ                               ,ЯЧРЕЖ := СМ
ДОПИС5 СЧ РЯЗС                          ,СМ := РЯЗС
 НТЖ П214                               ,СМ ^= П214
 ПЕ ДОПИС4                              ,если СМ≠0 → ДОПИС4
 СЧ П377                                ,СМ := П377

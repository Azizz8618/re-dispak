 ПЕ ДОПИС1                              ,если СМ≠0 → ДОПИС1
 СЧ ЯЧРЕЖ                               ,СМ := ЯЧРЕЖ
 И Е5                                   ,СМ &= Е5
 ПО ПРИМЕМ      ДОПИСЬ ОДНОЙ КАРТЫ СДЕЛАНА  ,если СМ=0 → ПРИМЕМ      ДОП
 СЧИ М1                                 ,СМ := М1
 ЗП РАЯ12                               ,РАЯ12 := СМ
 СЧИ М2                                 ,СМ := М2
 ЗП РАЯ13   SАVЕ RЕGS                   ,РАЯ13   SАVЕ RЕGS := СМ
ДОПИС2 НОП     ГОТОВИМ ДОДВИГ СКИНУТОГО  ,НОП ГОТОВИМ ДОДВИГ СКИНУТ

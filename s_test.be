*   Выход: ОТМ7                                   *
***************************************************
 СЧ РАЯ42                               ,СМ := РАЯ42
 ВЧОБ ДСТРОК                            ,СМ := (адрес) - СМ
 ПО ОТМ7                                ,если СМ=0 → ОТМ7
 СЧ ДСТРОК                              ,СМ := ДСТРОК
 ЗП РАЯ42         N2 := ДСТРОК          ,РАЯ42         N2 :=  := СМ
ОТМ7 НОП                                ,НОП

***************************************************
* ОТМ7                                            *
*   Регистры: М2, М3, М4, М5, М7, М13, М14, М16   *
*   Вход: ОТМ1, ОТМ2, ОТМ3, ОТМ4, ОТМ5            *
*   Выход: ОШПАР, ВС(М13), ОТМ3, ОТМ4, ПС(М14), ОТМ5 *
***************************************************
ОТМ1 СЧ РАЯ41                           ,СМ := РАЯ41
 ПО ОШПАР                               ,если СМ=0 → ОШПАР
ОТМ2 СЧИ                                ,СМ := ИР
 ВЧ РАЯ41                               ,СМ -= РАЯ41
 УИ М16                                 ,М16 := СМ
 СЛИА 1(М16)                            ,М16 += 1
 УИА РБПОЛЕ(М1)                         ,М1 := РБПОЛЕ
 УИА -5(М2)                             ,М2 := -5
ОТМ3 ПВ ВС(М13)                         ,вызов через М13
 НТЖ П377                               ,СМ ^= П377
 ПЕ ОТМ3                                ,если СМ≠0 → ОТМ3
 ЦИКЛ ОТМ3(М16)                         ,М3-- и если ≠0 → повтор
 УИИ М3(М1)                             ,М3 := М1
 УИИ М4(М2)                             ,М4 := М2
 СЧ РАЯ41                               ,СМ := РАЯ41
 ВЧ РАЯ42                               ,СМ -= РАЯ42
 УИ М16                                 ,М16 := СМ
ОТМ4 ПВ ВС(М13)                         ,вызов через М13
 НТЖ П377                               ,СМ ^= П377
 ПЕ ОТМ4                                ,если СМ≠0 → ОТМ4
 ЦИКЛ ОТМ4(М16)                         ,М4-- и если ≠0 → повтор
ОТМ5 ПВ ПС(М14)                         ,вызов через М14
 НТЖ П376                               ,СМ ^= П376
 ПЕ ОТМ5                                ,если СМ≠0 → ОТМ5
 СЧ ЯЧРЕЖ                               ,СМ := ЯЧРЕЖ
 И Е4                                   ,СМ &= Е4
 ПО ОСЦИКЛ     РАБОТАЕТ =ОТМ=, А НЕ =ЗАМ=  ,если СМ=0 → ОСЦИКЛ     РАБО
 НТЖ ЯЧРЕЖ                              ,СМ ^= ЯЧРЕЖ
 ЗП ЯЧРЕЖ                               ,ЯЧРЕЖ := СМ
 СЧ РАЯ41                               ,СМ := РАЯ41
 ВЧ Е1        ПОТОМУЧТО ВСТАВКА ПЕРЕД   ,СМ -= Е1        ПОТОМУЧТО 
 ЗП РАЯ41     ОПЕРАНД ДИРЕКТИВЫ         ,РАЯ41     ОПЕРАНД ДИ := СМ
 УИА КУДВСТ(М16)      ДЛЯ ВОЗВРАТА      ,М16 := КУДВСТ
 ПБ ВЫЧДЛИ    ДЛИНА ИЗМЕНЧИВА           ,переход на ВЫЧДЛИ    ДЛИНА ИЗМЕ
*
*
*     ДИРЕКТИВА  =  З  А  М  =

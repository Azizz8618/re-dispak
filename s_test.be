 КОНК П'ЧИТ'                            ,КОНК П'ЧИТ'
 ПБ ОГЛКЛЮ                              ,переход на ОГЛКЛЮ
 КОНК П'ОГЛ'                            ,КОНК П'ОГЛ'
КДИКЛЮ ЭКВ *-ТАБДИР                     ,ЭКВ *-ТАБДИР

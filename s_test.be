 УИА БФВВ+1(М3)                         ,М3 := БФВВ+1
 УИА -5(М4)       ДЛЯ БЛОКА 'ЗС'        ,М4 := -5
 СЧИ М5                                 ,СМ := М5
 ПВ П8П10(М15)                          ,вызов через М15
 СДА 64-8      НОМЕР СТРОКИ             ,сдвиг СМ влево на 8   
 ИЛИ ТПРОБ                              ,СМ |= ТПРОБ
 ЗП БФВВ         В БФВВ                 ,БФВВ         В БФВВ := СМ
ПИШСТР НОП                              ,НОП

***************************************************
* ПИШСТР                                          *
*   Регистры: М2, М5, М13, М14, М15               *
*   Вход: СБР, СЛ                                 *
*   Выход: ПС(М14) ПИШЕМ СТРОКУ, ПИШСТР ЕЩЕ МОЖНО, КОНВЫД ОПЯТЬ 'ЕТХ'-КОНЕЦ МАССИВА, ЦИКВЫД НЕ ДОШЛИ ДО НИЖНЕЙ ГРАНИЦЫ, КОНВЫД ДОШЛИ ДО ВЕРХНЕЙ ГРАНИЦЫ, ВЫДШАГ(М13) ВЫДАТЬ СТРОКУ *
***************************************************
 ПВ ПС(М14)    ПИШЕМ СТРОКУ             ,вызов через М14
 СЧ РЯЧЗС                               ,СМ := РЯЧЗС
 НТЖ П377                               ,СМ ^= П377
 ПЕ ПИШСТР     ЕЩЕ МОЖНО                ,если СМ≠0 → ПИШСТР     ЕЩЕ 
 СЧ (М1)                                ,СМ := (М1) [косвенно]
 СБР П377(М2)     ВЫБРАЛИ,КАК 'ВС'      ,сборка бит: П377(М2)     ВЫ
 СДА 64+40                              ,сдвиг СМ вправо на 40
 НТЖ П376                               ,СМ ^= П376
 ПО КОНВЫД     ОПЯТЬ 'ЕТХ'-КОНЕЦ МАССИВА  ,если СМ=0 → КОНВЫД     ОПЯТ
 СЧИ М5                                 ,СМ := М5
 НТЖ РЯЧВЫ1                             ,СМ ^= РЯЧВЫ1
 ПЕ ЦИКВЫД     НЕ ДОШЛИ ДО НИЖНЕЙ ГРАНИЦЫ  ,если СМ≠0 → ЦИКВЫД     НЕ Д
 СЧИ М5                                 ,СМ := М5
 НТЖ РЯЧВЫ2                             ,СМ ^= РЯЧВЫ2
 ПО КОНВЫД     ДОШЛИ ДО ВЕРХНЕЙ ГРАНИЦЫ  ,если СМ=0 → КОНВЫД     ДОШЛ
 СЧ РЯЧВЫ1                              ,СМ := РЯЧВЫ1
 СЛ Е1                                  ,СМ += Е1
 ЗП РЯЧВЫ1      НОМЕР ТРЕБУЕМОЙ СТРОКИ  ,РЯЧВЫ1      НОМЕР ТР := СМ
 УИИ М15(М1)                            ,М15 := М1
 УИА БФВВ(М1)                           ,М1 := БФВВ
 УИА ОСЦИКЛ(М14)      ПРИ 'DЕL'-НА ОСЦИКЛ  ,М14 := ОСЦИКЛ
 ПВ ВЫДШАГ(М13)  ВЫДАТЬ СТРОКУ          ,вызов через М13
 УИИ М1(М15)                            ,М1 := М15
 ПБ ЦИКВЫД                              ,переход на ЦИКВЫД
КОНВЫД НОП                              ,НОП


 УИА ПОВТ1(М11)                         ,М11 := ПОВТ1
 УИИ М12(М11)                           ,М12 := М11
 ПБ ПОК1                                ,переход на ПОК1
*
*
*
* ДИРЕКТИВА " О Г Л "
* -------------------
* ВЫДАЧА НА ЭКРАН СВЕДЕНИЙ О ВСЕХ КЛЮЧАХ
ОГЛКЛЮ НОП                              ,НОП

***************************************************
* ОГЛКЛЮ                                          *
*   Регистры: М10, М12                            *
*   Вход: ОГЛКЛ1                                  *
*   Выход: ПОВТ1 ВСЕ ВЫДАНО, ПОК3                 *
***************************************************
 УИА РБПОЛЕ(М10)                        ,М10 := РБПОЛЕ
ОГЛКЛ1 СЛИА 2(М10)                      ,М10 += 2
 СЧ (М10)                               ,СМ := (М10) [косвенно]
 НТЖ ВСЕЕД                              ,СМ ^= ВСЕЕД
 ПО ПОВТ1      ВСЕ ВЫДАНО               ,если СМ=0 → ПОВТ1      ВСЕ 
 НТЖ ВСЕЕД                              ,СМ ^= ВСЕЕД
 ЗП РАЯ41                               ,РАЯ41 := СМ
 УИА ОГЛКЛ1(М12)      ДЛЯ ВОЗВРАТА      ,М12 := ОГЛКЛ1
 ПБ ПОК3                                ,переход на ПОК3
*
*
*
* ДИРЕКТИВА " Ч И Т "
* -------------------
* ПОВТОРНОЕ ЧТЕНИЕ ЗОНЫ КЛЮЧЕЙ
ЧИТКЛЮ НОП                              ,НОП

***************************************************
* ЧИТКЛЮ                                          *
*   Регистры: -                                   *
*   Вход: ЧИТКЛЮ                                  *
*   Выход: ЧТЗ675                                 *
***************************************************
 ПБ ЧТЗ675                              ,переход на ЧТЗ675
*
*
*
* ДИРЕКТИВА " У Б Р "
* -------------------
* УНИЧТОЖЕНИЕ КЛЮЧА С ЗАДАННЫМ ИМЕНЕМ
УБР НОП                                 ,НОП

***************************************************
* УБР                                             *
*   Регистры: М10, М11, М12, М13, М17             *
*   Вход: УБР                                     *
*   Выход: ДАЙИМЯ(М12), ПОК1(М12), УПОРЯД(М17), ВЫДШАГ *
***************************************************
 ПВ ДАЙИМЯ(М12)                         ,вызов через М12
 УИА ПОВТ1(М11)      ДЛЯ ВОЗВРАТА,ЕСЛИ НЕВВЕ  ,М11 := ПОВТ1
 ПВ ПОК1(М12)                           ,вызов через М12
 СЧ 0                                   ,СМ := 0
 ЗП (М10)                               ,запись (Мx) [косвенно]
 ЗП 1(М10)                              ,1 := СМ
 ЗП ШИФРЫ(М10)                          ,ШИФРЫ := СМ
 ЗП ПАРОЛИ(М10)                         ,ПАРОЛИ := СМ
 ПВ УПОРЯД(М17)                         ,вызов через М17
 СЧ ТУБРАН                              ,СМ := ТУБРАН
 ИЛИ П377                               ,СМ |= П377
 ЗП БФВВ                                ,БФВВ := СМ
 УИА БФВВ(М1)                           ,М1 := БФВВ
 УИА ПОВТ1(М13)                         ,М13 := ПОВТ1
 ПБ ВЫДШАГ                              ,переход на ВЫДШАГ
*
*
*
* ДИРЕКТИВА " Н О В "
* -------------------
* ЗАВЕДЕНИЕ НОВОГО КЛЮЧА
НОВКЛЮ НОП                              ,НОП

***************************************************
* НОВКЛЮ                                          *
*   Регистры: М2, М3, М5, М10, М11, М12, М13, М14, М15, М16 *
*   Вход: НОВ1, НОВ2, НОВ3, НОВ6, НОВЦ, НОВ7, НОВЦ1 *
*   Выход: ДАЙИМЯ(М12), ПОК1(М12), ПРИЕМ(М14) ЗА ЧИСЛОМ ТЕРМИНАЛОВ, СЧИТ(М15), ПРОГОН(М14), ВВЧИС(М14) *
***************************************************
 ПВ ДАЙИМЯ(М12)                         ,вызов через М12
 УИА НОВ1(М11)                          ,М11 := НОВ1
 ПВ ПОК1(М12)                           ,вызов через М12
НОВ1 СЧ РАЯ41                           ,СМ := РАЯ41
 ЗП (М10)                               ,запись (Мx) [косвенно]
 СЧ                                     ,СМ := стекло (стек -> SM)
 ЗП 1(М10)                              ,1 := СМ
 ЗП ШИФРЫ(М10)                          ,ШИФРЫ := СМ
 ЗП ПАРОЛИ(М10)                         ,ПАРОЛИ := СМ
 СЧ ТЕРМ                                ,СМ := ТЕРМ
 ЗП БФВВ                                ,БФВВ := СМ
 УИА УБР(М15)                           ,М15 := УБР
 ПВ ПРИЕМ(М14)      ЗА ЧИСЛОМ ТЕРМИНАЛОВ  ,вызов через М14
НОВ2 УИА БФВВ(М3)                       ,М3 := БФВВ
 УИА 40(М2)                             ,М2 := 40
 ПВ СЧИТ(М15)                           ,вызов через М15
 УИА (М16)                              ,М16 := 0
 ПВ ПРОГОН(М14)                         ,вызов через М14
 ПВ ВВЧИС(М14)                          ,вызов через М14
 УИА УБР(М15)      УБРАТЬ,ЕСЛИ НЕ ВВОДЯТ ЧИСЛО ТЕРМИНАЛОВ  ,М15 := УБР
 УИА НОВ2(М14)                          ,М14 := НОВ2
 ПО ОШИБКА      ЧИСЛО ТЕРМИНАЛОВ = 0    ,если СМ=0 → ОШИБКА      ЧИС
 ПВ ПХ108(М15)                          ,вызов через М15
 СДА 64-24                              ,сдвиг СМ влево на 24
 ЗП 1(М10)                              ,1 := СМ
 СЧ ПРИПАС                              ,СМ := ПРИПАС
 ЗП БФВВ                                ,БФВВ := СМ
 УИА УБР(М15)      УБРАТЬ,ЕСЛИ НЕ ВВОДЯТ ПАСПОРТ  ,М15 := УБР
 ПВ ПРИЕМ(М14)                          ,вызов через М14
НОВ3 СЧ БФВВ                            ,СМ := БФВВ
 И П377-3                               ,СМ &= П377-3
 НТЖ П377-3                             ,СМ ^= П377-3
 УИА НОВ3(М14)                          ,М14 := НОВ3
 УИА УБР(М15)                           ,М15 := УБР
 ПЕ ОШИБКА      НЕ ЦИФРА                ,если СМ≠0 → ОШИБКА      НЕ 
 СЧ БФВВ                                ,СМ := БФВВ
 СДА 64+32                              ,сдвиг СМ вправо на 32
 ИЛИ 1(М10)                             ,СМ |= 1(М10)
 ЗП 1(М10)                              ,1 := СМ
 СДА 64+25                              ,сдвиг СМ вправо на 25
 ПО ДЛЯУПО    ОДНОТЕРМИНАЛЬНОЙ СИСТЕМЕ ШИФР НИ К ЧЕМУ  ,если СМ=0 → ДЛЯУПО    ОДНОТ
 СЧ ТШИФР                               ,СМ := ТШИФР
 ЗП БФВВ                                ,БФВВ := СМ
 УИА УБР(М15)      УБРАТЬ,ЕСЛИ НЕ ДАЮТ ШИФР  ,М15 := УБР
 ПВ ПРИЕМ(М14)                          ,вызов через М14
НОВ6 СЧ 0                               ,СМ := 0
 ЗП РАЯ42                               ,РАЯ42 := СМ
 УИА -11(М5)      ДЛЯ ЦИКЛА             ,М5 := -11
 УИА БФВВ(М1)                           ,М1 := БФВВ
 УИА -5(М2)      ДЛЯ БЛОКА 'ВС'         ,М2 := -5
НОВЦ ПВ ВС(М13)                         ,вызов через М13
 ЗП РЯЗС                                ,РЯЗС := СМ
 ВЧОБ П12                               ,СМ := (адрес) - СМ
 УИА НОВ6(М14)                          ,М14 := НОВ6
 УИА УБР(М15)                           ,М15 := УБР
 ПЕ ОШИБКА                              ,если СМ≠0 → ОШИБКА
 СЧ РАЯ42                               ,СМ := РАЯ42
 СДА 64-4                               ,сдвиг СМ влево на 4
 ИЛИ РЯЗС                               ,СМ |= РЯЗС
 ЗП РАЯ42                               ,РАЯ42 := СМ
 ЦИКЛ НОВЦ(М5)                          ,М5-- и если ≠0 → повтор
 СЧ РАЯ42                               ,СМ := РАЯ42
 ЗП ШИФРЫ(М10)                          ,ШИФРЫ := СМ
 СЧ ПРИГЛ                               ,СМ := ПРИГЛ
 ПВ ЗАППАР(М15)                         ,вызов через М15
 ЗП БФВВ                                ,БФВВ := СМ
 НТЖ ЕТХ                                ,СМ ^= ЕТХ
 ПЕ НОВ7      ЕСТЬ ПАРОЛЬ               ,если СМ≠0 → НОВ7      ЕСТЬ 
 СЧ 0                                   ,СМ := 0
 ЗП БФВВ                                ,БФВВ := СМ
НОВ7 УИА -5(М5)      ДЛЯ ЦИКЛА          ,М5 := -5
 УИА БФВВ(М1)                           ,М1 := БФВВ
 УИА -5(М2)      ДЛЯ БЛОКА 'ВС'         ,М2 := -5
НОВЦ1 ПВ ВС(М13)                        ,вызов через М13
 ВЧОБ П12                               ,СМ := (адрес) - СМ
 ПЕ УБР                                 ,если СМ≠0 → УБР
 ЦИКЛ НОВЦ1(М5)                         ,М5-- и если ≠0 → повтор
 ФИНИШ                                  ,конец трансляции

 СЧИ М6                                 ,СМ := М6
 НТЖ РАЯ41                              ,СМ ^= РАЯ41
 ПЕ ДОДВ2                               ,если СМ≠0 → ДОДВ2
 СЧ ЯЧРЕЖ                               ,СМ := ЯЧРЕЖ
 И П60                                  ,СМ &= П60
 НТЖ Е5                                 ,СМ ^= Е5
 ПО ДАЙНОМ     ТО ТНЕ NЕХТ LINЕ         ,если СМ=0 → ДАЙНОМ     ТО Т
 ПБ ОСЦИКЛ     'ВСТ' КОНЧИЛА            ,переход на ОСЦИКЛ     'ВСТ' КОН
ДОДВ2 ПВ ВС(М13)                        ,вызов через М13


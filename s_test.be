*   Регистры: М2                                  *
*   Вход: СБР                                     *
*   Выход: ДОПИС1 ЕМРТУ LINЕ, ДОДВИГ              *
***************************************************
 МОД РАЯ12                              ,мод.адрес по коду: РАЯ12
 УИА (М1)                               ,М1 := 0
 МОД РАЯ13                              ,мод.адрес по коду: РАЯ13
 УИА (М2)                               ,М2 := 0
 СЧ (М1)                                ,СМ := (М1) [косвенно]
 СБР (М2)            РSЕUDО-ВС          ,сборка бит: (М2)           
 НТЖ Е48П41                             ,СМ ^= Е48П41
 ПЕ ДОПИС1           ЕМРТУ LINЕ         ,если СМ≠0 → ДОПИС1         
 СЧ ЯЧРЕЖ                               ,СМ := ЯЧРЕЖ
 НТЖ Е5                                 ,СМ ^= Е5
 ЗП ЯЧРЕЖ                               ,ЯЧРЕЖ := СМ
 ПБ ДОДВИГ                              ,переход на ДОДВИГ
ВЫХОШ НОП                               ,НОП


*РАЯ42 - БАЙТ
 СЧИ М6                                 ,СМ := М6
 ЗП РАЯ41                               ,РАЯ41 := СМ
 СЧИ М2                                 ,СМ := М2
 ЗП РАЯ42                               ,РАЯ42 := СМ

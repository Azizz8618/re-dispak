 СЧ ТЕКПАС                              ,СМ := ТЕКПАС
 ПВ ПИЩИ(М13)                           ,вызов через М13
 ПО ЗАПЗОН                              ,если СМ=0 → ЗАПЗОН
 СЧ ТЕКПАС                              ,СМ := ТЕКПАС
 ПБ ЗАПЗАП                              ,переход на ЗАПЗАП
ЗАППРМ НОП                              ,НОП

***************************************************
* ЗАППРМ                                          *
*   Регистры: М13                                 *
*   Вход: ЗАПЗАП                                  *
*   Выход: ОШПАР ОШИБКА В ПАРАМЕТРЕ, НЕТМРБ, ПИЩИ(М13) ДАЙ АДРЕС, НИЧАВО *
***************************************************
 НТЖ Е40П1                              ,СМ ^= Е40П1
 ПЕ ОШПАР    ОШИБКА В ПАРАМЕТРЕ         ,если СМ≠0 → ОШПАР    ОШИБКА
 СЧ ЯЧРЕЖ                               ,СМ := ЯЧРЕЖ
 И Е2                                   ,СМ &= Е2
 ПО НЕТМРБ                              ,если СМ=0 → НЕТМРБ
 СЧ ТЕКОПЕ                              ,СМ := ТЕКОПЕ
 ПВ ПИЩИ(М13)    ДАЙ АДРЕС              ,вызов через М13
 ПО НИЧАВО                              ,если СМ=0 → НИЧАВО
 ЗП НАЧПТЕ       НАЧАЛО НОВОГО ТЕКУЩЕГО  ,НАЧПТЕ       НАЧАЛО  := СМ
 СЧ РБПОЛЕ                              ,СМ := РБПОЛЕ
 И Е32П1      ОЧИСТИЛИ МЕСТО ДЛЯ ИМЕНИ НОВОГО  ,СМ &= Е32П1      ОЧИСТИЛИ 
 ЗП РБПОЛЕ                              ,РБПОЛЕ := СМ
 СЧ ТЕКОПЕ                              ,СМ := ТЕКОПЕ
 СДА 64-32                              ,сдвиг СМ влево на 32
 ИЛИ РБПОЛЕ                             ,СМ |= РБПОЛЕ
 ЗП РБПОЛЕ                              ,РБПОЛЕ := СМ
 СЧ ТЕКОПЕ                              ,СМ := ТЕКОПЕ
 ЗП ТЕКПАС                              ,ТЕКПАС := СМ
ЗАПЗАП НОП                              ,НОП

***************************************************
* ЗАПЗАП                                          *
*   Регистры: М13                                 *
*   Вход: ЗАПЗАП                                  *
*   Выход: ЗАПАК(М13) УПАКОВАЛИ В ПОЛЕ1, ЗАПЗОН ПОМЕСТИЛСЯ, НМЕСТ *
***************************************************
 ПВ ЗАПАК(М13)    УПАКОВАЛИ В ПОЛЕ1     ,вызов через М13
 ПО ЗАПЗОН    ПОМЕСТИЛСЯ                ,если СМ=0 → ЗАПЗОН    ПОМЕС
 СЧ Е2                                  ,СМ := Е2
 ЗП ЯЧРЕЖ                               ,ЯЧРЕЖ := СМ
 СЧ 0                                   ,СМ := 0
 МОД НАЧПТЕ                             ,мод.адрес по коду: НАЧПТЕ
 ЗП                                     ,(адрес) := СМ
 ПБ НМЕСТ                               ,переход на НМЕСТ
ЗАПЗОН НОП                              ,НОП

***************************************************
* ЗАПЗОН                                          *
*   Регистры: М13                                 *
*   Вход: АIF, Э70, .НЕЗАП                        *
*   Выход: ДАЙЗП(М13) УСТАНОВКА НА ЗАПИСЬ, ГЫН    *
***************************************************
 СЧ МД2053                              ,СМ := МД2053
 Э50 '115'    ЗАХВАТ                    ,'115' ЗАХВАТ
 СЧ МД2053                              ,СМ := МД2053
 ПВ ДАЙЗП(М13)    УСТАНОВКА НА ЗАПИСЬ   ,вызов через М13
 АIF (&Д2212 ЕQ 1).НЕЗАП                ,(&Д2212 ЕQ 1).НЕЗАП
 Э70 ИНФЗА1                             ,ИНФЗА1
 Э70 ИНФЗА2                             ,ИНФЗА2
.НЕЗАП АNОР                             ,АNОР
 СЧ МД2053                              ,СМ := МД2053
 Э50 '116'    ОСВОБОЖДЕНИЕ              ,'116' ОСВОБОЖДЕНИЕ
 ПБ ГЫН                                 ,переход на ГЫН

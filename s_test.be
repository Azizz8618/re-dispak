ОТМ НОП                                 ,НОП

***************************************************
* ОТМ                                             *
*   Регистры: М7, М8, М13, М16                    *
*   Вход: ОТМ                                     *
*   Выход: ДИВВО(М13) ЗА ПАРАМЕТРАМИ, ВЫЧДЛИ(М16) ЗА ДЛИНОЮ, ОШПАР ДИРЕКТИВА БЕЗ ПАРАМЕТРОВ, ОШПАР НЕТ КАРТ, ОТМ8 ДВА ПАРАМЕТРА, ОТМ7 *
***************************************************
 ПВ ДИВВО(М13)    ЗА ПАРАМЕТРАМИ        ,вызов через М13
 ПВ ВЫЧДЛИ(М16)   ЗА ДЛИНОЮ             ,вызов через М16
 СЧ РАЯ1                                ,СМ := РАЯ1
 ПО ОШПАР         ДИРЕКТИВА БЕЗ ПАРАМЕТРОВ  ,если СМ=0 → ОШПАР         Д
 СЧ РАЯ41                               ,СМ := РАЯ41
 ВЧОБ ДСТРОК                            ,СМ := (адрес) - СМ
 ПЕ ОШПАР         НЕТ КАРТ              ,если СМ≠0 → ОШПАР         Н
 СЧ РАЯ1                                ,СМ := РАЯ1
 НТЖ Е1                                 ,СМ ^= Е1
 ПЕ ОТМ8          ДВА ПАРАМЕТРА         ,если СМ≠0 → ОТМ8          Д
 СЧ РАЯ41                               ,СМ := РАЯ41
 ЗП РАЯ42         N2 := N1              ,РАЯ42         N2 :=  := СМ
 ПБ ОТМ7                                ,переход на ОТМ7
ОТМ8 НОП                                ,НОП


***************************************************
* ПДАТ – ПЕЧАТЬ ДАТЫ И ВРЕМЕНИ                   *
*   Формирует текстовое сообщение с датой и       *
*   временем, затем вызывает процедуру печати.    *
*                                                 *
* ИСПОЛЬЗУЕТ:                                       *
*   М16, М15 – счётчики циклов/адреса;             *
*   РЯ1 – рабочая ячейка;                          *
*   ГОД, ДЧАС, ДВРЕМ, С640 – исходные данные.      *
***************************************************
ПДАТ    УИА     3          , разрешить прерывания
        СЧ      ГОД        , загрузить слово ГОД (дата + номер БЭСМ)
        СДА     64-13      , сдвиг влево на 13 разрядов
        РЗБ     ДАТА       , разобрать по маске ДАТА (выделить
* число месяца?)
        ИЛИ     К3         , добавить константу К3 (формат даты)
        ЗП      ТД         , сохранить в ТД (первое слово сообщения)

        СЧ      П17        , загрузить константу 17₈ (маска?)
        СДА     64-20      , сдвиг влево на 20
        И       ГОД        , выделить месяц/год
        СДА     64-4       , сдвиг вправо на 4
        ИЛИ     ТД+1       , добавить к следующему слову
        ЗП      ТД+1       , сохранить во второе слово

        СЧ      ДЧАС       , загрузить время (часы в старших разрядах)
        ИЛИ     С640       , добавить код символа '0' (или пробел?)
        ДЕЛ     ДВРЕМ+5    , разделить на 50 (или 3600? зависит от
* таблицы ДВРЕМ)
        СЛ      С640       , добавить смещение
        УИА     -4(М16)    , цикл по 5 разрядам времени

ПЕРВРЕ  ЗП      РЯ1        , сохранить текущее значение
        МОДА    ДВРЕМ+4    , адрес соответствующего делителя
        ДЕЛ     (М16)      , деление на делитель (сдвинутый на М16)
        СЛ      С640       , добавить код символа
        МОДА    ДЧАС+4     , адрес ячейки времени
        ЗП      (М16)      , сохранить обратно
        РЖА     0          , сброс РАУ
        МОДА    ДВРЕМ+4    , адрес делителя
        УМН     (М16)      , умножить остаток
        РЖА     3          , режим АУ
        ВЧОБ    РЯ1        , обратное вычитание (получить остаток)
        МОДА    ПЕРВРЕ     , цикл
        ЦИКЛ    (М16)      , повторить для всех разрядов

        ЗП      ДЧАС+5     , сохранить последний остаток (секунды?)

        УИА     -5(М16)    , цикл по 6 символам времени
СБРВР   СДА     64-8       , сдвиг влево на 8 (упаковка символа)
        МОДА    ДЧАС+5     , адрес последнего
        ИЛИ     (М16)      , добавить символ
        МОДА    СБРВР      , цикл
        ЦИКЛ    (М16)      ,

        ЗП      ДЧАС       , сохранить упакованное время
        СДА     64-4       , сдвиг
        РЗБ     ОЕЕЕ       , разобрать по маске
        ИЛИ     ТД+2       , добавить к сообщению
        ЗП      ТД+2       , сохранить

        СЧ      ДЧАС       , загрузить время
        СДА     64-32      , сдвиг вправо на 32
        ИЛИ     ТД+3       , добавить к последнему слову
        ЗП      ТД+3       , сохранить

        УИА     ТД-ГЕНС2(М16) , адрес сообщения ТД
        УИА     печмо1-ГЕНС2(М15) , адрес возврата после печати
        ПБ      печмб2     , переход к печати сообщения

***************************************************
* КЛЮЧ, П30, ТД И КОНСТАНТЫ ДЛЯ ПЕЧАТИ ДАТЫ       *
***************************************************
КЛЮЧ    КОНД    П'СТКЛЮЧ' , ключ для зоны статистики
П30     КОНД    В'30'      , номер зоны 30₈ (статистика)
ТД      КОНД    П'400.00'  , начальный шаблон даты

* Условная компиляция для выбора года (1970-е или 1990-е)
        АПУ     (&ОТЛ).ОТЛ1 , если ОТЛ установлен, перейти к .ОТЛ1
        КОНД    П'.20   '   , цифра десятков года (для старых)
        АПБ     .МОД1       , безусловный переход к .МОД1
.ОТЛ1   АНОП
        КОНД    П'.90   '   , цифра десятков года (для 1990-х)
.МОД1   АНОП
        КОНД    П'00.00.'   , продолжение шаблона
        КОНД    П'000   'М24В'21' , последнее слово шаблона

ДЧАС    ПАМ     1          , ячейка для времени (часы)
ДВРЕМ   КОНД    Е'36000'   , таблица делителей для времени:
        КОНД    Е'3600'    ,  3600 (секунды в часе)
        КОНД    Е'600'     ,  600 (минуты)
        КОНД    Е'60'      ,  60 (секунды)
        КОНД    Е'10'      ,  10 (десятки секунд)
        КОНД    Е'50'      ,  50? (единицы?)
ОЕЕЕ    КОНД    Х'0FFF00FFFF00' , маска для выделения времени
С640    КОНД    М42В'64'   , маска для добавления кода '0'

* Рабочие ячейки для печати ресурсов
м50     пам     1           , счётчик направлений?
м51     пам     1           , буфер сообщения
м52     пам     1           , буфер сообщения
м53     пам     1           , буфер сообщения
м54     пам     1           , буфер сообщения
м55     пам     1           , признак конца текста

***************************************************
* ПЕЧМО1 – ПЕЧАТЬ ИНФОРМАЦИИ О РЕСУРСАХ МБ        *
*   Формирует и выводит сообщение о количестве    *
*   трактов на магнитных барабанах по направлениям.*
*                                                 *
* ИСПОЛЬЗУЕТ:                                       *
*   М5, М12, М13, М2, М3, М4, М14 – счётчики;     *
*   ШЗНМБО – таблица занятости трактов;            *
*   ТЕКМБ, ТЕК3 – шаблоны сообщений.               *
***************************************************
ПЕЧМО1  уиа     -1(М5)     , М5 := -1 (цикл по 2 направлениям?)
        уиа     0(М12)     , М12 := 0 (смещение)
        уии     М13(М6)    , М13 := база ГЕНС2
        уиа     1(М2)      , М2 := 1 (номер направления)
трп1    уиа     -7(М4)     , М4 := -7 (цикл по 8 битам)
        уиа     0(М3)      , М3 := 0 (счётчик трактов)
        уиа     -44(М14)   , М14 := -44 (сдвиг для формирования)
        счи     М2         , загрузить номер направления
        сда     64-32      , сдвинуть для помещения в сообщение
        или     ТЕКМБ      , добавить шаблон " 0НМБ- "
        зп      м50-ГЕНС2(М13) , сохранить первое слово сообщения

трп     мода    (М12)      , модификация адреса
        сч      ШЗНМБО+7(М4) , загрузить слово занятости трактов
* (ШЗНМБО+7+М4 с учётом М12)
        и       E48п17     , выделить биты 48-17 (все тракты)
        нтж     E48п17     , инвертировать (тракты, которые НЕ заняты?)
        пе      трп8       , если не все тракты свободны – пропустить

        счи     М3         , загрузить число свободных трактов
        сда     64(М14)    , сдвинуть на М14
        или     м51-ГЕНС2(М13) , добавить к сообщению
ПЕЧМБ   зп      м51-ГЕНС2(М13) , сохранить
        слиа    4(М14)     , следующий сдвиг
трп8    слиа    1(М3)      , увеличить счётчик трактов
        мода    трп        , цикл
        цикл    (М4)       , по 8 словам

        сч      ВСЕЕД      , загрузить все 1
ПЕЧМБ1  слиа    '54'(М14)  , сдвиг для формирования
        сда     64(М14)    , сдвинуть
        или     м51-ГЕНС2(М13) , добавить
        зп      НОМЗ       , сохранить
        рзб     МСК        , разобрать по маске
        зп      м51-ГЕНС2(М13) , сохранить
        сч      НОМЗ       , загрузить
        сда     64-24      , сдвинуть влево на 24
        рзб     МСК        , разобрать
        зп      м52-ГЕНС2(М13) , сохранить
        слиа    3(М13)     , следующая группа
        уиа     8(М12)     , следующее смещение
        слиа    1(М2)      , следующее направление
        мода    трп1       , цикл
        цикл    (М5)       , по направлениям

        сч      м50        , загрузить первое слово сообщения
        нтж     Е44Е43     , скорректировать
        нтж     E41        , бит
        зп      м50        , сохранить
        сч      E2         , установить бит конца
        слц     м55        , добавить к признаку
        зп      м55        , завершить текст
        уиа     м50-генс2(М16) , адрес сообщения
        уиа     ВОЗВВ-генс2(М15) , адрес возврата
ПЕЧМБ2  сли     М16(М6)    , добавить базу
        пб      печ        , перейти к печати

***************************************************
* ВОЗВВ – ПЕЧАТЬ ИНФОРМАЦИИ О РЕСУРСАХ Э256К      *
*   И ОБЩИХ ЛИСТАХ (ТБД, ОЗУ).                     *
***************************************************
ВОЗВВ   сч      ПРЕДЕЛ     , загрузить ПРЕДЕЛ (параметры системы)
        и       E40        , проверить бит 40 (признак Э256К?)
        по      ВОЗВ       , если 0 – к ВОЗВ (обычный выход)

        сч                  , СМ := 0
ВЫХ777  зп      РЯ1        , сбросить счётчик листов
        сч      ГРАНЬБ     , загрузить границу (число листов?)
ПЕРКПЛ  нтж     E5         , проверить бит
        по      ВОЗВ       , если 0 – к ВОЗВ
        нтж     E5         , восстановить
        вч      E5         , вычесть
        вч      E1         , ещё
        вчоб                , дополнение
        уи      М16        , М16 := число трактов
        уиа     0(М15)     , М15 := 0
э256    сч      ШЗНМБО+16(М15) , загрузить шкалу трактов Э256К
        чед     РЯ1        , подсчитать число единиц
        зп      РЯ1        , сохранить
        слиа    1(М15)     , следующая строка
        мода    э256       , цикл
        цикл    (М16)      , по всем
        сда     64-36      , сдвинуть
        рзб     конс       , разобрать
        или     ресэл+1    , добавить к сообщению
        зп      ТЕКМБ      , сохранить
        сч      ресэл      , загрузить начало сообщения
        зп      ТЕК3+2     , сохранить
*
ВОЗВ    ПАМ     0          , точка возврата после подсчёта ресурсов
        СЧ      ТОБ        , загрузить общее число трактов МБ
        СЧ      ТОБ        , (дублирование – опечатка)
        СЛЦ     Е5         , добавить 5
        СДА     64-36      , сдвинуть
        РЗБ     КОНСТ      , разобрать по маске
        СДА     64+8       , сдвинуть обратно
        ИЛИ     ТЕК3+1     , добавить к сообщению о листах
        ЗП      ТЕК3+1     , сохранить
        мода    тек3       , адрес сообщения
        уиа     (м16)      , М16 := адрес
        уиа     '70000'(м6), база ГЕНС
        уиа     '211'(м15) , адрес возврата (или смещение)
ПЕЧ     СЛИ     М15(М6)    , добавить базу
        УИИ     '32'(М15)  , сохранить адрес возврата
        СЧ      Е23        , код нерезидента (выдача на ТТ)
        ПБ      ТВ40       , вызвать печать

***************************************************
* ВЫХОД ИЗ ГЕНС2. ГЕНЕРАЦИЯ ЗАКОНЧЕНА.            *
***************************************************
* НВ, ЛИСТ, ТЕК3, ТЕКМБ И ОСТАЛЬНЫЕ КОНСТАНТЫ.    *
* ЭТО ДАННЫЕ И ШАБЛОНЫ СООБЩЕНИЙ.                 *
***************************************************
НВ      ПАМ     49         , массив для хранения номеров зон
ЛИСТ    КОНД    М17В'1'М12В'34' , константа для формирования КУС
ТЕК3    КОНД    П'4 РЕС:'  , текст "4 РЕС:"
        КОНД    П'  0000'  , пробелы и число
        КОНД    П'↑     '  , завершающий символ
ТЕКМБ   КОНД    П' 0НМБ-' П'4МБ : '
К       КОНД    М38В'1'М26В'1'М18В'1' , маска (биты 38,26,18)
КРАЗ    КОНД    В'5252525252525252' , код для сравнения (разрушение)
К3      КОНД    П'400.00'  , шаблон для даты
КОНСТ   КОНД    П'077777'  , маска для подсчёта
НОМЗ    ПАМ     1          , рабочая ячейка
РЯ1     КОНД    П'БРЗ  0'  , текст "БРЗ  0"
ДАТА    КОНД    М24В'1417'В'417' , маска для даты
МСК     КОНД    В'360741703607417' , маска для разбора
RА      ПАМ     1          , рабочая ячейка
П6      КОНД    М47В'1'В'6' , маска (биты 1-6)
КН      КОНД    М45В'7'В'77777777' , маска (биты 45-? и младшие)
к1      конд    в'0036007300120204' , константа
ресэл   конд    п' (Э - '  , текст " (Э - "
        конд    п'0000)↑'  , продолжение
конс    конд    п'777700'  , маска
Е42П40  КОНД    М39В'7'    , маска битов 42-40
Е48Д46  КОНД    М45В'7'    , маска битов 48-46
П600    КОНД    В'600'     , константа 600₈
КОБ     КОНД    М24В'7770'М12В'23' , КУС для обмена
ЗКВИТ   КОНД    М17В'1'М12В'22' , КУС для квитанций
м36в7   конд    М36В'7'    , маска битов 36-? 7
зкзон1  зп      '1031'(М16) , запись в зону 1031
        зп      '1026'(М16) , запись в зону 1026
        зп      '1027'(М16) , запись в зону 1027
        пб      зкзон2     , переход к продолжению закрытия зон
* КМБ, Е48П33 – закомментированы
***************************************************
* ЭКВИВАЛЕНТНОСТИ АДРЕСОВ И КОНСТАНТ ГЕНС2        *
*                                                 *
*   Эти определения задают символические имена     *
*   для адресов областей памяти и констант,        *
*   используемых при завершении генерации.         *
*                                                 *
*  1. АДРЕСА ОБЛАСТЕЙ:                             *
*    ЗОНРЕЖ = 46000  адрес зоны режима (исходная   *
*                     таблица каналов ВКПХР и      *
*                     таблица МПЗХР).              *
*    ВКПРБ  = 44700  рабочая копия таблицы каналов.*
*                     Размещается на листе 20      *
*                     (44000-45777).               *
*    Л20    = 44000  адрес листа 20 (каталог шифров*
*                     и рабочие таблицы).          *
*    ВКПХР  = ЗОНРЕЖ исходная таблица каналов,     *
*                     загружаемая с диска на лист  *
*                     21 (46000).                  *
*    МПЗХР  = ЗОНРЕЖ+64 = 46064  исходная таблица  *
*                     МПЗ (модулей прерываний),    *
*                     также на листе 21.           *
*    Л21    = 46000  адрес листа 21 (большой       *
*                     каталог ввода, выходные      *
*                     потоки и т.п.).              *
*                                                 *
*  2. КОНСТАНТЫ:                                   *
*    ЧВЫВ   = 1575   число записей в каталоге      *
*                     выходных потоков, которые    *
*                     необходимо обработать.       *
*    еупрвп = е24    маска бита 24 – признак       *
*                     "выходной поток упрятываемой *
*                     задачи". Используется при    *
*                     чистке выходных потоков.     *
***************************************************
        ЭКВИВ (ЗОНРЕЖ,'46000'),(ВКПРБ,'44700'),(Л20,'44000')
        ЭКВИВ (ВКПХР,ЗОНРЕЖ),(МПЗХР,ЗОНРЕЖ+64),(Л21,'46000')
        ЭКВИВ (ЧВЫВ,'1575'),(еупрвп,е24)
*
ДИСП70 ВНЕШ ГОД,ЗОНЫ,МД29М,МЧПЗ,НАПРМГ
ДИСП70 ВНЕШ НОММЛ1,НОММЛ3,ЧПЗ,ШЗНМБ,ЯБКЗПА,КСО
ДИСП70 ВНЕШ ТБУФ,ПРЕДЕЛ,ТУСП,ТЗФСТР
ДИСП70 ВНЕШ Е48П37,Е48П25,П7,П3777,П37,СМШГ
ДИСП70 ВНЕШ (ШИФ,ШИФРМ),СТЗОН,НОММЛ,ШКСВН
ДИСП70 ВНЕШ ШЗНМБО,ТОБ,ТВ40,ЭК30,Е44Е43,Е36П25
ДИСП70 ВНЕШ П17,П177,П3,П777,ВСЕЕД,П7777
ДИСП70 ВНЕШ ЯЧРЖПЛ,П77,ГРАНЬБ
СОСТАВ ВНЕШ ГОДСТ,КЛЮЧСТ,ШКРЗСТ,СЧЕТЧ,
ГЕНС ВНЕШ ОУПР,КУСТ,КАТР,КУСП,КУСПА,КУС1
ГЕНС ВНЕШ АЦП,ДЛТ,НОМРД,ИСКАТ,КУС,ККИЕВ
ГЕНС ВНЕШ ПРРО,П1777,NМЛ,Р3,ШК,ШК1
ДИСКИ ВНЕШ ЕNQ,НОМЛД,РАБМД,DЕQ,Е16П1
ВЗУ ВНЕШ ФИЗЗП,ФИЗОБМ
РОБОТ ВНЕШ ОГ
КАЧКА ВНЕШ Е48П17,ШКРЗ,(Е4817Д,Е48П17)
СОСТАВ ВНЕШ АВОС
кит внеш е39п37,мпрз,мпзс
 ФИНИШ
*КОНЕЦ ЧАСТИ

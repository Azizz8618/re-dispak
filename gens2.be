***************************************************
* НОВОЕ РАСПРЕДЕЛЕНИЕ КАНАЛОВ                     *
*   Переносит информацию о каналах и подключённых  *
*   устройствах из конфигурации (МПЗХР) в рабочие   *
*   таблицы ДИСП70 (МПЗС, МПРЗ, ЯЧРЖПЛ).           *
*                                                 *
* ИСПОЛЬЗУЕТ:                                       *
*   М15 – счётчик циклов (от -7 до 0),              *
*   М16 – номер канала (от 0 до 7),                 *
*   М17 – счётчик циклов (от -63 до 0).             *
***************************************************
        СЧ      ГОД        , загрузить слово ГОД
* (содержит номер БЭСМ и др.)
        И       П7         , выделить младшие 3 бита
        уи      М16        , М16 := номер БЭСМ (0-7)
        СДА     64-3       , сдвинуть влево на 3
        УИ      м15        , М15 := номер БЭСМ * 8 (индекс)
        мода    (м15)      , модификация адреса
        слиа    -9(м16)    , М16 := М16 - 9 (выравнивание)
        уиа     -7(м15)    , М15 := -7 (цикл по 8 каналам)
пемпз   мода    мпзхр(м15) , адрес источника (МПЗХР+М15)
        сч      7(м16)     , загрузить слово из таблицы каналов
        зп      МПЗС+7(м15) , сохранить в МПЗС (рабочая таблица)
        мода    пемпз      , подготовка к циклу
        цикл    (м15)      , цикл по 8 каналам

        уиа     -7(м15)    , снова цикл по 8 каналам
        мода    мпзхр      , адрес источника (МПЗХР)
        сч      8(м16)     , загрузить слово (второй блок)
нпр     ноп                , метка цикла
        зп      Р3         , сохранить в Р3
        и       Е48Д46     , выделить старшие разряды (признаки)
        сда     64+9       , сдвинуть вправо на 9
        нтж     МПРЗ+7(м15) , сравнить/обновить маску
        и       е39п37     , применить маску (биты 39-37)
        нтж     МПРЗ+7(м15) , завершить обновление
        зп      МПРЗ+7(м15) , сохранить
        сч      Р3         , восстановить исходное слово
ПЕРСЧТ  НОП                ,
        сда     64-3       , сдвинуть влево на 3
        мода    нпр        , перейти к следующему
        ЦИКЛ    (М15)      , цикл по 8 каналам

        сч      ЯЧРЖПЛ     , загрузить ЯЧРЖПЛ (режимы ПЛ)
        мода    МПЗХР      , модификация адреса
        нтж     8(М16)     , сравнить с исходным значением
        и       П37        , выделить младшие 5 бит
        нтж     ЯЧРЖПЛ     , обновить
        зп      ЯЧРЖПЛ     , сохранить


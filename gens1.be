*!ЛИС. И МАЛ. ИЗ МОДУЛЯ УДАЛЕНЫ СТР. 398-425, 1345-1348 - АС,
*А ТАКЖЕ СТР. 1239-1245 - ТЕРМАС
***************************************************
* МОДУЛЬ ГЕНС1 – ПРОДОЛЖЕНИЕ ГЕНЕРАТОРА ОС.     *
* ЗАГРУЖАЕТСЯ В ОЗУ ПО АДРЕСУ 60000₈.            *
* ВЫПОЛНЯЕТСЯ ПОСЛЕ ЗАГРУЗКИ ГЕНС.               *
* НАЗНАЧЕНИЕ:                                     *
*  1. НАСТРОЙКА НОМЕРОВ МБ, МЛ, МД.               *
*  2. ФОРМИРОВАНИЕ ТАБЛИЦ ЗАНЯТОСТИ ЛИСТОВ.       *
*  3. НАСТРОЙКА ТЕРМИНАЛЬНЫХ ШКАЛ.                *
*  4. УСТАНОВКА ПАРАМЕТРОВ ОБМЕНА С МД.           *
*  5. ИНИЦИАЛИЗАЦИЯ КОНСТАНТ ТОП И ПРИПИСКИ.     *
*  6. ПОДГОТОВКА К ВЫХОДУ В ДИСПЕТЧЕР.            *
***************************************************
ГЕНС1   СТАРТ   '60000'     , точка входа
        Б                   , начало блока данных
        Е                   , конец программного кода
        М                   , начало программного кода
        УПОТР   ГЕНС1(М6)   , М6 – база модуля (используется
* для адресации внутри ГЕНС1)
        УИА     -1(М17)     , М17 := -1 (цикл по двум значениям
* -1,0 для NМБ и NМБ+1)
        УИА     Н(М10)      , М10 := N (смещение 1024₈, база
* рабочих таблиц в ДИСП70)
        сч      МБКЧТ       , загрузить параметр МБКЧТ
        и       П77         , выделить младшие 6 бит (номер МБ)
        сда     64-12       , сдвинуть влево на 12 разрядов
        зп      СКБЭ(М10)   , сохранить в СКБЭ со смещением
        УИА     -1(М15)     , М15 := -1 (для цикла)
        СЧ      NМБ+1       , загрузить параметр NМБ+1
        СДА     64+12       , сдвинуть вправо на 12 разрядов
        И       П7777(М10)  , выделить младшие 12 бит с учётом
* базы (П7777)
        ПО      МБИМБП      , если 0 – перейти к МБИМБП
        ЗП      NБЛ(М10)    , иначе сохранить в NБЛ (число блоков?
* для NМБ+1)

МБИМБП  СЧ      NМБ+1(М17)  , загрузить параметр (NМБ или NМБ+1
* в зависимости от М17)
        СДА     64-42       , сдвинуть влево на 42 разряда
        РЗБ     НАПРМГ(М10) , разобрать по маске направления МГ
        МОДА    (М10)       , модифицировать адрес
        ЗП      НОММБ+1(М17) , сохранить в НОММБ или НОММБ+1
        мода    МБИМБП      , подготовка к циклу
        цикл    (М17)       , цикл по М17 (-1,0)

        СЧ      NМБ         , загрузить NМБ (информационный МБ)
        СДА     64+6        , сдвинуть вправо на 6 разрядов
        И       П7777(М10)  , выделить младшие 12 бит
        ПЕ      ЛИСОП       , если не 0 – перейти к ЛИСОП
        СЧ      ТРАКТЫ      , иначе загрузить параметр ТРАКТЫ
        СДА     64+9        , сдвинуть вправо на 9 разрядов
        И       П77         , выделить младшие 6 бит (лимит
* для числа листов?)
ЛИСОП   ноп                 , метка продолжения
* на СВС здесь была команда ЗП МАХОЗУ(М10)
        СЧ      МАЛКАТ(М10) , загрузить малый каталог
        ИЛИ     НОММБ(М10)  , добавить номер МБ
        ЗП      МАЛКАТ(М10) , сохранить объединённое значение

        УИА     -'60000'(М14), М14 := -60000₈ (цикл по 3
* системным МЛ: МД загрузки, МД ввода, МД вывода)
МЛМДС   сч      ГЕНС+1      , загрузить базовый адрес ГЕНС+1
        слц     E40         , добавить 40₈ (для МД загрузки?)
        сбр     млдмск      , сбросить маску направления
* (млдмск = М39В'7'М7В'7')
        РЗБ     НАПРМГ(М10) , разобрать по маске направления МГ
        ЗП      РОСМБ       , сохранить в РОСМБ
        СЛЦ     К           , добавить константу К (смещение)
        МОДА    (М10)       , модифицировать адрес
        ЗП      НОММЛ+2(М15) , сохранить в НОММЛ+2 (массив
* системных МЛ)
        мода    МЛМДС       , подготовка к циклу
        ЦИКЛ    (М15)       , цикл по трём МЛ (М15=-3,-2,-1)

        СБР     НАПРМГ(М10) , сбросить поле направления
        ИЛИ     НЛОГ(М10)   , добавить к НЛОГ (логический номер
* направления)
        ЗП      НЛОГ(М10)   , сохранить
        СДА     64+6        , сдвинуть вправо на 6
        ИЛИ     НЛОГ(М10)   , добавить к тому же
        ЗП      НЛОГ(М10)   , обновить НЛОГ
        ЗП      НФИЗ(М10)   , и НФИЗ (физический номер)

        СЧ      НОММЛ+1(М10) , загрузить НОММЛ+1
        СЛЦ     Е31         , добавить 31₈
        ЗП      НОММЛ+1(М10) , сохранить (увеличение номера?

млз1р   СЧ      НОМРД       , загрузить НОМРД (рабочий диск)
        СДА     64+18       , сдвинуть вправо на 18 разрядов
        И       П77         , выделить младшие 6 бит (число кусков)
        ЗП      РАБМД(М14)  , сохранить в РАБМД
        сч      LШЗНМБ      , загрузить константу 60₈ (размер ШЗНМБ)
        ВЧ      ГРАНБ       , вычесть ГРАНБ (граница МБ)
        ВЧ      РАБМД(М14)  , вычесть число кусков
        ПО      ВЛЕЗ        , если 0 – перейти к ВЛЕЗ
        СЛ      РАБМД(М14)  , иначе добавить число кусков
        ЗП      РАБМД(М14)  , сохранить (коррекция)
ВЛЕЗ    НОП
        СЧ      НОМРД       , загрузить НОМРД снова
        И       конст       , маска для сброса числа кусков
* (конст = М2В'45'? уточнить)
        ЗП      НОМРД       , очистить поле числа кусков
        СЧ      РАБМД(М14)  , загрузить скорректированное число
        СДА     64-18       , сдвинуть влево на 18
        ИЛИ     НОМРД       , объединить с оставшимся
        ЗП      НОМРД       , сохранить обновлённый НОМРД

* МЛВ1 (продолжение настройки НОМРД)
        СЧ      НОМРД       , загрузить НОМРД
        И       П7777(М10)  , выделить младшие 12 бит (номер раб.диска)
        ЗП      РАБМД(М14)  , сохранить в РАБМД
        СЧ      ДЛТ         , загрузить ДЛТ (дельта для МДРЗО)
        СДА     64+12       , сдвинуть вправо на 12
        И       Е39П25      , выделить биты 25-39 (дельта)
        ИЛИ     РАБМД(М14)  , добавить к номеру раб.диска
        ЗП      РАБМД(М14)  , сохранить
        СЧ      НОМРД       , загрузить НОМРД
        СДА     64+12       , сдвинуть вправо на 12
        И       П77         , выделить 6 бит (номер начального куска)
        СДА     64-29       , сдвинуть влево на 29
        СЛЦ     РАБМД(М14)  , добавить к РАБМД
        ЗП      РАБМД(М14)  , сохранить

        СЧ      NМЛ+1       , загрузить NМЛ+1
        И       П7777(М10)  , выделить младшие 12 бит (номер МЛ
* ввода/вывода)
        ЗП      НОММЛ(М10)  , сохранить в НОММЛ
        СЧ      СЛОЙК       , загрузить СЛОЙК
        СДА     64+12       , сдвинуть вправо на 12
        И       П7777(М10)  , выделить младшие 12 бит (номер МЛ
* для связи)
        ЗП      НОМСВ(М14)  , сохранить в НОМСВ
        СЧ      СЛОЙК       , загрузить СЛОЙК
        И       Е39П25      , выделить биты 25-39 (дельта для
* МЛ связи?)
        ИЛИ     НОМСВ(М14)  , добавить к НОМСВ
        ЗП      НОМСВ(М14)  , сохранить

        сч      ТРАКТЫ      , загрузить параметр ТРАКТЫ
        и       E28         , проверить бит 28 (СЭВМ)
        по      нетсв       , если 0 – перейти к нетсв
        сч      ШКЗЛ(М10)   , иначе загрузить ШКЗЛ
        или     E20         , установить бит 20
        зп      ШКЗЛ(М10)   , сохранить
        сч      КЛСВ        , загрузить константу КЛСВ
нетсв   зп      КУСЛСВ(М10) , сохранить в КУСЛСВ

        сч      РАСПП       , загрузить РАСПП (таблица страниц ОП)
        или     E25         , установить бит 25
        зп      РАСПП       , сохранить

        уиа     -3(М15)     , М15 := -3 (для старой схемы)
        сч      РАСП1       , загрузить РАСП1 (таблица страниц ОП)
        и       E16         , проверить бит 16
        по      мозу        , если 0 – старая схема, перейти к мозу
        уиа     -14(М15)    , иначе новая схема, цикл по 15 сегм.
сег     сч      РАСП1       , загрузить РАСП1
        и       E34(М15)    , проверить бит для сегмента (сдвиг М15)
        пе      сегозу      , если установлен – сегмент есть
        сч      Е48П17      , иначе загрузить маску «все листы»
        мода    ТОП         , модифицировать адрес ТОП
        зп      ТЗФСТР+15(М15) , записать в ТЗФСТР (закрыть листы
* сегмента)
сегозу  мода    сег         , подготовка к циклу
        цикл    (М15)       , цикл по сегментам

        сч      РАСПП       , загрузить РАСПП
        и       Е48П17      , выделить младшие 16 бит (доступные
* страницы)
        зп      ТЗФСТР+Н    , сохранить в ТЗФСТР (первый сегмент)
        пб      мм6         , перейти к мм6

мозу    сч      РАСП3(М15)  , старая схема: загрузить РАСП3
        и       Е48П17      , выделить младшие 16 бит
        мода    (М10)       , модифицировать
        зп      ТЗФСТР+3(М15) , сохранить в ТЗФСТР (для 0-3 сегм.)
        мода    мозу        , подготовка к циклу
        цикл    (М15)       , цикл по сегментам 0-3

мм6     ноп                 , метка продолжения

        СЧ      СЛОЙК       , загрузить СЛОЙК
        И       Е47П1(М10)  , выделить биты 47-1 (номер МЛ для
* связи?)
        ЗП      БОБСВЗ(М10) , сохранить в БОБСВЗ

        сч      7           , загрузить 7 (тумблерный регистр 7)
        рзб     E19         , разобрать по маске E19 (бит 19)
        зп      ТВ204А+1    , сохранить в ТВ204А+1 (настройка
* обработки прерывания)
        сч      NМБ         , загрузить NМБ
        сда     64+6        , сдвинуть вправо на 6
        и       Е12П1       , выделить младшие 12 бит
        зп      ОС1417(М10) , сохранить в ОС1417
        сч      ТРАКТЫ      , загрузить ТРАКТЫ
        зп      ПРЕДЕЛ(М10) , сохранить в ПРЕДЕЛ (лимит ресурсов)
        и       E37         , проверить бит 37 (графопостроитель)
        по      нетса       , если 0 – перейти к нетса
        сч      ОБВНП3+24-19(М10), загрузить ОБВНП3 (вектор ГП)
        и       Е24П1       , выделить биты 24-1
        или     УХСАLС      , добавить обработчик
        зп      ОБВНП3+24-19(М10) , сохранить
нетса   ноп
        СЧ      НОМРД       , загрузить НОМРД
        УИА     '14000'(М15), М15 := 14000₈ (база для НОМЛД)
        СДА     64+24       , сдвинуть вправо на 24
        И       П7777(М10)  , выделить младшие 12 бит (номер
* рабочего диска)
        ПО      РД          , если 0 – перейти к РД
        ЗП      НОМЛД-'74000'(М15), сохранить в НОМЛД
        СЧ      НОМРД       , загрузить НОМРД
        СДА     64+36       , сдвинуть вправо на 36
        И       П37         , выделить 5 бит (начальный кусок)
        СДА     64-29       , сдвинуть влево на 29
        СЛЦ     НОМЛД-'74000'(М15), добавить к НОМЛД
        ЗП      НОМЛД-'74000'(М15), сохранить
        СЧ      ДЛТ         , загрузить ДЛТ
        И       Е39П25      , выделить дельту
        СЛЦ     НОМЛД-'74000'(М15), добавить к НОМЛД
        ЗП      НОМЛД-'74000'(М15), сохранить

        СЧ      НОМРД       , загрузить НОМРД
        СДА     64+42       , сдвинуть вправо на 42
        ЗП      МД5(М10)    , сохранить в МД5 (число кусков для
* рабочего МД?)
        УИ      М17         , М17 := число кусков
        СЧ      ВСЕЕД       , загрузить все единицы
        СДА     64-48(М17)  , сдвинуть с учётом числа кусков
        ЗП      КУСКИ-'74000'(М15), сохранить в КУСКИ (шкала
* занятости кусков)

РД      ПАМ     0           , метка (на случай отсутствия раб. МД)
        СЧ      КГОД        , загрузить КГОД (год)
        И       Е12П1       , выделить младшие 12 бит
        ЗП      NКОБ-'74000'(М15), сохранить в NКОБ
        СЧ      КГОД        , загрузить КГОД
        И       Е48П17      , выделить биты 48-17
        ЗП      КГОД        , сохранить (очистить младшие биты)

        сч      МБС5        , загрузить МБС5
        сда     64+16       , сдвинуть вправо на 16
        зп      НОМРМД+1-'74000'(М15), сохранить в НОМРМД+1
        сч      УСТРМД      , загрузить УСТРМД
        сда     64+16       , сдвинуть вправо на 16
        зп      НОМРМД-'74000'(М15), сохранить в НОМРМД
        сч      МДС         , загрузить МДС
        и       E45         , проверить бит 45
        зп      нз-б(М15)   , сохранить в нз (со смещением)
        сч      МДС         , загрузить МДС
        и       E44         , проверить бит 44
        зп      нз+1-б(М15) , сохранить в нз+1
        ПО      РДС         , если оба не установлены – к РДС
        СЧ      NМЛ+1       , загрузить NМЛ+1
        СДА     64+43       , сдвинуть вправо на 43
        И       П3          , выделить 2 бита (нужны ли прерывания
* от захвата)
        ИЛИ     МПРП(М10)   , добавить к МПРП
        ЗП      МПРП(М10)   , сохранить

РДС     СЧ      НОМРД       , загрузить НОМРД
        УИА     (М15)       , сбросить М15
        И       П7777(М10)  , выделить номер рабочего диска
        ПО      НЕТРМД      , если нет рабочего МД – перейти
        СЧ      НОМРД       , загрузить НОМРД
        СДА     64+18       , сдвинуть вправо на 18
        И       П37         , выделить число кусков (5 бит)
        УИ      М17         , М17 := число кусков
        УИА     (М14)       , М14 := 0
ТРМД    СЛИА    -1(М17)     , уменьшить счётчик кусков
        СЧ      Е48П17      , загрузить маску «все листы»
        МОД     ГРАНБ       , модифицировать по ГРАНБ
        МОДА    (М17)       , модифицировать по номеру куска
        ЗП      ШЗНМБО(М10) , заполнить шкалу занятости трактов МД
        СЛИА    32(М14)     , увеличить смещение на 32
        ПИНО    ТРМД(М17)   , повторить для всех кусков
        СЧИ     М14         , загрузить суммарное смещение
        ЗП      МАХ         , сохранить в МАХ (общее число трактов
* на МД)

НЕТРМД  НОП                 , нет рабочего МД
        уиа     -2(М17)     , М17 := -2 (цикл по 3 параметрам)
длят    сч      ШКОПТ(М17)  , загрузить ШКОПТ (шкала оп. терм.)
        мода    кач         , модифицировать адрес кач
        зп      ТЗФСТР(М17) , сохранить в ТЗФСТР (для сегментов)
        цикл    длят(М17)   , цикл
        сч      ШКДТ        , загрузить ШКДТ (дуплексные терминалы)
        зп      simplx(М10) , сохранить в simplx (в ТЕРМ)
        мода    кач         , модифицировать адрес
        зп      ТАЙНА+Н     , сохранить в ТАЙНА
        УИА     -62(М15)    , М15 := -62 (цикл по 63 терминалам)
        УИА     -47(М16)    , М16 := -47 (цикл по 48 битам)
* М17 = 0
***************************************************
* БЛОК ФОРМИРОВАНИЯ ШКАЛ ТЕРМИНАЛОВ               *
* И ТАБЛИЦЫ ТАС (ТАБЛИЦА АС).                     *
*   Заполняет ТАС для терминалов, подключённых     *
*   напрямую и через АС (аппаратуру сопряжения).   *
*   Использует шкалы ШКТТ2, ШКVТ2, ШАС128.         *
*                                                 *
* ВХОД: М15 = -62 (для прямых терминалов),         *
*       М16 = -47 (бит внутри шкалы).              *
* ВЫХОД: ЗТТ.                                      *
***************************************************
ТЕРАС   сч      ШКТТ2(М17) , загрузить шкалу ТТ через АС
* (М17 счётчик, сначала 0? потом -1 для след.)
        счи     0          , загрузить 0 (заглушка "надо И Е48+47(М16)")
        пб      НЕТТЕР     , безусловный переход к НЕТТЕР
        сч      NБЭСМ      , загрузить номер БЭСМ
        сда     64+3       , сдвинуть вправо на 3
        счмр                , прочитать РМР (нет, это опечатка?
* команда счмр используется ниже)
НЕТТЕР  мода    ТАС+Н      , модифицировать адрес ТАС+Н
        зп      63(М15)    , записать в ТАС со смещением
* 63+М15 (адрес ячейки таблицы для терминала)
        ПИО     СЛЕДЯП(М16), если М16=0 (бит не установлен) – перейти
        СЛИА    1(М16)     , иначе М16 := М16+1 (следующий бит)
        ЦИКЛ    ТЕРАС(М15) , цикл по 48 битам для каждого терминала

* Для терминалов АС (64-127) используется ШАС128
        сч      РАСП1      , загрузить РАСП1 (признак новой схемы)
        и       E16        , проверить бит 16
        по      ЗТТ        , если 0 – нет АС терминалов, перейти к ЗТТ
        УИА     -1(М17)    , М17 := -1 (для цикла по 2 словам ШАС128)
        УИА     -63(М15)   , М15 := -63 (64 терминала АС)
СЛТЕР   УИА     -47(М16)   , М16 := -47 (бит внутри слова)
СЛИТЕ   СЧ      ШАС128+1(М17), загрузить слово ШАС128 (или +1)
        И       Е48+47(М16), проверить бит (Е48 сдвинут на М16)
        ПО      СЛ17       , если бит не установлен – к СЛ17

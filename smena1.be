	зп	общ-Н(М7)       , СОХРАНИТЬ В СЧЁТЧИКЕ ОБЩИХ МЛ
	сч	0               , ОЧИСТИТЬ
	зп	ПРОМ-Н(М7)      , СБРОСИТЬ ПРОМЕЖУТОЧНЫЙ ФЛАГ

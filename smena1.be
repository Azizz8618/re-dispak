мм      конд    п'2СБРО↑'       , ТЕКСТ СООБЩЕНИЯ "СБРО"
м       сч      ЕС5017          , ПРОВЕРИТЬ, ЕСТЬ ЛИ ЕС-5017
        пе      готес           , ЕСЛИ ДА – К ГОТЕС (ЕСМЛ)
        сч      РМЛ             , ИНАЧЕ ЗАГРУЗИТЬ ШКАЛУ ВКЛЮЧЁННЫХ МЛ
        пб      Б               , ПЕРЕЙТИ К Б (ОБРАБОТКА ИЗМЕНЕНИЙ)


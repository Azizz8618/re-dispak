***************************************************
* МОДУЛЬ ГЕНС – ГЕНЕРАТОР ОС ДИСПАК            *
* ЗАГРУЖАЕТСЯ В ОЗУ ПО АДРЕСУ 70000₈            *
*                                               *
* ОТРЕЗОК I: ИНИЦИАЛИЗАЦИЯ И ПОДГОТОВКА ОБМЕНА  *
*  1. Формирование массива масок E48..E1.        *
*  2. Настройка маски ГРП: разрешение прерывания *
*     по 40-му разряду (таймер/МБ).              *
*  3. Зацикленное ожидание временного прерывания *
*     с одновременным обновлением КРОСП.          *
*  4. После прерывания: определение кода тракта  *
*     ГЕНС из тумблерного регистра 3.            *
*  5. Формирование трёх КУС для обмена с МБ на   *
*     основе ТЗФСТР (занятые листы) и НАПД.       *
*  6. Если запуск НЕ с перфокарт: переход к       *
*     росписи МБ (РОСМБ). Если с перфокарт:       *
*     запись ГЕНС на МБ, затем роспись.           *
*  7. Роспись листов ОЗУ и подсчёт контрольных    *
*     сумм для КЗ1 и КРАХМЛ.                      *
*  8. Настройка УВВ 1,2,22,7 (МБ, МД, внешний     *
*     канал) и ожидание прерываний от МБ (46,45,25).*
*  9. Чтение двух порций данных с МД загрузки по  *
*     КУС "вку" и "вку1", проверка контрольной    *
*     суммы (кс9), затем переход к кукк.           *
***************************************************
ГЕНС    СТАРТ   '70000'     , точка входа генератора
        Б                   , начало блока данных
        М                   , начало программного кода
        Е                   , конец программного кода
*МЫ SЕТА ∧ВS              , комментарий сборки (неактивен)
*∧С УСТВ 1   ИМЕЕТ ДР.СМЫСЛ,ЧЕМ ДЛЯ ОБЩИХ ДИСКОВ СВС
*∧Ф УСТВ 0
*∧НИ УСТВ 0
* GВLВ ∧Р,∧МВВ
*∧МВВ УСТВ 0
*∧Р УСТВ 0
*
***** ИНФОРМАЦИЯ К ГЕНС: *****
*
NМЛ     ЭКВ     '71740'     , номера системных лент
МДС     ЭКВ     '71741'     , номер МД статистики
МВВ     ЭКВ     '71742'     , номер МД ввода
МДВ     ЭКВ     '71743'     , номер МД вывода
ПРОГОН  ЭКВ     '71744'     , режим прогона АЦПУ
СЛОЙК   ЭКВ     '71745'     , вид набивки П/К, N МЛ для связи
МБКЧТ   ЭКВ     '71746'     , нач.N тракта для контроля ЗП на МЛ
ДЛТ     ЭКВ     '71747'     , дельта для РАБМБ МДРЗО
NМБ     ЭКВ     '71747'     , номер программного МБ
ПМБ     ЭКВ     '71750'     , номер программного МБ
РАСПП   ЭКВ     '71751'     , таблица страниц ОП
РАСП1   ЭКВ     '71752'     , таблица страниц ОП (доп.)
ШАС128  ЭКВ     '71753'     , шкала терминалов АС 64Р: 27
РАСП3   ЭКВ     '71754'     , таблица страниц ОП (МОЗУ)
ТРАКТЫ  ЭКВ     '71755'     , мах число трактов и листов для 1 зада.
NБЭСМ   ЭКВ     '71756'     , номер машины, признак часов ИПМ
КГОД    ЭКВ     '71757'     , мл.цифра года, число и нач.N общ.диск
ВЛА     ЭКВ     '71760'     , перв. символы владельца ЭВМ
ВИДМ    ЭКВ     '71761'     , вид подкл.УВВК (заводской или ИПМ)
УСТРМД  ЭКВ     '71762'     , NN устр.МД (48-17РР) 3-го напр.
МБС5    ЭКВ     '71763'     , NN устр.МД (48-17РР) 4-го напр.
НОМРД   ЭКВ     '71764'     , МД раб.зон, раб.МД
ВЛА1    ЭКВ     '71765'     , посл.6 симв.владельца ЭВМ
НОМУСТ  ЭКВ     '71766'     , таблица устройств ТТ и CONSUL
ШКУСТР  ЭКВ     '71767'     , лог. номера терминалов видeoton
ШКОПТ   ЭКВ     '71770'     , шкала операторских терминалов
ШКДТ    ЭКВ     '71771'     , шкала дуплексных терминалов
ШКСВ    ЭКВ     '71772'     , ШКСВМ для ДИСП70 (+1 ячейка для ТБ)
NТАС    ЭКВ     '71773'     , физ. номера терм. АС
ШКТТ    ЭКВ     '71774'     , в 1-й яч занят 48
ШКТТ2   ЭКВ     '71775'     , шкала ТТ через АС
ШКVТ    ЭКВ     '71776'     , заняты 48
ШКVТ2   ЭКВ     '71777'     , шкала ВТ через АС
*
*

        рег     '101'       , БРО = 1, блокировка останова
* при прерывании по АУ (деление на ноль,
* переполнение, контроль числа)
        ржа     '3'         , сброс РАУ
        уиа     1(М16)      , М16 := 1
        счи     М16         , СМ := 1
        сда     64-47       , сдвиг для формирования маски E48
        уиа     -47(М16)    , цикл по 48 разрядам
ИИ      зп      E1(М16)     , формирование массива E48..E1
        сда     64+1        , сдвиг маски вправо
        цикл    ИИ(М16)     , повтор до E1
        пам     0           , выравнивание
        уиа     ФК1МЫ(М3)   , М3 := адрес выхода при врем. прерыв.
        сч                  , СМ := 0
        рег     '37'        , гашение ГРП
        сч      E40         , открытие маски временных прерываний
        рег     '36'        , запись маски ГРП
        уи                  , сброс модификации
ад      уиа     '3'         , разрешить прерывания
        слц     НЕТОБМ      , сложить с кодом текста "НЕТ ОБМЕНА"
        зп      КРОСП       , сохранение кода росписи
        пб      ад          , зацикливание (ожидание прерывания)
ФК1МЫ   сч                  , СМ := 0
        рег     '36'        , гашение маски ГРП
        сч      3           , чтение тумблерного регистра 3
        и       П16         , выделение признака
        зп      КОДТР       , сохранение кода тракта ГЕНС
        уиа     -2(М16)     , цикл по 3 направлениям
фкус    сч      ТЗФСТР+1(М16), загрузка маски занятости листов
        и       НАПД        , выделение битов направлений МБ
        зп      ГЕНС+2(М16) , сохранение в КУС чтения с МБ
        цикл    фкус(М16)   , повтор для всех направлений
        пио     РОСМБ(М13)  , если не с ПК - переход к росписи МБ
        сч      МБС5        , загрузка параметров МБ 5-го направл.
        сда     64+3        , выделение номера МБ
        и       П7          , маска номера устройства
        уи      М16         , М16 := N МБ с инф. и вызовом
        сч      МБС5        , повторная загрузка
        и       П7          , выделение номера МБ
        сда     64-7        , сдвиг для формирования КУС
        зп      КУСБ-1(М16) , сохранение номера МБ в КУС
        сч      МБС5        , загрузка параметров
        сда     64+6        , выделение номера тракта
        и       П37         , маска тракта
        сда     64-2        , сдвиг
        или     E13         , добавление признака чтения
        или     E19         , добавление признака страницы
        или     КУСБ-1(М16) , объединение с номером МБ
        зп      КУСБ-1(М16) , полный КУС записи на МБ
        пв      ЗКМБ(М11)   , запись ГЕНС на МБ
РОСМБ   сч      1           , чтение слова 1 (параметр)
        и       E48         , проверка 48-го разряда
        по      РОСМБ1      , если 0 - переход на роспись МБ
        зп      вж          , установка признака
        уиа     -5120+1(М1) , 5120 = 5 листов
        уиа     -2048+1(М1) , отставить, 2 листа
        сч      дб          , загрузка кода заполнения
росли   зп      '7777'(М1)  , заполнение листов кодом
        цикл    росли(М1)   , цикл по 5 листам
        уиа     -1023(М1)   , 1024 слова
        сч      все1        , код "1111111111111111"
рлс     мода    КЗ1         , адрес КЗ1
        зп      '1777'(М1)  , запись по адресу (КЗ1+смещение)
        цикл    рлс(М1)     , цикл
        уиа     8(М3)       , М3 := 8
        уиа     ТБД(М2)     , М2 := адрес ТБД
        уиа     зз8(М4)     , М4 := адрес перехода
зз      уиа     -1023(М1)   , счётчик слов
        сч                  , СМ := 0
зз1     мода    (М2)        , модификация адреса
        слц     '1777'(М1)  , суммирование
        цикл    зз1(М1)     , цикл
        уиа     -7(М1)      , 8 слов
зпз     мода    7(М1)       , модификация адреса
        зп      (М3)        , запись контрольной суммы
        слц     E1          , добавление 1
        цикл    зпз(М1)     , цикл
        пб      (М4)        , возврат
зз8     уиа     16(М3)      , М3 := 16
        уиа     КРАХМЛ+4(М2), М2 := адрес КРАХМЛ+4
        пв      зз(М4)      , вызов подсчёта контрольной суммы
        уиа     '70'(М3)    , М3 := 70₈
        уиа     КЗ1(М2)     , М2 := адрес КЗ1
        пв      зз(М4)      , подсчёт контрольной суммы
        уиа     -7(М1)      , цикл очистки
выбтз   зп      2           , очистка слов
        цикл    выбтз(М1)   , цикл
        сч      к1          , управляющее слово для УВВ 1 (МБ)
        увв     '1'         , инициализация магнитного барабана 1
        уи                  , сброс модификации
        сч      к2          , управляющее слово для УВВ 2 (МБ)
        увв     '2'         , инициализация магнитного барабана 2
        уи                  , сброс
        сч      6           , управляющее слово для УВВ 22 (МД?)
        увв     '22'        , предположительно сброс/инициализация
* КМД (канала магнитных дисков)
        уи                  , сброс
        сч      к4          , управляющее слово для УВВ 7
        увв     '7'         , управление внешним устройством
* (предположительно канал связи или сброс)
        уи                  , сброс
пупи    рег     '237'       , чтение ГРП
        и       E46         , проверка бита 46 (прерывание от МБ)
        по      пупи        , ожидание
        рег     '237'       , повторное чтение
        и       E45         , проверка бита 45
        по      пупи        , ожидание
        рег     '237'       , повторное чтение
        и       E25         , проверка бита 25
        по      пупи        , ожидание
кукк    уиа     -55(М1)     , цикл по 56 словам
        сч      E5          , загрузка кода E5
росин   зп      '77'(М1)    , роспись области
        цикл    росин(М1)   , цикл
        уиа     -5120+1(М1) , 5 листов
        сч      E12         , загрузка E12
росэ    мода    5120-1(М1)  , модификация адреса
        зп      ТБД         , запись в ТБД
        цикл    росэ(М1)    , цикл
        уиа     -7(М1)      , 8 слов
росэ1   зп      2           , очистка
        цикл    росэ1(М1)   , цикл
        сч                  , СМ := 0
        рег     '37'        , гашение ГРП
        уи                  , сброс
        сч      вку         , загрузка КУС чтения с МД загрузки
        пв      ЧТМД1(М11)  , чтение первой порции данных
        сч      E28         , загрузка E28
        нтж     ВСЕЕД       , инверсия
        рег     '37'        , гашение ГРП
        уи                  , сброс
        сч      вку1        , загрузка КУС чтения с МД загрузки
        или     4           , добавление признака
        пв      ЧТМД1(М11)  , чтение второй порции данных
пов8    сч      E29         , загрузка E29
        нтж     ВСЕЕД       , инверсия
        уи                  , сброс
        рег     '37'        , гашение ГРП
        сч      к1          , управляющее слово для УВВ 1 (МБ)
        увв     '1'         , инициализация магнитного барабана 1
        уи                  , сброс
        сч      к2          , управляющее слово для УВВ 2 (МБ)
        увв     '2'         , инициализация магнитного барабана 2
        уи                  , сброс
        сч      6           , управляющее слово для УВВ 22 (МД?)
        увв     '22'        , предположительно сброс/инициализация
* КМД (канала магнитных дисков)
        уи                  , сброс
        сч      к17         , управляющее слово для УВВ 7
        увв     '7'         , управление внешним устройством
* (предположительно канал связи или сброс)
        уи                  , сброс
ЖДУПРЕ  рег     '237'       , чтение ГРП
        и       E46         , ожидание E46
        по      ЖДУПРЕ     , цикл
        рег     '237'       , чтение
        и       E45         , ожидание E45
        по      ЖДУПРЕ     , цикл
        рег     '237'       , чтение
        и       E25         , ожидание E25
        по      ЖДУПРЕ     , цикл
        рег     '237'       , чтение
        и       E29         , ожидание E29
        по      ЖДУПРЕ     , цикл
        рег     '237'       , чтение
        и       E28         , ожидание E28
        по      ЖДУПРЕ     , цикл
        уиа     4(М16)      , М16 := 4 (направление МД)
        сч      вку         , загрузка КУС чтения с МД
        зп      КУСД1       , сохранение
        пв      ПРЕР(М1)    , вызов ПРЕР (обработка прерывания)
        уиа     3(М16)      , М16 := 3
        сч      вку1        , загрузка КУС чтения с МД
        зп      КУСД1       , сохранение
        пв      ПРЕР(М1)    , вызов ПРЕР
ждупр1  уиа     '70'(М3)    , М3 := 70₈
        уиа     КЗ1(М2)     , М2 := КЗ1
        пв      кс9(М4)     , проверка контрольной суммы
ждупр2  пб      кукк        , переход к началу цикла
*
вж      пам     1           , рабочая ячейка
вку     конд    в'40050001450000' , КУС чтения записи с МД загрузки
вку1    конд    в'2001460000'     , КУС чтения записи с МД загрузки
к1      конд    в'1020400'  , управляющее слово для УВВ 1 (МБ)
к2      конд    в'1030600'  , управляющее слово для УВВ 2 (МБ)
к4      конд    в'1041600'  , управляющее слово для УВВ 7 (внешнее)
        конд    в'1420400'  , управляющее слово для УВВ 1 (МБ)
        конд    в'1430600'  , управляющее слово для УВВ 2 (МБ)
к17     конд    в'1441600'  , управляющее слово для УВВ 7 (внешнее)
все1    конд    в'1111111111111111' , константа "все единицы"
дб      конд    в'4102041020410204' , код заполнения
*
кс9     уиа     -1023(М1)   , цикл по 1024 словам
        сч                  , СМ := 0
кс1     мода    (М2)        , модификация адреса
        слц     '1777'(М1)  , суммирование
        цикл    кс1(М1)     , цикл
        нтж     (М3)        , сравнение с эталоном
        по      (М4)        , если совпало - возврат
        стоп    1           , останов при ошибке КС
        пб      (М4)        , возврат
***************************************************
* РОСМБ1 – ОБОБЩЁННЫЙ ПРИЗНАК РОСПИСИ МБ         *
*  1. Вызов РБ для росписи магнитного барабана.   *
*  2. Переход к СТАТИ для выполнения статистики.  *
*  3. Учёт отбраковки трактов (схема НИТИ).       *
***************************************************
РОСМБ1  УИА     -15(М3)     , М3 := -15 (цикл по 16 трактам)
        ПВ      РБ(М12)     , вызов РБ – обобщённый признак
* росписи МБ
        УИА     (М14)       , М14 := 0
        УИА     СТАТИ(М12)  , М12 := адрес СТАТИ
        сч                  , СМ := 0
        пб      зпд         , переход к зпд (отбраковка трактов)
* для физических МБ по схеме НИТИ
* ДЛЯ ГАШЕНИЯ РЕГИСТРА ДЕФЕКТНОГО ПИТАНИЯ 06.12.2000
СТАТИ   уиа     0(М4)       , М4 := 0
        уиа     куспгс-КУСЧТЗ(М1), КУС для чтения зоны 611 (ПГС)
        пв      ЧТГП(М11)   , чтение ПГС с МД загрузки
        уиа     кусоса-КУСЧТЗ(М1), КУС для чтения ОСА
        пв      ОБМПМБ(М15) , обмен с программным МБ (ОСА)
        уиа     кавмл-КУСЧТЗ(М1), КУС для чтения зоны 725 (АВМЛ)
        пв      ЧТГП(М11)   , чтение АВМЛ
        уиа     кхлам-КУСЧТЗ(М1), КУС для чтения ХЛАМ
        пв      ОБМПМБ(М15) , обмен с программным МБ (ХЛАМ)
* ПЕРЕПИСЬ 712 ЗОНЫ НА 32 ТРАКТ
        уиа     -23(М4)     , М4 := -23 (цикл по 24 зонам)
        УИА     2(М1)       , М1 := 2 (исходный КУС)
        ПВ      ЧТГП(М11)   , чтение зон 561-610 на 01-30 листы
        сч      E44         , проверка 44-го разряда
        или     E45         , или 45-го
        и       МДС         , по маске МДС
        по      зу          , если нет МД статистики – к зу
        сч      E1          , иначе установить признак
        зп      прпе        , (прерывание по приписке)
        уиа     3(М16)      , М16 := 3 (направление)
        пб      зу11        , переход к зу11 (обработка МД)
АЦП     уиа     0(М1)       , М1 := 0
        пв      ОБМИМБ(М15) , обмен с информационным МБ (чтение)
* ЧТЕНИЕ НА 23 ЛИСТ 6 ТРАКТОВ ИНФ. МБ
        УИА     -6(М4)      , М4 := -6 (цикл по 7 зонам)
        УИА     кдисп-КУСЧТЗ(М1), КУС для чтения ДИСП70 и др.
        ПВ      ЧТГП(М11)   , чтение зон 41-47 (ДИСП,КАЧКА,ДИСКИ,КИТ)
***************************************************
* БЛОК ВЫЗОВА НЕРЕЗИДЕНТНЫХ ЧАСТЕЙ                *
* 1. Чтение 1-го нерезидента (зона 552) с МД.      *
* 2. Передача управления нерезиденту по адресу его *
*    загрузки (ЛСТБАЗ).                           *
* 3. После завершения нерезидента управление      *
*    возвращается в ГЕНС, затем читается ГЕНС2.    *
*                                                 *
* ИСПОЛЬЗУЕМЫЕ РЕГИСТРЫ:                           *
* М1 – номер КУС для чтения                        *
* М4 – счётчик циклов                              *
* М6 – базовый адрес нерезидента (ЛСТБАЗ=6000)     *
* М7 – база ГЕНС (70000)                          *
* М11 – адрес возврата после ЧТГП                  *
***************************************************
        УИА     кусг1-КУСЧТЗ(М1), М1 := смещение КУС 1-го нерезид.
М244    УИА     (М4)       , М4 := 0 (разовая операция)
        СЧ      ЛСТБАЗ     , СМ := базовый адрес нерезидента
        СДА     64-2        , сдвиг для вставки в КУС
        ИЛИ     КУСЧТЗ(М1) , объединение с КУС чтения зоны
        ЗП      КУСЧТЗ(М1) , сохранение полного КУС
        СЧИ     М7         , сохранение базы ГЕНС
        ЗП      ЗАПМ7      , в ЗАПМ7
        ПВ      ЧТГП(М11)  , чтение нерезидента с МД загрузки
        СЧ      ЗАПМ7      , восстановление базы ГЕНС
        УИ      М7         , в М7
        СЧ      ЛСТБАЗ     , СМ := адрес загрузки нерезидента
        УИ      М6         , М6 := адрес загрузки
        ПБ      (М6)       , переход к выполнению нерезидента
КОН1    СЧ      ЛСТБАЗ     , после завершения нерезидента:
        СДА     64-2        , подготовка КУС чтения ГЕНС2
        ИЛИ     КУСГ2      , добавление КУС зоны 471
        СЛЦ     НОММЛ      , добавление номера МЛ (диска)
        УИИ     М16(М6)    , М16 := адрес перехода
        ПБ      ФИЗОБМ     , вызов ФИЗОБМ для чтения ГЕНС2
кон2    уиа     24(М1)     , М1 := 24 (следующий нерезидент)
        пб      М244       , переход к чтению следующего
*****
вых777  сч      ЛСТБАЗ     , выход после генерации
        сда     64+10      , выделение номера листа
        уи      М6         , М6 := номер листа (для освобождения)
        уиа     '2003'     , блокировка прерываний
        сч      ТЗФСТР     , загрузка шкалы занятости листов
        нтж     E48(М6)    , снятие бита занятости данного листа
        нтж     ЛИСТА3     , корректировка (листы 22,23,34)
        или     ЗАП20Р     , установка признака листа под ГЕНС
        зп      ТЗФСТР     , сохранение обновлённой шкалы
        пб      НАЧ-НОМБОБ(М7), переход к НАЧ (НОМБОБ)
*** *** *** *** *** *** *** *** *** *** *** ***
*  ПО ОКОНЧАНИИ ГЕНЕРАЦИИ ВЫХОД ЧЕРЕЗ ГЕНС2   *
*** *** *** *** *** *** *** *** *** *** *** ***
А       СЧ      ЛСТБАЗ     , вход для вызова АЛИСТЫ из ГЕНС1
        УИ      М6         , М6 := базовый адрес ГЕНС1
        ПБ      АЛИСТЫ-ГЕНС1(М6), переход к АЛИСТЫ
ПОИСК   СЧ      ЛСТБАЗ     , вход для вызова ПОИСКС из ГЕНС1
        УИ      М6         ,
        ПБ      ПОИСКС-ГЕНС1(М6)
ОБЩГ    СЧ      ЛСТБАЗ     , вход для вызова АОБЩГ из ГЕНС1
        УИ      М6         ,
        ПБ      АОБЩГ-ГЕНС1(М6)
общ1    сч      ЛСТБАЗ     , вход для вызова аобщ1 из ГЕНС1
        уи      М6         ,
        пб      аобщ1-ГЕНС1(М6)
вав     счи     М6         , сохранение М6
        зп      запм6      , в запм6
        сч      ЛСТБАЗ     , СМ := базовый адрес
        уи      М6         , М6 := база
        пб      вав1-ГЕНС1(М6), переход к вав1
запм6   пам     1          , ячейка для сохранения М6
*ПЕРЕПИСЬ СТРАНИЦ  *
* N СТРАНИЦЫ ЧТЕНИЯ В М1
* N СТРАНИЦЫ ЗАПИСИ В М2
* ЧИСЛО СТРАНИЦ ПЕРЕПИСИ В М4
* ВЫХОД ПО М15
*
ПЕРЕПС  УИА     -1023(М17) , счётчик слов в странице (1024)
Б2      МОДА    1023(М17)  , модификация адреса
        СЧ      (М1)       , чтение слова из исходной страницы
        МОДА    1023(М17)  , модификация адреса
        ЗП      (М2)       , запись в целевую страницу
        ЦИКЛ    Б2(М17)    , цикл по всем словам
        СЛИА    1024(М1)   , следующая страница исходная
        СЛИА    1024(М2)   , следующая страница целевая
        ЦИКЛ    ПЕРЕПС(М4) , цикл по числу страниц
        ПБ      (М15)      , возврат
нпк     пам     1          , рабочая ячейка (признак МД 29М)
зу11    уиа     -3(М1)     , цикл по 4 группам (для МДС)
        сч      МДС        , загрузка параметра статистики
        и       E48(М16)   , проверка бита для направления
        по      зун        , если нет – к зун
        сч                  , СМ := 0
        зп      РЯ3        , очистка РЯ3 (шкала ошибок)
зур     мода    -3(М16)    , модификация по направлению
        сч      УСТРМД     , загрузка шкалы устройств МД
        сда     64+16      , выделение поля
        и       Е32П25+3(М1), маска для конкретного устройства
        по      зуст       , если устройство не подключено – к зуст
        уии     М6(М1)     , М6 := номер группы
        слиа    3(М6)      , М6 := +3 (для КУС)
        счи     М6         , СМ := номер устройства
        сда     64-37      , сдвиг для формирования КУС
        зп      КУСД1      , сохранение КУС обмена с МД
        пб      ЗАПР       , переход к ЗАПР (инициализация обмена)
зу1     уиа     -1(М6)     , М6 := -1 (инициализация цикла)
        уиа     3(М11)     , М11 := 3
зус     уии     М4(М6)     , М4 := М6
        слиа    17(М4)     , М4 := +17 (адрес регистра)
        счи     М4         , СМ := адрес регистра
        увв     '20'(М16)  , запись адреса регистра в КМД
        уи                  , сброс
        увв     '4000'(М16), чтение регистра КМД
        уи                  , сброс
        зп      РЯ2        , сохранение прочитанного
        сч                  , СМ := 0
        увв     '20'(М16)  , запись 0 в КМД
        уи                  , сброс
        уиа     -12(М4)    , цикл по 13 разрядам
зу2     слиа    3(М4)     , сдвиг маски
        сч      П7         , загрузка маски
        сда     64(М4)     , сдвиг
        зп      РЯ1        , сохранение маски
        и       РЯ2        , проверка бита
        по      зув        , если 0 – к зув
        сч      NБЭСМ      , загрузка номера ЭВМ
        и       П7         , выделение
        сда     64(М4)     , сдвиг
        нтж     РЯ2        , сравнение с прочитанным
        и       РЯ1        , по маске
        пе      зу3        , если не наша машина – к зу3
        сч      РЯ1        , иначе сбросить бит
        нтж     ВСЕЕД      ,
        и       РЯ2        ,
        зп      РЯ2        , обновлённый регистр
***************************************************
* ЗУВ – НАКОПЛЕНИЕ ОШИБОК И ЗАВЕРШЕНИЕ ОПРОСА     *
*   УСТРОЙСТВ КМД.                                 *
*   В М11 – НОМЕР ПОПЫТКИ (3,2,1,0),               *
*   В РЯ3 – НАКОПЛЕННАЯ ШКАЛА ОШИБОК,              *
*   В РЯ2 – ОБНОВЛЁННОЕ ЗНАЧЕНИЕ РЕГИСТРА КМД.     *
***************************************************
зув     сч      РЯ3        , СМ := накопленная шкала ошибок
        или     E12(М11)   , установить бит E12, сдвинутый
* на номер попытки из М11 (фиксация ошибки)
        зп      РЯ3        , сохранить обновлённую шкалу
зу3     слиа    -1(М11)    , уменьшить номер попытки на 1
        пино    зу2(М4)    , если не 0 – продолжить цикл
* (переход к зу2 с модификацией по М4)
        уии     М4(М6)     , М4 := М6 (индекс устройства)
        слиа    15(М4)     , М4 := М4 + 15 (адрес регистра
* в блоке КМД)
        счи     М4         , СМ := адрес регистра КМД
        увв     '20'(М16)  , выдать адрес регистра в КМД
* (М16 – номер направления МД)
        уи                  , сброс модификации адреса
        сч      РЯ2        , СМ := обновлённое значение
        увв     '20'(М16)  , записать значение в регистр КМД
        уи                  , сброс
        сч                  , СМ := 0
        увв     '20'(М16)  , завершить операцию записи в КМД
        уи                  , сброс
        уиа     7(М11)     , М11 := 7 (восстановить счётчик
* попыток для следующего цикла)
        цикл    зус(М6)    , цикл по устройствам (переход к зус)
        уиа     '61'(М4)   , М4 := 61 (адрес регистра ошибок)
        счи     М4         , СМ := адрес регистра
        увв     '20'(М16)  , выдать адрес в КМД
        уи                  , сброс
        увв     '4000'(М16), прочитать содержимое регистра КМД
        уи                  , сброс
        или     РЯ3        , добавить накопленные ошибки
        нтж     РЯ3        , снять биты, уже учтённые в РЯ3
        зп      РЯ3        , сохранить результирующую шкалу
        уиа     '57'(М4)   , М4 := 57 (адрес регистра маски)
        счи     М4         , СМ := адрес
        увв     '20'(М16)  , выдать адрес в КМД
        уи                  , сброс
        сч      РЯ3        , СМ := обновлённая шкала ошибок
        увв     '20'(М16)  , записать в регистр маски КМД
        уи                  , сброс
        сч                  , СМ := 0
        увв     '20'(М16)  , завершить операцию
        уи                  , сброс
        пв      ОСВКМД(М6) , освободить КМД (снять занятость)
зуст    цикл    зур(М1)    , цикл по всем группам устройств
зун     счи     М16        , СМ := номер направления
        и       E3         , проверить бит E3 (признак 29 МБ?)
        пе      зу4        , если установлен – к зу4
        уиа     4(М16)     , иначе М16 := 4 (переход к след.)
        пб      зу11       , к началу цикла зу11
зу4     сч                  , СМ := 0
        зп      прпе       , сбросить признак прерывания
* по приписке (прпе)
зу      ноп                , метка после обработки МД статистики

***************************************************
* ЗАПОЛНЕНИЕ СЛУЖЕБНЫХ ОБЛАСТЕЙ И ЗАГРУЗКА         *
*   НЕРЕЗИДЕНТОВ С МД НА МБ.                        *
*   М17 – БАЗОВЫЙ АДРЕС ПЧКЗ (50000),               *
*   М1 – НОМЕР КУС, М4 – ЧИСЛО ЗОН.                 *
***************************************************
        УИА     '50000'(М17), М17 := база модуля ПЧКЗ
        СЧ      ВЛА        , СМ := первые символы владельца
        ЗП      ВЛАД-ПЧКЗ(М17), записать в поле ВЛАД
        ЗП      ВЛИ-ЭКСТ-1024(М17), записать в поле ВЛИ
        СЧ      ВЛА1       , СМ := последние 6 символов
        ЗП      ВЛАД+1-ПЧКЗ(М17), записать во вторую ячейку
        ЗП      ВЛИ-ЭКСТ-1023(М17), записать в ЭКСТ
        СЧ      ВЕ-ПЧКЗ(М17), СМ := признак ВЕ
        ЗП      ВЕ1-ЭКСТ-1024(М17), записать в ВЕ1
        СЧ      П17        , СМ := константа П17 (17₈)
        СДА     64-20      , сдвиг влево на 20 разрядов
        И       КГОД       , выделить мл. цифру года
        СДА     64-4       , сдвиг вправо на 4
        ЗП      РЯ3        , сохранить в РЯ3
        СЧ      П17        , снова П17
        СДА     64-16      , сдвиг влево на 16
        И       КГОД       , выделить следующую часть года
        СДА     64-16      , вернуть на место
        ИЛИ     РЯ3        , объединить части
        ИЛИ     ПЧГОД-ПЧКЗ(М17), добавить к существующему
        ЗП      ПЧГОД-ПЧКЗ(М17), записать год в ПЧГОД
        уиа     -23(М4)    , М4 := -23 (24 зоны)
        уиа     0(М1)      , М1 := 0 (исходный КУС)
        пв      ОБМПМБ(М15) , запись 1-30 страниц на 0-27 тракты
        уиа     кцирк-КУСЧТЗ(М1), КУС для чтения ЦИРКУЛ
        пв      ЧТГП(М11)  , чтение ЦИРКУЛ с МД загрузки
        уиа     куспгс-КУСЧТЗ(М1), КУС для чтения ПГС
        пв      ОБМПМБ(М15) , запись ПГС на программный МБ
        уиа     кприк4-КУСЧТЗ(М1), КУС для чтения ПРИК4
        пв      ЧТГП(М11)  , чтение ПРИК4
        уиа     кнеизв-КУСЧТЗ(М1), КУС для чтения неизвестных
* данных
        пв      ОБМПМБ(М15) , запись на программный МБ
        сч      ТРАКТЫ     , СМ := параметры трактов
        и       Е36        , выделить бит 36 (графопостроитель)
        по      устрЕС     , если 0 – графопостроителя нет,
* перейти к обработке ЕС-устройств
        рег     '101'      , заблокировать останов по АУ
        сч      рпг        , СМ := признак РПГ
        зп      '4045'+1024 , записать в ячейку (15 разряд ПРП)
        уиа     кусгп-КУСЧТЗ(М1), КУС для чтения ГП1/ГП4
        пв      ЧТГП(М11)  , чтение ГП1/ГП4
        уиа     кусес-КУСЧТЗ(М1), КУС для чтения ЕС (ОСА)
        пв      ОБМПМБ(М15) , запись на программный МБ
        уиа     куссв7-КУСЧТЗ(М1), КУС для чтения СВЯЗЬ7
        пв      ОБМПМБ(М15) , запись СВЯЗЬ7 на МБ

***************************************************
* УСТРЕС – ПРОВЕРКА ПОДКЛЮЧЕНИЯ ЕС-УСТРОЙСТВ       *
*   (ЕС АЦПУ, ЕСПИ, ЕСПЛ).                          *
*   СЛОЙК – СЛОВО КОНФИГУРАЦИИ,                     *
*   39-й разряд – ПРИЗНАК НАЛИЧИЯ ЕС-УСТРОЙСТВ.     *
***************************************************
устрЕС  сч      СЛОЙК      , СМ := слово конфигурации СЛОЙК
        сда     64+39      , выделить 39-й разряд
        и       П17        , маска 17₈
        по      АЦП        , если 0 – нет ЕС, к АЦП
        уиа     кусес-КУСЧТЗ(М1), КУС для чтения ЕСПИ/ЕСПЛ
        пв      ЧТГП(М11)  , чтение ЕСПИ/ЕСПЛ с МД
        уиа     -1(М14)    , М14 := -1 (цикл по 2 устройствам)
циклес  сч      СЛОЙК      , СМ := СЛОЙК
        и       E40(М14)   , проверить бит E40, сдвинутый
* на М14 (0 для первого, -1 для второго)
        по      нетуст     , если 0 – устройство не подключено
        мода    4(М14)     , модифицировать адрес на 4*М14
        уиа     0(М1)      , М1 := 0 (исходный КУС)
        пв      ОБМПМБ(М15) , запись на программный МБ
нетуст  цикл    циклес(М14), цикл по устройствам ЕС
        пб      АЦП        , возврат к АЦП (продолжение)

***************************************************
* БЛОК ОДНОВРЕМЕННОГО ПОДГОНА ЛЕНТ К РАЗМЕЧЕННОЙ  *
* ЧАСТИ                                            *
* ВХОД: вызывается из основного цикла РОСПМБ при   *
*       наличии прерывания по 40-му разряду ГРП.   *
* ВЫХОД: по М12 (адрес возврата задаётся заранее)  *
* ИСПОЛЬЗУЮТСЯ: М1, М2, М3, М11, М15,              *
*               а также РАУ, ГРП, СЧВЫД, СЧВРЕМ     *
***************************************************
ПОДГ4   рег     '237'      , чтение главного регистра прерываний
        и       E40        , проверка 40-го разряда (таймер)
        по      РОСПМБ    , если не установлен – возврат к росписи
        нтж     ВСЕЕД      , инвертировать прочитанный бит
        уи                  , передать маску в индексный регистр
        рег     '37'       , гашение 40-го разряда ГРП
        сч      СЧВЫД      , загрузить счётчик выданных подгонов
        слц     E1         , увеличить на 1
        зп      СЧВЫД      , сохранить обновлённый счётчик
        сда     64+2       , сдвинуть на 2 вправо (увеличение веса)
        зп      СЧВРЕМ     , записать в счётчик времени
        пб      РОСПМБ    , вернуться к росписи МБ

***************************************************
* БЛОК ЧТЕНИЯ С МД ЗАГРУЗКИ                        *
* НОМЕР КУС НА М1                                   *
* ЧИСЛО ЗОН НА М4, ВЫХОД ПО М11                     *
* ВСПОМОГАТЕЛЬНЫЕ ВХОДЫ:                           *
*   ЧТМДВ – ЧТЕНИЕ С МД ВВОДА (ГЕНС+1)              *
*   ЧТГП  – ЧТЕНИЕ С МД ЗАГРУЗКИ (ГЕНС)             *
***************************************************
ЧТМДВ   уиа     ГЕНС+1(М6) , М6 := адрес ГЕНС+1 (вариант для
* МД ввода)
        пб      ЧТСМД      , переход к общему коду
ЧТГП    уиа     ГЕНС(М6)   , М6 := адрес ГЕНС (вариант для
* МД загрузки)
        пб      ЧТСМД      , переход к общему коду
ЧТСМД   сч      (М6)       , загрузить базовый адрес зоны
        или     КУСЧТЗ(М1) , объединить с КУС (номер зоны и
* начальный адрес в ОЗУ)
ЧТМД1   зп      КУСД1      , сохранить полный КУС обмена с МД
        пв      ЧТМД(М1)   , вызов ЧТМД для выполнения чтения
        сч      КУСД1      , загрузить текущий КУС
        слц     E13        , добавить 1 к номеру зоны
        слц     E25        , добавить 1 к адресу в ОЗУ
* (переход к следующей зоне)
        цикл    ЧТМД1(М4)  , цикл по заданному числу зон (М4)
        сч      ЛСТБАЗ     , восстановить базовый адрес модуля
        уи      М6         , в М6
        пб      (М11)      , возврат по адресу в М11

***************************************************
* ТАБЛИЦА КУС ДЛЯ ЧТЕНИЯ С МД ЗАГРУЗКИ (КУСЧТЗ)   *
* -------------------------------------------------*
* Формат КУС:                                      *
*   М24В'546' – зона 546 (большой каталог ввода)   *
*   М17В'3'   – признак чтения с МД                *
*   М12В'20'  – начальный адрес в ОЗУ (лист 20₈)   *
* -------------------------------------------------*
* ВАЖНО: константы задают начальные параметры,     *
* которые далее модифицируются в ЧТСМД/ЧТМД1.      *
***************************************************
КУСЧТЗ  КОНД    М24В'546'М17В'3'М12В'20' , КУС чтения больш.
* каталога с 'ТЕЛЕ' (зона 546) в лист 20₈
кдисп   КОНД    М24В'621'М17В'3'М12В'1'  , КУС чтения зоны 621
* (ДИСП70,КИТ,ДИСКИ,КАЧКА) на лист 1
кнрез   КОНД    М24В'561'М17В'3'М12В'01' , КУС чтения зон 561-600
* (нерезиденты) на лист 1
кшиф    КОНД    М24В'545'М17В'3'М12В'22' , КУС чтения зоны 545
* (каталог шифров) на лист 22₈

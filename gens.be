*
***** НИТИ 29.08.76 - 12.12.83 *****
*
***************************************************
* ОТБРАКОВКА ТРАКТОВ С АВТОМАТИЧЕСКИМ УПРАВЛЕНИЕМ*
* ДЕФЕКТНОГО ПИТАНИЯ (СХЕМА НИТИ)                *
* ТР3:                                            *
*   27-25 разряды – количество повторений двойного *
*     цикла отбраковки трактов.                    *
*   28 разряд – блокировка двойных циклов          *
*     отбраковки.                                  *
*                                                 *
* ВХОД: вызывается из РОСМБ1 (после РБ).          *
* ИСПОЛЬЗУЕТ: М4, М5, М14, РОСПБ, деф, е10е1.    *
***************************************************
встав1  сч      3           , загрузить ТР3
        и       E29         , проверить 29-й разряд (блокировка
* двойных циклов)
        пе      РОСПМБ     , если установлен, стандартный цикл
* отбраковки (без повторений)
        пам     0           , выравнивание
        сч      3           , снова ТР3
        сда     64+23       , выделить разряды 27-25 (количество
* повторений)
        и       П16         , маска 16₈ (4 бита)
        слц     E1          , +1 (минимум один проход)
        нтж     Е15П1       , инвертировать (для обратного счёта)
        уи      М4          , М4 := количество шагов отбраковки
отбр    счи     М4          , проверить счётчик шагов
        по      зпд         , если 0 – последний шаг
        сч      деф         , загрузить текущее значение деф
        нтж     е10е1       , инвертировать младшие биты (перекл.
* реле дефектного питания)
зпд     зп      деф         , сохранить новое значение деф
        увв     '147'       , установка регистра дефектного питания
        уиа     1(М5)       , М5 := 1 (задержка)
        сч                  , СМ := 0
реле    уи      М14         , задержка для включения реле
        цикл    реле(М5)    , цикл
        сч      E1          , СМ := E1
        зп      РОСПБ       , установить режим росписи
        пб      РОСПМБ     , перейти к повторному циклу отбраковки
деф     конд    в'1771'     , код КМБ 1,2 - управление дефектным
* питанием (2В УВУ КМБ)


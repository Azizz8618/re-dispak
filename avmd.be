***************************************************
* МОДУЛЬ АВМД – АВАРИЙНАЯ ОБРАБОТКА МАГНИТНЫХ ДИСКОВ
* ВЫЗЫВАЕТСЯ ИЗ ДИСКИ ПРИ ОБНАРУЖЕНИИ ОШИБОК ОБМЕНА.
* АДРЕС ЗАГРУЗКИ 20000₈.
***************************************************
АВМД	СТАРТ	'20000'      , начало модуля АВМД (адрес 20000₈)
        Е                           , секция данных (пусто)
        М                           , секция команд
*
	ГБЛВ ∧К71,∧ОТЛ               , глобальные переменные конфигурации
∧К71 УСТВ 1                         , комплекс К-71 включён
***************************************************
* START – ТОЧКА ВХОДА В МОДУЛЬ АВМД.
* ВЫЗЫВАЕТСЯ ИЗ ДИСКИ ПО ПРЕРЫВАНИЮ ИЛИ ПО
* УПРАВЛЯЮЩЕМУ СЛОВУ. СОХРАНЯЕТ КОНТЕКСТ И
* ПЕРЕДАЁТ УПРАВЛЕНИЕ НА ПРОЦЕДУРУ "вд".
* ВХОД: М5 – АДРЕС ПРОЦЕДУРЫ ОБРАБОТКИ ОШИБКИ,
*       М6 – БАЗА МОДУЛЯ ДИСКИ (ИЛИ АДРЕС ВОЗВРАТА),
*       М7 – БАЗА МОДУЛЯ АВМД (ПОСЛЕ УПОТР),
*       М10 – ПАРАМЕТР (ЧАСТО НОМЕР НАПР.).
***************************************************
START	уии	М16(М6)         , сохранить М6 (номер напр.) в М16
	уии	М15(М10)        , сохранить М10 (адрес возврата) в М15
	счи	М7              , загрузить базу АВМД из М7
	зп	ЗАВ             , сохранить в ЗАВ (флаг завершения)
	зп	пав             , сохранить в пав (признак аварии)
	пб	вд(М5)          , переход на обработчик "вд" (адрес из М5)
*
	употр	АВМД(М7)       , объявить рабочий регистр модуля – М7
*
***************************************************
* вд – ИНИЦИАЛИЗАЦИЯ ПЕРЕБОРА УСТРОЙСТВ ДЛЯ ЗАХВАТА.
* УСТАНАВЛИВАЕТ М11 = -1 И ПЕРЕХОДИТ К захус.
***************************************************
вд	уиа	-1(М11)         , М11 := -1 (счётчик устройств для захвата)
	пб	захус           , переход к процедуре захвата
***************************************************
* зхв1 – ЗАВЕРШЕНИЕ ЗАХВАТА УСТРОЙСТВ: ПЕРЕХОД К
* ОСВОБОЖДЕНИЮ УСТРОЙСТВА ИЛИ ВЫВОДУ АВАРИИ.
* ВХОД: М3 – НОМЕР ЛИНИИ (СОХРАНЁН В ПРОЦЕДУРЕ захус).
***************************************************
зхв1	счи	М3              , загрузить номер линии (М3)
	пб	освуст          , переход к освобождению устройства
осв1	сч	ТАБЛО           , для табло: загрузить текущее слово
	пб	авар            , переход к аварийной обработке
зхв1а	уиа	49(М11)         , М11 := 49 (параметр для опроса РС)
	пб	опрд            , переход к опросу устройства
***************************************************
* опрд – ОПРОС ГОТОВНОСТИ УСТРОЙСТВА ДИСКА.
* В ЗАВИСИМОСТИ ОТ К-71 ПЕРЕХОДИТ К РАЗНЫМ БЛОКАМ.
* ВХОД: М16 – НАПРАВЛЕНИЕ, п3700(М16) – БАЗОВЫЙ АДРЕС.
***************************************************
опрд	сч	п3700(М16)      , загрузить признак 29-МБ диска для напр.
*
	 АПУ     (&К71).ДА        , если К-71 включён → .ДА
	 АПБ	.НЕТ                , иначе → .НЕТ
.ДА АНОП
	пе	опрдк7 !В МОТТ        , К-71: переход к обработчику в МОТТ
	счи	М16                  , загрузить номер напр.
.НЕТ АНОП
*
	 АПУ     (&К71).ДА1       , если К-71 → .ДА1 (блок К-71)
******	БЛОК ДЛЯ ШТАТНОЙ РАБОТЫ *****
	по	опд	!ШТАТНЫЙ РЕЖИМ  , если п3700=0 → опд (обычный режим)
	уиа     -7(М14)            , М14 := -7 (счётчик цикла по 8 устр.)
        мод     КНАПР-1(М3)     , модификация по базе напр. (линия)
        уиа     7(М1)           , М1 := 7 (начальное смещение устр.)
опд2  	сч      РМД-3(М16)      , загрузить маску готовности напр.
        мод     КНАПР-1(М3)     , модификация по базе линии
        и       Е32+7(М14)      , выделить бит готовности устр. (М14)
        по      опд1            , если 0 – устройство не готово → опд1
        сч      E25-7(М1)       , загрузить маску ошибки для устр. (М1)
        или     НГД-3(М16)      , добавить к шкале нет готовности
        зп      НГД-3(М16)      , обновить шкалу
        счи     М16             , загрузить номер напр.
        и       E3              , выделить младший бит (чётность)
        сда     64-3            , сдвинуть влево на 3 (индекс напр.)
        уи      М10             , М10 := индекс напр.
        мода    (М10)           , модификация по индексу напр.
        сч      ТЗНМД(М1)       , загрузить таблицу зон МД (устр. М1)
        по      опд1            , если записи нет → опд1
        мода    опди смещение   , загрузить смещение процедуры опди
        пв      (М2)            , вызвать опди (анализ ошибки)
        и       E37             , выделить бит 37 (признак ошибки?)
        сда     64+5(М1)        , сдвинуть с учётом номера устр.
        нтж     РЯД2            , сравнить с накопленной ошибкой
	сч	КОПЗ-3(М16)      , загрузить шкалу запретов напр.
        или       E32(М1)        , установить бит устр. (М1)
        нтж     Е32(М16)        , сбросить бит напр. (коррекция?)
	или	РЯД2            , добавить накопленную ошибку
        зп      КОПЗ-3(М16)     , сохранить обновлённую шкалу запретов
опд1   слиа    -1(М1)           , уменьшить смещение устр.
        мода    опд2
        цикл    (М14)           , цикл по 8 устройствам (М14)
        уиа     49(М11)         , М11 := 49 (опрос состояния)
	счи	М3              , загрузить линию (М3)
	нтж	П3              , инвертировать младшие биты
	сда	64-3            , сдвинуть для формирования индекса
	уи	М10             , М10 := индекс
	сч	НГД-3(М16)      , загрузить шкалу нет готовности
        и     Е32П25(М3)        , выделить биты для линии М3
	сда	64-4            , сдвинуть вправо на 4
	пв                     , вызвать подпрограмму (вероятно, опди)
        зп	рс              , сохранить регистр состояния (РС)
        пв      зсс(М5)         , вызов зсс: чтение регистра состояния
        сч      РЯД2            , загрузить прочитанное значение
        и       П17             , выделить младшие 5 бит
        или     рс              , объединить с полученным РС
        зп      РЯД2            , сохранить итоговое значение
        уиа     47(М11)         , М11 := 47 (запись состояния?)
        уиа     (М5)            , М5 := 0 (сброс)
        пб      чр2             , переход к чр2 (запись/чтение РС)
опд	счи	М16             , штатный режим: загрузить напр.
	зп	С16             , сохранить в С16 (номер напр.)
	и	E3              , выделить младший бит
	уи	М4              , М4 := чётность напр.
	уии	М10(М3)         , сохранить линию (М3) в М10
*****	КОН. БЛОКА ШТАТНОЙ РАБОТЫ *****
	АПБ .НЕТ1
.ДА1 АНОП
***** БЛОК РАБОТЫ К-71 *****
	зп	С16             , сохранить напр. в С16
	и	E3              , выделить младший бит
	уи	М4              , М4 := чётность напр.
	уии	М10(М3)         , сохранить линию в М10
	пам	0	
	счи	М7              , загрузить базу АВМД
	или	опрд1           , добавить адрес опрд1
опрд1	пб	дтпро !В МОТТ        , переход к трассировке процесса (МОТТ)
	зп	13              , сохранить СМ в 13 (резерв)
опрд1a	сч	                , очистить СМ
	мода	кфкус           , загрузить адрес кфкус
	зп	(М16)           , сохранить в кфкус для напр. (М16)
***** КОН. БЛОКА К-71 *****
*
.НЕТ1 АНОП
*
	АПУ     (&К71).ДА1А      , если К-71 → пропуск сброса
	сч	0               , штатный: очистить СМ
	зп	Р !АВМД-100 ЗНАЧ "Р" , сохранить в Р (рабочая)
*
.ДА1А АНОП
	зп	ПРИЗ            , сохранить СМ в ПРИЗ (признак)
	уиа	'2003'          , блокировка прерываний с защитой
	сч	РМД-3(М16)      , загрузить маску готовности напр.
	нтж	РМД1-3(М16)     , сравнить с предыдущей маской
	или	ВЫК-3(М16)      , добавить маску выключенных
	и	НОМРМД-3(М16)   , выделить только рабочие устр.
	и	Е32П25(М10)     , и только для данной линии (М10)
	по	ППЕ             , если нет изменений → ППЕ
	сч	РМД-3(М16)      , иначе: обновить текущую готовность
	или	ВЫК-3(М16)      , учесть выключенные
	и	Е32П25(М10)     , выделить биты линии
	или	РМД1-3(М16)     , добавить к предыдущей маске
	зп	РМД1-3(М16)     , сохранить обновлённую маску
	сч	ВСЕЕД           , сбросить биты в шкале выключенных
	нтж	Е32П25(М10)     , для данной линии
	и	ВЫК-3(М16)
	зп	ВЫК-3(М16)      , обновить шкалу выключенных
	уиа	-7(М4)          , М4 := -7 (счётчик цикла по 8 устр.)
	уиа	ТМЛ-1(М17)      , М17 := адрес ТМЛ-1 (буфер сообщений)
ВМЛ	счи	М16             , цикл по устройствам линии
	и	E3              , выделить младший бит напр.
	сда	64-3            , сдвинуть влево на 3
	уи	М1              , М1 := индекс напр.
	мод	КНАПР-1(М3)     , модификация по базе линии
	уиа	0(М13)          , М13 := 0
	сч	РМД-3(М16)      , загрузить готовность напр.
	и	НОМРМД-3(М16)   , выделить рабочие устр.
	мода	7(М4)           , модификация по счётчику устр.
	и	E32(М13)        , выделить бит данного устр. (М13)
	уиа	'3'             , разрешить прерывания
	пе	ВМЛ2            , если устройство готово → ВМЛ2
	сч	п3700(М16)      , проверить 29-МБ диск
	по	ВМЛ1            , если не 29-МБ → ВМЛ1
	уии	М10(М4)         , для 29-МБ: сохранить счётчик устр.
	мод	КНАПР-1(М3)     , модификация по базе линии
	слиа	7(М10)          , М10 := М10+7 (адрес устр.)
	счи	М10             , загрузить адрес устр.
	нтж	П7              , инвертировать младшие биты
	уи	М5              , М5 := сдвиг
	сч	прр-2(М16)      , загрузить шкалу прерываний напр.
	и	E32(М5)         , выделить бит устр.
	по	ВМЛ1            , если прерываний нет → ВМЛ1
	мода	(М1)            , иначе: загрузить очередь к устр.
	сч	ШОЧМД(М5)       , шкала очереди к устр.
	по	ВМЛ1            , если пуста → ВМЛ1
	сч	РМД1-3(М16)     , есть заказы: установить готовность
	или	E32(М10)        , бит устр.
	зп	РМД1-3(М16)     , обновить маску готовности
ВМЛ1	цикл	ВМЛ(М4)         , следующий устр. (М4+1)
	уиа	'3'             , разрешить прерывания
	сч	ТМД             , загрузить константу "1ПР.МД"
	зп	ТМЛ-1           , сохранить в начало буфера
	зп	ПРИЗ            , сбросить признак
***************************************************
* МЛ1А – ОБРАБОТКА ИЗМЕНЕНИЯ ГОТОВНОСТИ УСТРОЙСТВ
* ЛИНИИ: СБРОС УСТАРЕВШИХ ПРИЗНАКОВ И ЗАПУСК
* ОПРОСА НОВЫХ УСТРОЙСТВ.
* ВХОД: М16 – НАПРАВЛЕНИЕ, М10 – НОМЕР ЛИНИИ,
*       М4 – СЧЁТЧИК УСТРОЙСТВ (ПОСЛЕ ПОИСКА),
*       М13 – НОМЕР УСТРОЙСТВА.
***************************************************
МЛ1А    сч      ЗАНКМД-3(М16)   , загрузить занятость каналов напр.
        сда     64+3            , выделить номер линии (37-39рр)
        и       П3              , оставить 2 бита (0-3)
        уи      М10             , М10 := номер линии
        сч      РМД-3(М16)      , загрузить текущую готовность напр.
        нтж     РМД1-3(М16)     , сравнить с предыдущей (XOR)
        и       НОМРМД-3(М16)   , выделить только рабочие устройства
        и       Е32П25(М10)     , и только для данной линии (М10)
        по      ППЕ             , если изменений нет → ППЕ
        нед     П7              , найти старший бит (номер устр. 0-7)
        уи      М13             , М13 := номер устр. (инвертированный)
        нтж     П7              , преобразовать в прямой номер
        уи      М10             , М10 := номер устр. внутри линии
        счи     М16             , загрузить номер напр.
        и       E3              , выделить младший бит (чётность)
        сда     64-3            , сдвинуть влево на 3
        уи      М1              , М1 := индекс напр. (0 или 8)
        уии     М12(М1)         , М12 := копия индекса напр.
        сли     М1(М10)         , М1 := индекс устройства (напр.+линия+устр)
        уиа     '2003'          , блокировка прерываний
        сч      Е48-8(М13)      , загрузить маску для найденного бита
        нтж     РМД1-3(М16)     , сбросить бит в предыдущей готовности
        зп      РМД1-3(М16)     , обновить
        сч      П23(М16)        , загрузить константу для напр. (П23)
        и       59(М13)         , проверить флаг разметки для устр. (59+М13)
        по      мл1е            , если 0 → мл1е (не разметка)
        сч      ШЗРАЗМ+1        , проверить шкалу разметки
        по      мд              , если 0 → мд
        сда     64+1            , сдвинуть вправо (проверка четности)
        пе      мд              , если не 0 → мд
        сч      РМД1-3(М16)     , иначе: сбросить бит в готовности
        нтж     59(М13)         , (повторно)
        зп      РМД1-3(М16)
        пб      ППЕ
мд      сч      П23(М16)        , загрузить константу П23 для напр.
        сда     64+32           , сдвинуть вправо на 32
        или     E39             , добавить бит E39
        зп      РИ              , сохранить в РИ (признак нового диска)
        сч      ТЗНМД-24(М1)    , загрузить запись о зоне МД (устр. М1)
        пе      МГЗАН           , если есть старая запись → МГЗАН
        уии     М13(М1)         , М13 := индекс устройства
        сч      ШЗРАЗМ+1        , загрузить шкалу задач разметки
        нед                     , найти старший бит (номер задачи)
        уи      М4              , М4 := номер задачи
        слиа    -24(М13)        , скорректировать М13
        счи     М13             , загрузить скорректированный индекс
        сд      КТОМЛ           , сдвинуть по КТОМЛ (для таблицы)
        мод     НЗАД(М4)        , модификация по задаче
        зп      58              , записать в 58-е слово ИПЗ (листы)
        сч      E48             , загрузить бит 48 (признак)
        или     E15             , добавить бит 15
        или     РИ              , добавить признак нового диска
        зп      ТЗНМД-24(М1)    , сохранить в таблицу зон МД
        сч      ШЗРАЗМ+1        , загрузить шкалу разметки
        мода                    , сброс модификации
        пв      ВШГП(М15)       , вернуть задачу в готовность
        сч                      , очистить
        зп      ШЗРАЗМ+1        , сбросить шкалу разметки
ВЫВ     сч      43(М10)         , загрузить 43-е слово (статистика?)
        мода    кфкус           , модификация по кфкус
        или     (М16)           , добавить бит для напр.
        мода    кфкус           , записать обратно
        зп      (М16)           , обновить кфкус напр.
мл2а    уиа     '3'             , разрешить прерывания
        сч      ЗАНКМД-3(М16)   , загрузить занятость каналов
        сда     64+3            , выделить линию
        и       П3
        уи      М10             , М10 := номер линии
        сч      РМД-3(М16)      , загрузить готовность напр.
        нтж     РМД1-3(М16)     , сравнить с предыдущей
        и       НОМРМД-3(М16)   , выделить рабочие
        и       Е32П25(М10)     , и для линии
        пе      МЛ1А            , если есть изменения → МЛ1А
        мода    кфкус           , загрузить кфкус напр.
        сч      (М16)
        по      ППЕ             , если 0 → ППЕ
        нед     Е15П1           , найти старший бит (номер устр. 0-15)
        уи      М10             , М10 := номер устр. (общий)
        счи     М16             , загрузить напр.
        и       E3              , чётность
        сда     64-3            , сдвинуть
        уи      М12             , М12 := индекс напр.
        уиа     '2003'          , блокировка прерываний
        сч      E6              , загрузить бит 6 (событие)
        или     ШКИВ            , добавить в шкалу инициатив
        зп      ШКИВ            , активировать обработку
        уиа     '3'             , разрешить прерывания
        уиа     МЛ4(М11)        , адрес возврата = МЛ4
        сли     М10(М12)        , скорректировать М10 (общий индекс)
МЛ3Е    уиа     ТМЛ-1(М17)      , М17 := адрес буфера сообщения
        сч      ТЗНМД(М10)      , загрузить запись о зоне МД (устр. М10)
        уии     М2(М16)         , сохранить напр.
        и       П7777           , выделить номер пакета (12 бит)
        мода                    , сброс модификации
        пв      ПЕРЕВ(М15)      , перевести номер пакета в двоично-дес.
        или     ТМЛ1            , добавить шаблон "  0000"
        зп      1(М17)          , записать в буфер (1-е слово)
        уии     М16(М2)         , восстановить напр.
        счи     М10             , загрузить индекс устр.
        сда     64-42           , сдвинуть влево на 42
        рзб     МСК2            , разобрать по маске МСК2
        или     ТМЛ1+1          , добавить шаблон " - 00,"
        зп      2(М17)          , записать в буфер (2-е слово)
        пб      (М11)           , возврат
***************************************************
* МГЗАН – ОБРАБОТКА СМЕНЫ ЗОНЫ ДИСКА (СТАРАЯ
* ЗАПИСЬ В ТЗНМД СУЩЕСТВУЕТ). КОРРЕКТИРУЕТ ИНДЕКСЫ
* И ПЕРЕХОДИТ К МДИ (СРАВНЕНИЕ НОМЕРОВ ПАКЕТОВ).
* ВХОД: М1 – ИНДЕКС УСТРОЙСТВА (24–31).
***************************************************
МГЗАН   слиа    -24(М1)         , скорректировать индекс (убрать 24)
        уии     М4(М10)         , сохранить номер линии (М10) в М4
        слиа    -24(М4)         , скорректировать М4
        пб      МДИ             , переход к сравнению пакетов
*
***************************************************
* МЛ4 – ЗАВЕРШЕНИЕ ФОРМИРОВАНИЯ СООБЩЕНИЯ О СМЕНЕ
* ПАКЕТА: ДОБАВЛЕНИЕ ЗНАЧЕНИЯ В БУФЕР, СДВИГ ТМЛ
* И ВЫЗОВ ПРОЦЕДУРЫ РАС (ПЕЧАТЬ РАСПЕЧАТКИ).
***************************************************
МЛ4     сч      E3              , загрузить код 3 (признак конца?)
        слц     2(М17)          , добавить к 2-му слову буфера
        зп      2(М17)          , обновить 2-е слово
        сч      ТМЛ             , загрузить текущее значение ТМЛ
        сда     64-7            , сдвинуть влево на 7
        сда     64+7            , сдвинуть вправо на 7 (очистить лишнее)
        зп      ТМЛ             , сохранить
        уии     М10(М16)        , сохранить напр. (М16) в М10
        уиа     ЕСЧ(М16)        , М16 := адрес ЕСЧ (событие)
        пв      РАС(М2)         , вызов РАС (печать сообщения)
        уии     М16(М10)        , восстановить напр.
        пб      ППЕ             , переход к ППЕ (завершение)
*
***************************************************
* ВМЛ2 – ОБРАБОТКА ГОТОВНОГО УСТРОЙСТВА.
* СНИМАЕТ УСТРОЙСТВО С ОЧЕРЕДЕЙ, УСТАНАВЛИВАЕТ
* ПРИЗНАК ВКЛЮЧЕНИЯ НА ТАБЛО И ВЫЗЫВАЕТ ПЕЧАТЬ.
* ВХОД: М1 – ИНДЕКС НАПР., М4 – СЧЁТЧИК УСТР.,
*       М3 – ЛИНИЯ, М10 – ИНДЕКС УСТРОЙСТВА.
***************************************************
ВМЛ2    счи     М4              , загрузить номер устр. (0-7)
        слц     КНАПР-1(М3)     , добавить базу напр. для линии
        слц     П7              , добавить 7
        нтж     П7              , сбросить младшие биты (выровнять)
        уи      М10             , М10 := индекс устройства
        мода    (М1)            , модификация по напр. (М1)
        сч      ТЗНМД(М10)      , загрузить запись о зоне МД
        по      ВМЛ5            , если пусто – к ВМЛ5 (не обрабатывать)
        и       Е48П42          , выделить номер задачи (43-48рр)
        по      ДАХ             , если 0 (служебная) – к ДАХ
        сли     М10(М1)         , скорректировать индекс (М10=М10+М1)
        сч      ТЗНМД(М10)      , загрузить запись о зоне ещё раз
        или     E40             , установить бит 40 (запрет смены?)
        зп      ТЗНМД(М10)      , обновить
        сч      ШОЧНМД-3(М16)   , снять заказы с очереди напр.
        или     ШОЧМД(М10)
        нтж     ШОЧМД(М10)
        зп      ШОЧНМД-3(М16)
        сч      ЗАНКМД-3(М16)   , загрузить занятость каналов
        сда     64+3            , выделить линию
        уи      М11             , М11 := номер линии
        сч      ШОЧЛ(М11)       , снять заказы с очереди линии
        или     ШОЧМД(М10)
        нтж     ШОЧМД(М10)
        зп      ШОЧЛ(М11)
        сч      ТМЛА            , загрузить константу "ВКЛМД"
        зп      ТМЛ-1           , в начало буфера
        сч      ТАБЛО           , установить признак на табло
        или     E17
        зп      ТАБЛО
        увв     '147'           , вывести на табло
ВТК     мода                    , сброс модификации
        пв      МЛ3Е(М11)       , вызов МЛ3Е (формирование сообщения)
        сч      ТМЛ+1           , загрузить 1-е слово сообщения
        слц     E3              , добавить 3
        зп      ТМЛ+1           , обновить
ВТ      уии     М10(М16)        , сохранить напр.
        уиа     внешпр(М16)     , М16 := адрес внешнего прерывания
        мода                    , сброс модификации
        пв      РАС(М2)         , вызов РАС (печать)
        уии     М16(М10)        , восстановить напр.
        пб      МЛ2АБ           , переход к МЛ2АБ
ДАХ     сч      E1              , загрузить код 1
        зп      ПАР             , сохранить в ПАР (признак)
ВМЛ5    сч      КОПЗ-3(М16)     , загрузить шкалу запретов напр.
        и       E32(М10)        , проверить бит устройства
        пе      ВМЛ1            , если запрещено – к ВМЛ1 (пропустить)
        мода    (М1)            , иначе: записать пустую запись
        зп      ТЗНМД(М10)      , в таблицу зон МД
        пб      ВМЛ1            , вернуться к циклу
***************************************************
* мл1е – ПОДГОТОВКА К ОПРОСУ УСТРОЙСТВА ПРИ
* ОБНАРУЖЕНИИ НЕСООТВЕТСТВИЯ В ЗОНЕ РАЗМЕТКИ.
* ВХОД: М1  – ИНДЕКС УСТРОЙСТВА (СО СМЕЩЕНИЕМ 24),
*       М16 – НОМЕР НАПРАВЛЕНИЯ,
*       М3  – НОМЕР ЛИНИИ (НЕ ИСП. НАПРЯМУЮ),
*       М13 – НОМЕР УСТРОЙСТВА ВНУТРИ ЛИНИИ.
* ВЫХОД: СФОРМИРОВАН КУС ОПРОСА В ТМЛ И КУС2-1(М16).
***************************************************
мл1е    слиа    -24(М1)         , УБРАТЬ СМЕЩЕНИЕ 24: М1 := НОМЕР
*                               , УСТР-ВА В ДИАПАЗОНЕ 0..31 (ДВА НАПР.)
        счи     М1              , ЗАГРУЗИТЬ ЧИСТЫЙ НОМЕР УСТР-ВА
        сда     64-42           , СДВИГ ВЛЕВО НА 42 – ПОМЕСТИТЬ НОМЕР
*                               , УСТР-ВА В РАЗРЯДЫ 43–48 БУДУЩЕГО КУСА
        рзб     НАПРМГ          , РАЗОБРАТЬ ПО МАСКЕ НАПРМГ (40–42РР),
*                               , ЧТОБЫ НОМЕР НАПРАВЛЕНИЯ ПОПАЛ В СВОЁ ПОЛЕ
        или     кфкус           , ДОБАВИТЬ БАЗОВЫЙ КУС ОПРОСА (кфкус)
        зп      ТМЛ             , СОХРАНИТЬ СФОРМИРОВАННЫЙ КУС В ТМЛ

***************************************************
* опрос – ВЫДАЧА КОМАНДЫ ОПРОСА УСТРОЙСТВА.
* ВХОД: ТМЛ – КУС ОПРОСА (ПОДГОТОВЛЕН В мл1е),
*       М16 – НАПРАВЛЕНИЕ, М11 – АДРЕС ВОЗВРАТА (ДВ).
* ВЫХОД: ВЫЗОВ МДНАП, ПЕРЕХОД К "нав" (ДИСКИ).
***************************************************
опрос   сч      ТМЛ             , ЗАГРУЗИТЬ КУС ОПРОСА
        слц     шкавм           , ДОБАВИТЬ ШКАЛУ ОПРОСА (шкавм)
        слц     E43             , ДОБАВИТЬ БИТ 43 (ПРИЗНАК "ОПРОС ПАКЕТА")
        зп      ТМЛ             , ОБНОВИТЬ ТМЛ
        зп      КУС2-1(М16)     , ЗАПИСАТЬ В ТЕКУЩИЙ КУС НАПРАВЛЕНИЯ
        сч                      , ОЧИСТИТЬ СУММАТОР
        зп      типком-3(М16)   , СБРОСИТЬ ТИП КОМАНДЫ (НЕТ АКТИВНОГО ОБМЕНА)
        уиа     ДВ(М11)         , М11 := АДРЕС ВОЗВРАТА (ДВ)
        сч      КУС2-1(М16)     , ЗАГРУЗИТЬ КУС НАПРАВЛЕНИЯ
        пв      МДНАП(М2)       , ВЫЗОВ МДНАП: СФОРМИРОВАТЬ
*                               , М1 (ИНДЕКС УСТР.), М4 (НОМЕР УСТР.),
*                               , М15 (ИНВЕРСНЫЙ НОМЕР)
        сч      Е17П1(М16)      , ЗАГРУЗИТЬ МАСКУ ПРИОРИТЕТА ДЛЯ НАПР.
        и       E32(М4)         , ВЫДЕЛИТЬ БИТ ДАННОГО УСТРОЙСТВА
        уиа     0(М5)           , ПРЕДПОЛОЖИТЬ: УСТР-ВО НЕ ПРИОРИТЕТНОЕ
        по      нав             , ЕСЛИ БИТ СБРОШЕН – ПЕРЕХОД К "нав"
        уиа     1(М5)           , ИНАЧЕ УСТР-ВО ПРИОРИТЕТНОЕ: М5 := 1
        пб      нав             , ПЕРЕХОД К "нав" (ПРОДОЛЖЕНИЕ В ДИСКИ)

***************************************************
* пос/оп/обр2д – ЗАВЕРШЕНИЕ ОПРОСА И СОХРАНЕНИЕ
* ПРОЧИТАННОГО НОМЕРА ПАКЕТА. СБРОС КУСА И ЗАНЯТОСТИ.
* ВХОД: РЯД – ДАННЫЕ ОТ ОПРОСА (ЕСЛИ ВХОД ЧЕРЕЗ оп),
*       ИЛИ СМ ОЧИЩЕН (ЕСЛИ ВХОД ЧЕРЕЗ пос).
* ВЫХОД: РИ – ПРОЧИТАННЫЙ НОМЕР ПАКЕТА,
*       УСТРОЙСТВО И НАПРАВЛЕНИЕ ОСВОБОЖДЕНЫ.
***************************************************
пос     сч                      , ПУТЬ 1: ОЧИСТИТЬ СУММАТОР
        пб      обр2д           , ПЕРЕЙТИ К ОБЩЕМУ КОДУ
оп      сч      РЯД             , ПУТЬ 2: ЗАГРУЗИТЬ ДАННЫЕ ИЗ РЯД
        и       П7777           , ВЫДЕЛИТЬ МЛАДШИЕ 12 БИТ (НОМЕР ПАКЕТА)
обр2д   зп      РИ              , СОХРАНИТЬ ПРОЧИТАННЫЙ НОМЕР ПАКЕТА В РИ
        сч                      , ОЧИСТИТЬ СУММАТОР
        зп      КУС2-1(М16)     , ОСВОБОДИТЬ НАПРАВЛЕНИЕ (СБРОС КУСА)
        зп      типком-3(М16)   , СБРОСИТЬ ТИП КОМАНДЫ
        сч      ВСЕЕД           , ЗАГРУЗИТЬ ВСЕ ЕДИНИЦЫ
        нтж     E32(М4)         , СБРОСИТЬ БИТ УСТРОЙСТВА (М4)
        и       ЗАНМД-3(М16)    , СНЯТЬ УСТРОЙСТВО С ЗАНЯТОСТИ
        зп      ЗАНМД-3(М16)    , ОБНОВИТЬ ШКАЛУ ЗАНЯТОСТИ НАПР.
        сч      п3700(М16)      , ПРОВЕРИТЬ 29-МБ ДИСК (П3700)
        пе      опрди           , ЕСЛИ 29-МБ – ПЕРЕХОД К опрди (СПЕЦ.)

***************************************************
* обрд/ОБЖ – АНАЛИЗ ПРОЧИТАННОГО ПАКЕТА.
* ЕСЛИ ПАКЕТ НЕ НУЛЕВОЙ – К МЛ2; ИНАЧЕ ПОВТОР ОПРОСА
* ИЛИ ФОРМИРОВАНИЕ СООБЩЕНИЯ О СМЕНЕ ДЛЯ 29-МБ.
***************************************************
обрд    сч      РИ              , ЗАГРУЗИТЬ ПРОЧИТАННЫЙ ПАКЕТ
        пе      МЛ2             , ЕСЛИ НЕ 0 – К МЛ2 (ЕСТЬ НОМЕР ПАКЕТА)
ОБЖ     сч      ТМЛ             , ПАКЕТ = 0: ЗАГРУЗИТЬ КУС ОПРОСА
        и       E46             , ПРОВЕРИТЬ БИТ 46 (ПРИЗНАК 29-МБ)
        по      опрос           , ЕСЛИ НЕ 29-МБ – ПОВТОРИТЬ ОПРОС
        счи     М1              , ДЛЯ 29-МБ: СФОРМИРОВАТЬ СООБЩЕНИЕ
        сда     64-42           , ВЫДЕЛИТЬ НОМЕР УСТР. В СТАРШИЕ РАЗРЯДЫ
        рзб     МСК2            , РАЗОБРАТЬ ПО МАСКЕ МСК2 (НОМЕР УСТР.)
        или     ТМЛ1+1          , ДОБАВИТЬ ШАБЛОН " - 00,"
        слц     E3              , УВЕЛИЧИТЬ НА 3 (ФОРМИРОВАНИЕ СТРОКИ)
        зп      ТМЛ             , СОХРАНИТЬ В ТМЛ
        зп      ПРИЗ            , УСТАНОВИТЬ ПРИЗНАК ДЛЯ ПОВТОРНОЙ
*                               , ОБРАБОТКИ (ПРИЗ=1)
        пб      ВТ              , ПЕРЕХОД К ПЕЧАТИ СООБЩЕНИЯ

***************************************************
* МЛ2 – ПРОВЕРКА ДОПУСТИМОСТИ ПАКЕТА И НАЛИЧИЯ
* ПРЕДЫДУЩЕЙ ЗАПИСИ В ТЗНМД ДЛЯ 29-МБ ДИСКОВ.
* ВХОД: РИ – ПРОЧИТАННЫЙ ПАКЕТ, М1 – ИНДЕКС УСТР.,
*       М4 – НОМЕР УСТР., М16 – НАПРАВЛЕНИЕ, М7 – БАЗА АВМД.
* ВЫХОД: ЕСЛИ ПАКЕТ КОРРЕКТЕН И ЕСТЬ ЗАПИСЬ, ОТМЕЧАЕТ
*       УСТРОЙСТВО В ШКАЛАХ ПР; ПЕРЕХОД К МДПО ИЛИ МДИ.
***************************************************
МЛ2     и       E12             , ПРОВЕРИТЬ БИТ 12 В РИ (ПРИЗНАК 29-МБ)
        по      ОБЖ             , ЕСЛИ 0 – ЭТО ОБЫЧНЫЙ ДИСК → ОБЖ
        сч      РИ              , ЗАГРУЗИТЬ ПРОЧИТАННЫЙ ПАКЕТ
        и       П7777           , ВЫДЕЛИТЬ НОМЕР ПАКЕТА
        вчоб    NБЛ             , СРАВНИТЬ С МАКСИМАЛЬНЫМ (NБЛ)
        пе      ОБЖ             , ЕСЛИ БОЛЬШЕ ДОПУСТИМОГО → ОБЖ
        сч      ТЗНМД(М1)       , ЗАГРУЗИТЬ ЗАПИСЬ О ЗОНЕ (УСТР. М1)
        и       E47             , ПРОВЕРИТЬ БИТ 47 (ПРИЗНАК НОВОГО ПАКЕТА)
        уии     М11(М16)        , СОХРАНИТЬ НАПР. В М11
        сли     М11(М7)         , ДОБАВИТЬ БАЗУ АВМД (М11 – ИНДЕКС В ШКАЛАХ)
        по      МДПО            , ЕСЛИ БИТ 47 СБРОШЕН → МДПО (ПУСТАЯ ЗАПИСЬ)
        сч      НМД-3-А(М11)    , ПРОВЕРИТЬ ШКАЛУ НОВЫХ ДИСКОВ (НМД)
        и       E48(М4)         , ДЛЯ ДАННОГО УСТРОЙСТВА (М4)
        пе      МДПО            , ЕСЛИ УЖЕ ОТМЕЧЕНО → МДПО
        сч      E48(М4)         , ИНАЧЕ ОТМЕТИТЬ УСТРОЙСТВО
        или     ПР-3-А(М11)     , В ШКАЛЕ ПР (ПРЕЖНИЕ ПАКЕТЫ)
        зп      ПР-3-А(М11)     , ОБНОВИТЬ ШКАЛУ ПР

***************************************************
* МДПО – ЕСЛИ ЗАПИСЬ В ТЗНМД ОТСУТСТВУЕТ ИЛИ НОВАЯ,
* ПЕРЕХОД К ИНИЦИАЛИЗАЦИИ (МДПМ). ИНАЧЕ – К СРАВНЕНИЮ
* НОМЕРОВ ПАКЕТОВ (МДИ).
* ВХОД: М1 – ИНДЕКС УСТР., М4 – НОМЕР УСТР.
***************************************************
МДПО    сч      ТЗНМД(М1)       , ЗАГРУЗИТЬ ЗАПИСЬ О ЗОНЕ (УСТР. М1)
        уии     М10(М4)         , СОХРАНИТЬ НОМЕР УСТР. В М10
        слиа    24(М10)         , ДОБАВИТЬ 24 (ДЛЯ ИНДЕКСАЦИИ В ДАЛЬНЕЙШЕМ)
        по      МДПМ            , ЕСЛИ ЗАПИСЬ ПУСТА – К МДПМ (ИНИЦИАЛИЗАЦИЯ)

***************************************************
* МДИ – СРАВНЕНИЕ ПРОЧИТАННОГО ПАКЕТА С ОЖИДАЕМЫМ.
* ВХОД: М1 – ИНДЕКС УСТР., М4 – НОМЕР УСТР., РИ – ПРОЧИТАННЫЙ ПАКЕТ.
* ВЫХОД: СОВПАДЕНИЕ → ОСВОБОЖДЕНИЕ УСТРОЙСТВА И ВЫВОД;
*       НЕСОВПАДЕНИЕ → ПЕРЕХОД К мгз (СМЕНА ДИСКА).
***************************************************
МДИ     сч      ТЗНМД(М1)       , ЗАГРУЗИТЬ ОЖИДАЕМЫЙ НОМЕР ПАКЕТА
        нтж     РИ              , СРАВНИТЬ С ПРОЧИТАННЫМ
        и       П7777           , ТОЛЬКО 12 МЛАДШИХ БИТ
        пе      мгз             , НЕ СОВПАДАЕТ → К мгз
        сч      ЗУС-3(М16)      , СОВПАЛО: ПРОВЕРИТЬ ЗАХВАТ УСТР.
        и       E32(М4)
        пе      НЕЛЬЗ           , ЕСЛИ ЗАХВАЧЕНО → НЕЛЬЗ
        сч      РУ-3(М16)       , ИНАЧЕ ОСВОБОДИТЬ УСТРОЙСТВО
        или     E32(М4)
        зп      РУ-3(М16)
НЕЛЬЗ   сч      ТЗНМД(М1)       , СБРОСИТЬ БИТ 40 (УБРАТЬ ПРИЗНАК СМЕНЫ)
        и       О40
        зп      ТЗНМД(М1)
        пб      ВЫВ             , ПЕРЕХОД К ВЫВ (ФИКСАЦИЯ В кфкус)

***************************************************
* мгз – ОБРАБОТКА СМЕНЫ ПАКЕТА.
* ВХОД: М1 – ИНДЕКС УСТР., М4 – НОМЕР УСТР., М11 – ИНДЕКС БАЗЫ,
*       РИ – ПРОЧИТАННЫЙ НОМЕР ПАКЕТА.
* ВЫХОД: УСТАНОВЛЕН БИТ СМЕНЫ, НОВЫЙ ПАКЕТ СОХРАНЁН В нтзнмд,
*       УСТРОЙСТВО ОТМЕЧЕНО В ДР (ДРУГОЙ ПАКЕТ), СБРОШЕНО В ПР.
***************************************************
мгз     сч      E40             , ЗАГРУЗИТЬ БИТ 40 (ПРИЗНАК СМЕНЫ ДИСКА)
        или     ТЗНМД(М1)       , УСТАНОВИТЬ ЕГО В ЗАПИСИ О ЗОНЕ
        зп      ТЗНМД(М1)       , ОБНОВИТЬ: ДИСК СЧИТАЕТСЯ СМЕНЁННЫМ
        сч      РИ              , ЗАГРУЗИТЬ ПРОЧИТАННЫЙ ПАКЕТ
        или     E47             , ДОБАВИТЬ БИТ 47 (ПРИЗНАК НОВОГО ПАКЕТА)
        мода    (М1)            , МОДИФИКАЦИЯ ПО ИНДЕКСУ УСТРОЙСТВА
        зп      нтзнмд          , СОХРАНИТЬ НОВЫЙ ПАКЕТ В ТАБЛИЦЕ НОВЫХ
*                               , ДИСКОВ (нтзнмд, 64 ЗАПИСИ)
        сч      E48(М4)         , ЗАГРУЗИТЬ МАСКУ УСТРОЙСТВА
        или     ДР-3-А(М11)     , УСТАНОВИТЬ БИТ В ШКАЛЕ "ДРУГОЙ ПАКЕТ"
        зп      ДР-3-А(М11)     , ОБНОВИТЬ ШКАЛУ ДР
        сч      ПР-3-А(М11)     , СБРОСИТЬ БИТ В ШКАЛЕ "ПРЕЖНИЙ ПАКЕТ"
        или     E48(М4)
        нтж     E48(М4)
        зп      ПР-3-А(М11)     , ОБНОВИТЬ ШКАЛУ ПР
        уии     М10(М1)         , М10 := ИНДЕКС УСТРОЙСТВА (ДЛЯ ВТК)
        пб      ВТК             , ПЕРЕХОД К ВЫВОДУ СООБЩЕНИЯ О СМЕНЕ
***************************************************
* МДПМ – ИНИЦИАЛИЗАЦИЯ ЗАПИСИ О ЗОНЕ ДЛЯ НОВОГО
* ПАКЕТА (29‑МБ ДИСК). ВХОД: М1 – ИНДЕКС УСТР.,
* РИ – ПРОЧИТАННЫЙ НОМЕР ПАКЕТА, М16 – НАПРАВЛЕНИЕ.
***************************************************
МДПМ    сч      РИ              , загрузить прочитанный номер пакета
        и       Е24П1           , выделить младшие 24 бита (поле пакета)
        или     E15             , добавить бит 15 (признак «пакет задан»)
        ржа     '3'             , сброс РАУ для корректного выполнения
        зп      ТЗНМД(М1)       , сохранить новую запись в таблице зон МД
        и       П7777           , выделить 12 бит номера пакета
        вчоб    NКОБ            , сравнить с максимально допустимым номером
        пе      ПРНОВ           , если пакет больше допустимого → ПРНОВ
        сч      E41             , пакет корректен: загрузить бит 41
        или     ТЗНМД(М1)       , установить признак проверки пакета
        зп      ТЗНМД(М1)       , обновить запись о зоне
ПРНОВ   уиа     '2003'          , блокировка прерываний
        сч      АЗУ             , загрузить счётчик аварийных смен диска
        слц     E1              , увеличить на 1
        зп      АЗУ             , обновить счётчик
        зп      ПАР             , сохранить признак для последующей обработки
        пб      ВЫВ             , перейти к фиксации факта смены

ПАР     пам     1               , ячейка признака аварийной смены диска

***************************************************
* МЛ2АБ – ЗАВЕРШЕНИЕ ЦИКЛА ПРОВЕРКИ УСТРОЙСТВ.
* ЕСЛИ ФЛАГ ПРИЗ ВЗВЕДЁН, ПОВТОРЯЕТ ПРОХОД (мл2а).
* ИНАЧЕ ВОЗВРАЩАЕТСЯ К ВМЛ1 (СЛЕДУЮЩЕЕ УСТРОЙСТВО).
***************************************************
МЛ2АБ   уиа     '3'             , разрешить прерывания
        сч      ПРИЗ            , загрузить флаг повторной обработки
        по      ВМЛ1            , если 0 → ВМЛ1 (следующее устройство)
        пб      мл2а            , иначе → мл2а (повторить проход)

***************************************************
* ППЕ – ФИКСАЦИЯ ЗАВЕРШЕНИЯ ОПРОСА ЛИНИИ.
* ОБНОВЛЯЕТ КФКУС ДЛЯ НАПР., ПРИ НЕОБХОДИМОСТИ
* ГЕНЕРИРУЕТ СОБЫТИЕ (ШАРСИС, СОБА40) И ПЕРЕХОДИТ
* К Д7В (ПРОДОЛЖЕНИЕ ДИСПЕТЧЕРА ДИСКОВ).
***************************************************
ППЕ     мода    кфкус           , адрес кфкус (базовая шкала опроса)
        сч      (М16)           , загрузить текущее слово кфкус напр.
        мода    (М16)
        или     нмд1            , добавить маску новых дисков (нмд1)
        мода    (М16)
        зп      нмд1            , обновить шкалу новых дисков напр.
        сч      ПАР             , проверить признак аварийной смены
        по      НОВД            , если 0 → НОВД (обычное завершение)
        сч                      , иначе: очистить
        зп      ПАР             , сбросить признак
        уии     М13(М16)        , сохранить напр. (М16) в М13
        уии     М1(М17)         , сохранить М17 в М1
        уиа     '2003'          , блокировка прерываний
        сч      ШАРСИС          , загрузить шкалу активных событий
        или     E26             , установить бит 26 (событие «смена диска»)
        зп      ШАРСИС          , обновить шкалу
        сч      СОБА40          , загрузить код события архивирования (СОБА40)
        пв      ЗАПВЕТ(М16)     , установить событие для задачи
        уии     М16(М13)        , восстановить напр.
        уии     М17(М1)         , восстановить М17

НОВД    счи     М16             , загрузить номер напр.
        зп      С16             , сохранить в С16 (для последующих входов)
        сч                      , очистить
        зп      типком-3(М16)   , сбросить тип команды напр.
        пб      Д7В             , перейти к Д7В (продолжение диспетчера)

***************************************************
* НОВ – ВХОД ПО ЗАВЕРШЕНИИ ОБМЕНА С ДИСКОМ.
* ПРОВЕРЯЕТ НЕИСПРАВНОСТЬ МД, СБРАСЫВАЕТ ФЛАГИ
* И ЗАПУСКАЕТ ЦИКЛ ОПРОСА ГОТОВНОСТИ.
***************************************************
НОВ     сч      ЗАВ             , загрузить сохранённый адрес (из ЗАВ)
        уи      М7              , восстановить базу модуля АВМД в М7
        сч      ШЗПОМД          , загрузить шкалу задержки МД
        или     E24             , установить бит 24 (запрос опроса)
        нтж     E24             , сбросить его (снять запрос)
        зп      ШЗПОМД          , обновить шкалу
        сч      МДНЕИС-3(М15)   , загрузить неисправность МД (М15 – устр.)
        пе      ДКО             , если неисправен → ДКО (обработка в МОТТ)
        сч      СОД             , загрузить состояние обмена
        или     типком-3        , добавить тип команды
        и       П377            , выделить поле подвода
        пе      ЗАН             , если есть подвод → ЗАН (завершение)
        уиа     0(М15)          , иначе сбросить М15
        сч      С16             , загрузить сохранённый напр.
        уи      М16             , восстановить номер напр.
        и       E3              , проверить младший бит (чётность)
        пе      НОК             , если 1 → НОК (29-МБ или другое напр.)
        уиа     4(М16)          , для чётного: переключить на напр. 4
        сч      НОМРМД-3(М16)   , загрузить рабочие устройства напр. 4
        пе      ДКК             , если есть → ДКК (опрос готовности)

НОК     сч      ШЗПОМД          , загрузить шкалу задержки
        или     E40             , установить бит 40 (признак занятости)
        зп      ШЗПОМД          , обновить
        сч      ВЫ              , проверить флаг вывода
        пе      НОВК            , если уже выводили → НОВК
        сч      ШКСВН           , иначе: загрузить шкалу занятости нерезидентов
        или     E26             , установить бит 26 (АВМД)
        зп      ШКСВН           , отметить модуль как занятый
        сч      РМЛ             , загрузить маску прерываний МЛ
        или     Е47П43          , установить биты 47-43
        зп      РМЛ             , обновить
        зп      ВЫ              , запомнить в ВЫ (флаг вывода)

НОВК    уиа     0(М3)           , М3 = 0 (счётчик линий)
        уиа     3(М16)          , М16 = 3 (первое напр.)

нру     уиа     0(М17)          , М17 = 0 (номер линии)
        уиа     0(М12)          , М12 = 0 (смещение в таблицах)
        сч      п3700(М16)      , проверить 29-МБ диск напр.
        пе      вку1            , если 29-МБ → вку1
нру1    сч      РАЗЛ(М16)       , загрузить шкалу различий напр.
        и       Е32П25(М17)     , выделить биты линии М17
        пе      освус           , если есть различия → освободить устройство
вку     счи     М17             , загрузить номер линии
        нтж     П3              , инвертировать младшие биты
        по      вку1            , если 0 → вку1 (линия обработана)
        слиа    1(М17)          , иначе: следующая линия
        слиа    1(М3)           , увеличить счётчик линий
        пб      нру1            , повторить

вку1    уиа     4(М3)           , М3 = 4 (линий в напр.)
        счи     М16             , загрузить напр.
        уиа     4(М16)          , переключить на напр. 4
        и       E3              , проверить чётность старого напр.
        по      нру             , если чётное → нру (следующий напр.)
        уиа     -1(М3)          , иначе: М3 = -1 (для цикла по напр.)

нв1     уии     М16(М3)         , М16 = индекс напр. (со сдвигом)
        сли     М16(М7)         , добавить базу модуля АВМД

НВ2     сч      Е44Е43(М16)     , загрузить маску изменений напр.
        уиа     '3'             , разрешить прерывания
        по      нв3             , если пусто → нв3 (завершение)
        уиа     0(М13)          , иначе: М13 = 0
        уиа     0(М14)          , М14 = 0
        нед     Е15П1           , найти старший бит (номер устройства)
        уи      М10             , М10 := номер устройства (общий)
        сч      ВТОР            , загрузить флаг второго прохода
        пе      нв2а            , если не 0 → нв2а (второй проход)
        сч      ШКЗАКС(М16)     , загрузить шкалу заказов напр.
        и       E48(М10)        , проверить бит устройства
        пе      НОВ1            , если заказано → НОВ1 (уже обрабатывается)

нв20    уиа     -1(М11)         , М11 = -1 (счётчик для поиска)
        уиа     -32(М2)         , М2 = -32 (смещение в таблице зон)
нв      уиа     -31(М4)         , М4 = -31 (счётчик цикла по 32 зонам)
        слиа    32(М2)          , сдвинуть М2 на 32
нов1а   мод     ВТОР            , модификация по флагу ВТОР
        мода    (М12)           , адресация по смещению М12
        сч      ТЗНМД(М10)      , загрузить запись о зоне (текущая)
        мода    (М2)            , адресация по М2
        нтж     ТЗНМД+У(М4)     , сравнить с другой записью (со смещением)
        и       П7777           , выделить номер пакета
        пе      ВКЛ             , если пакеты не совпадают → ВКЛ (включить)
        сч      ч2              , проверить занятость буфера
        и       листм           , выделить биты листа
        пе      1(М6)           , если буфер занят → 1(М6)
        уии     М1(М16)         , сохранить напр.
        сч      E1              , загрузить код 1 (запрос буфера)
        мода                    , сброс модификации
        пв      ТБУФ(М15)       , запросить буфер (ТБУФ)
        уиа     '3'             , разрешить прерывания
        сда     64-8            , выделить адрес буфера (старшие биты)
        уи      М6              , М6 := адрес буфера
        сда     64-2            , сдвинуть для формирования КУСа
        или     ч2              , добавить базовый КУС
        или     НОММБ1          , добавить номер МБ
        зп      ч2              , сохранить КУС в ч2
        пв      ФИЗОБМ(М16)     , выполнить физический обмен (загрузка зоны)
        уиа     '3'             , разрешить прерывания
        пб      (М6)            , перейти по адресу буфера (запуск)

нв2а    мода    (М12)           , второй проход: адресация по М12
        сч      ТЗНМД(М10)      , загрузить запись о зоне
        уи      М13             , сохранить в М13
        пб      нв20            , перейти к поиску

ВКЛ     цикл    нов1а(М4)       , цикл по 32 зонам
        цикл    нв(М11)         , цикл по количеству попыток
        сч      ПР+1-А(М16)     , загрузить шкалу прежних пакетов
        и       E48(М10)        , проверить бит устройства
        пе      нов10           , если уже есть → нов10
        пино    прсмд(М13)      , если М13 ≠ 0 → прсмд
        мод     ВТОР            , модификация по флагу ВТОР
        мода    (М12)           , адресация по М12
        сч      ТЗНМД(М10)      , загрузить запись о зоне
        или     E47             , установить бит 47 (новый пакет)
        нтж     E47             , сбросить его (??)
        или     E15             , добавить бит 15
        мода    (М12)
        зп      ТЗНМД(М10)      , обновить запись

нов10   сч      нм-3(М3)        , загрузить номер машины (нм)
        по      НОВ1            , если 0 → НОВ1
        сч      E37             , проверить бит 37
        или     E39             , добавить бит 39
        мод     ВТОР            , модификация
        мода    (М12)           , адресация
        и       ТЗНМД(М10)      , выделить признаки
        нтж     E37             , сбросить бит 37
        по      НОВ1            , если 0 → НОВ1
        сч      ОСУ-1(М3)       , загрузить шкалу ожидания освобождения
        и       E32(М10)        , проверить бит устройства
        пе      НОВ1            , если есть → НОВ1
        сч      КОПЗ-3(М3)      , загрузить шкалу запретов
        или     E32(М10)        , установить бит запрета
        зп      КОПЗ-3(М3)      , обновить
        пб      НОВ1            , перейти к НОВ1

ПЕРЕСТ  мода    (М2)            , адресация по М2
        мода    31(М4)          , адресация по М4+31
        сч      нтзнмд          , загрузить таблицу новых дисков
        мода    (М12)           , адресация по М12
        нтж     ТЗНМД(М10)      , сравнить с записью о зоне
        и       П7777           , выделить номер пакета
        пе      прсмд           , если не совпадает → прсмд
        пб      11(М6)          , иначе переход по 11(М6)

прсмд   счи     М10             , загрузить номер устройства
        нтж     П7              , инвертировать младшие биты
        уи      М2              , М2 := индекс
        сч      РМД1+1(М3)      , загрузить маску готовности напр.+1
        или     E32(М2)         , установить бит устройства
        зп      РМД1+1(М3)      , обновить

НОВ1    сч      Е44Е43(М16)     , загрузить маску изменений
        нтж     E48(М10)        , сбросить бит устройства
        зп      Е44Е43(М16)     , обновить
        пб      НВ2             , повторить цикл

нв3     слиа    32(М12)         , сдвинуть смещение на 32
        сч      ШКЗАКС(М16)     , загрузить шкалу заказов
        зп      Е44Е43(М16)     , сохранить как маску изменений
        сч                      , очистить
        зп      ПР+1-А(М16)     , сбросить шкалу прежних пакетов
        мода    нв1             , цикл по напр.
        цикл    (М3)

        уиа     -9(М3)          , М3 = -9 (счётчик для очистки)
        сч      ВТОР            , проверить флаг второго прохода
        пе      кпд             , если был → кпд (очистка)
        слиа    -97(М16)        , иначе: вычислить адрес
        счи     М16
        зп      ВТОР            , установить флаг второго прохода
        пб      НОВК            , перейти к НОВК

кпд     уиа     -63(М16)        , М16 = -63 (счётчик для очистки)
        сч                      , очистить СМ
кп1     мода    9(М3)           , адресация по М3
        зп      С16             , очистить С16 и соседние
        мода    кп1
        цикл    (М3)            , цикл по М3
кп2     мода    63(М16)         , адресация по М16
        зп      нтзнмд          , очистить таблицу новых дисков
        мода    кп2
        цикл    (М16)           , цикл по М16
        сч      ч2              , загрузить КУС буфера
        и       листм           , выделить биты листа
        по      от2             , если 0 → от2
        пв      ТБУФ(М15)       , иначе вернуть буфер (ТБУФ)
        сч      ч2              , загрузить КУС
        или     листм           , установить бит листа
        нтж     листм           , сбросить его (снять признак)
        зп      ч2              , обновить КУС
от2     уиа     Д3(М15)         , адрес возврата = Д3
        пб      б77             , переход к б77 (освобождение и возврат)
***************************************************
* ЭТОТ – ПОИСК И СОПОСТАВЛЕНИЕ ЗАПИСЕЙ В ТАБЛИЦЕ
* НОВЫХ ДИСКОВ (нтзнмд). ИСПОЛЬЗУЕТСЯ ПРИ ВКЛЮЧЕНИИ
* ДИСКА ИЛИ ОБНАРУЖЕНИИ СМЕНЫ ПАКЕТА.
* ВХОД: М6 – БАЗА ВЫЗЫВАЮЩЕГО МОДУЛЯ (ДИСКИ),
*       М2 – НОМЕР УСТРОЙСТВА (0–31?),
*       М4 – НОМЕР УСТРОЙСТВА ВНУТРИ ЛИНИИ,
*       М11 – БАЗА ТАБЛИЦЫ (ВЫЧИСЛЕНА ВЫЗЫВАЮЩИМ).
* ВЫХОД: ЕСЛИ НАЙДЕНА ПАРА – ПЕРЕХОД ПО 1(М6),
*       ИНАЧЕ – ВОЗВРАТ ЧЕРЕЗ ВСМЕ/СМЕ.
***************************************************
ЭТОТ    счи     М2              , ЗАГРУЗИТЬ НОМЕР УСТРОЙСТВА (М2)
        слц     П3              , ПРИБАВИТЬ 3 (КОРРЕКЦИЯ СМЕЩЕНИЯ)
        сда     64-2            , СДВИГ ВЛЕВО НА 2 (ФОРМИРОВАНИЕ ИНДЕКСА)
        зп      Р               , СОХРАНИТЬ В Р
        счи     М4              , ЗАГРУЗИТЬ НОМЕР УСТР. ВНУТРИ ЛИНИИ
        слц     П3              , ПРИБАВИТЬ 3
        или     Р               , ОБЪЕДИНИТЬ С ПРЕДЫДУЩИМ
        зп      Р               , СОХРАНИТЬ В Р (ИНДЕКС ЗАПИСИ)
        уиа     -15(М13)        , М13 := -15 (СЧЁТЧИК ПО 16 ЗАПИСЯМ)
этт     уиа     4(М10)          , М10 := 4 (ЧИСЛО ПОЛЕЙ В ЗАПИСИ)
этд     мода    (М11)           , АДРЕСАЦИЯ ПО БАЗЕ ТАБЛИЦЫ (М11)
        сч      56(М13)         , ЗАГРУЗИТЬ СЛОВО ИЗ ТАБЛИЦЫ (СМЕЩ. 56+М13)
        сда     64+8(М10)       , СДВИГ ВПРАВО НА 8*М10 (ВЫБОР ПОЛЯ)
        нтж     Р               , СРАВНИТЬ С ОЖИДАЕМЫМ ИНДЕКСОМ (Р)
        и       П17             , ОСТАВИТЬ 5 БИТ (НОМЕР УСТРОЙСТВА)
        по      этди            , ЕСЛИ СОВПАЛО → этди (НАЙДЕНА ЗАПИСЬ)
        мода    этд1            , ПОДГОТОВИТЬ ВОЗВРАТ ДЛЯ СЛЕДУЮЩЕГО ПОЛЯ
        пио     (М10)           , ЕСЛИ М10=0 → этд1 (ВСЕ ПОЛЯ ПРОСМОТРЕНЫ)
        уиа     0(М10)          , ИНАЧЕ СБРОСИТЬ М10
        пб      этд             , ПРОДОЛЖИТЬ ПОИСК В ТОЙ ЖЕ ЗАПИСИ
этд1    мода    этт             , ПЕРЕЙТИ К СЛЕДУЮЩЕЙ ЗАПИСИ

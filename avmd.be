***************************************************
* освуст – ОСВОБОЖДЕНИЕ УСТРОЙСТВА ПОСЛЕ ЗАХВАТА.
* ВХОД: М16 – НАПР., М3 – НОМЕР ЛИНИИ (ПОСЛЕ СБРОСА
*       МЛАДШИХ 2 БИТ), М17 – НОМЕР ЛИНИИ (0-3).
* ВЫХОД: ИЗ ШКАЛЫ РАЗЛ СНЯТЫ БИТЫ ДАННОЙ ЛИНИИ.
***************************************************
освуст  и       П3              , выделить младшие 2 бита (номер линии)
        уи      М17             , сохранить в М17
освус   сч      РАЗЛ(М16)       , загрузить шкалу различий напр.
        и       ЗУС-3(М16)      , учесть только захваченные устройства
        и       Е32П25(М17)     , выделить биты данной линии (М17)
        нтж     РАЗЛ(М16)       , сбросить эти биты в шкале различий
        и       Е32П25(М17)     , повторно выделить (для очистки)
        зп      РЯД1            , сохранить снятые биты в РЯД1
        зп      РЯД2            , и в РЯД2 (для последующего цикла)
        или     РАЗЛ(М16)       , добавить к исходной шкале
        нтж     РЯД1            , сбросить уже обработанные биты
        зп      РАЗЛ(М16)       , обновить шкалу различий
св      сч      РЯД2            , проверить, остались ли ещё биты
        по      св1             , если нет – перейти к св1
        нед     Е15П1           , найти старший бит (номер устр.)
        уи      М5              , М5 := номер устройства (общий)
        слиа    -16(М5)         , скорректировать (убрать смещение напр.)
        счи     М16             , загрузить номер напр.
        и       E3              , выделить младший бит (чётность)
        сда     64-3            , сдвинуть влево на 3
        уи      М11             , М11 := индекс напр. (0 или 8)
        сли     М11(М5)         , М11 := индекс устройства (напр.+устр.)
        сч      ШОЧМД(М11)      , загрузить очередь заказов к устройству
        или     ШОЧНМД-3(М16)   , добавить к очереди напр.
        зп      ШОЧНМД-3(М16)   , обновить (разбудить ожидающих)
        сч      ШОЧМД(М11)      , загрузить очередь устройства ещё раз
        или     ШОЧЛ(М3)        , добавить к очереди линии (М3 – линия)
        зп      ШОЧЛ(М3)        , обновить очередь линии
        сч      РЯД2            , сбросить обработанный бит
        нтж     E32(М5)         , инвертировать бит устройства
        зп      РЯД2            , сохранить оставшиеся
        пб      св              , повторить цикл по оставшимся
св1     сч      п3700(М16)      , проверить, 29-МБ диск?
        по      вку             , если обычный – перейти к вку
        сч      прр-2(М16)      , для 29-МБ: загрузить шкалу прерываний
        или     РЯД1            , добавить снятые биты (для повторной
        нтж     РЯД1            , установки?) и сбросить их
        зп      прр-2(М16)      , обновить шкалу прерываний напр.
        уиа     49(М11)         , М11 := 49 (параметр для чтения РС)
        пв      зсс(М5)         , чтение регистра состояния
        сч      РЯД1            , загрузить снятые биты
        сбр     Е32П25(М17)     , сбросить биты линии
        сда     64+36           , сдвинуть вправо (для формирования кода)
        и       РЯД2            , выделить оставшиеся биты
        нтж     РЯД2 ОСВОБ. УСТР. , сбросить их (освободить устройства)
        зп      РЯД2            , сохранить
        уиа     47(М11)         , М11 := 47 (запись РС)
        пв      чр2(М5)         , записать обновлённое состояние
        уиа     осс(М14)        , адрес возврата = осс
        пб      зр5             , перейти к завершению
***************************************************
* ав1 – ПЕРВИЧНЫЙ АНАЛИЗ АВАРИЙНОЙ СИТУАЦИИ МД.
* ВХОД: М16 – НАПР., М15 – ИНВЕРС. N УСТР., М4 – N УСТР.,
*       рс – РЕГИСТР СОСТОЯНИЯ (ПРОЧИТАН).
